diff --git a/src/mm3_launcher_main.cpp b/src/mm3_launcher_main.cpp
new file mode 100644
index 0000000..5db5236
--- /dev/null
+++ b/src/mm3_launcher_main.cpp
@@ -0,0 +1,117 @@
+/* The arm64 Linux launcher (mm3-launcher): the settings launcher of the game,
+ * with a first-run setup that builds the game on this device from the
+ * player's own disc (src/mm3_setup.cpp). Play starts the built game through
+ * the start script the setup writes, which is also what Steam and the desktop
+ * menu run.
+ *
+ * It is built without the game (MM3_LAUNCHER_ONLY): the launcher's controller
+ * reads, which the game answers through the runtime's SDL3 pad, are answered
+ * here with SDL3 directly, and the mods' hooks into the game are never
+ * called from the launcher, so they are stubs. */
+#include <SDL3/SDL.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <unistd.h>
+#include "mm3_setup.h"
+extern "C" {
+#include "nv2a_d3d11.h"   /* NvOverlayHooks */
+}
+
+extern "C" int mm3_launcher(void);
+
+namespace {
+
+SDL_Gamepad *g_pad;
+
+/* XInput's button bits, the layout the launcher reads. */
+const struct { SDL_GamepadButton button; uint16_t bit; } kButtons[] = {
+    {SDL_GAMEPAD_BUTTON_DPAD_UP, 0x0001},    {SDL_GAMEPAD_BUTTON_DPAD_DOWN, 0x0002},
+    {SDL_GAMEPAD_BUTTON_DPAD_LEFT, 0x0004},  {SDL_GAMEPAD_BUTTON_DPAD_RIGHT, 0x0008},
+    {SDL_GAMEPAD_BUTTON_START, 0x0010},      {SDL_GAMEPAD_BUTTON_BACK, 0x0020},
+    {SDL_GAMEPAD_BUTTON_LEFT_STICK, 0x0040}, {SDL_GAMEPAD_BUTTON_RIGHT_STICK, 0x0080},
+    {SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, 0x0100}, {SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, 0x0200},
+    {SDL_GAMEPAD_BUTTON_SOUTH, 0x1000},      {SDL_GAMEPAD_BUTTON_EAST, 0x2000},
+    {SDL_GAMEPAD_BUTTON_WEST, 0x4000},       {SDL_GAMEPAD_BUTTON_NORTH, 0x8000},
+};
+
+int16_t flip(int16_t v)   /* SDL's Y axes point down, XInput's up */
+{
+    return v == INT16_MIN ? INT16_MAX : (int16_t)-v;
+}
+
+} // namespace
+
+extern "C" {
+
+uint32_t xbox_InputHostPad(uint32_t port, uint16_t *buttons, uint8_t *left_trigger, uint8_t *right_trigger,
+                           int16_t *lx, int16_t *ly, int16_t *rx, int16_t *ry)
+{
+    const uint32_t not_connected = 1167; /* ERROR_DEVICE_NOT_CONNECTED */
+    if (port != 0)
+        return not_connected;
+    if (!SDL_WasInit(SDL_INIT_GAMEPAD) && !SDL_InitSubSystem(SDL_INIT_GAMEPAD))
+        return not_connected;
+    SDL_UpdateGamepads();
+    if (g_pad && !SDL_GamepadConnected(g_pad)) {
+        SDL_CloseGamepad(g_pad);
+        g_pad = nullptr;
+    }
+    if (!g_pad) {
+        int count = 0;
+        SDL_JoystickID *ids = SDL_GetGamepads(&count);
+        if (ids && count > 0)
+            g_pad = SDL_OpenGamepad(ids[0]);
+        SDL_free(ids);
+        if (!g_pad)
+            return not_connected;
+    }
+    uint16_t b = 0;
+    for (const auto &k : kButtons)
+        if (SDL_GetGamepadButton(g_pad, k.button))
+            b |= k.bit;
+    *buttons = b;
+    *left_trigger = (uint8_t)(SDL_GetGamepadAxis(g_pad, SDL_GAMEPAD_AXIS_LEFT_TRIGGER) >> 7);
+    *right_trigger = (uint8_t)(SDL_GetGamepadAxis(g_pad, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) >> 7);
+    *lx = SDL_GetGamepadAxis(g_pad, SDL_GAMEPAD_AXIS_LEFTX);
+    *ly = flip(SDL_GetGamepadAxis(g_pad, SDL_GAMEPAD_AXIS_LEFTY));
+    *rx = SDL_GetGamepadAxis(g_pad, SDL_GAMEPAD_AXIS_RIGHTX);
+    *ry = flip(SDL_GetGamepadAxis(g_pad, SDL_GAMEPAD_AXIS_RIGHTY));
+    return 0;
+}
+
+/* What the game's runtime gives the shared window code (fb_window_sdl.c). */
+void xbox_FramebufferSdlHints(void)
+{
+    SDL_SetHintWithPriority(SDL_HINT_VIDEO_DRIVER, "wayland,x11", SDL_HINT_DEFAULT);
+}
+int xbox_FramebufferStartHidden(void) { return 0; }
+
+/* The mods' hooks into the running game (src/mods/mods.c). */
+extern const NvOverlayHooks mm3_hud_hooks = {};
+void mm3_render_commands_init(void) {}
+void mm3_dvd_media_init(void) {}
+void xbox_InputSetMenuProbe(int (*)(void)) {}
+void nv2a_d3d_set_bspline_blend(uint32_t, uint32_t) {}
+void nv2a_d3d_set_overlay_hooks(const NvOverlayHooks *) {}
+void nv2a_d3d_set_flare_depth_test(uint32_t) {}
+void mm3_menu_mouse_init(void) {}
+void mm3_dev_tools_tick(void) {}
+void mm3_debug_teleport_init(void) {}
+void mm3_debug_overlay_init(void) {}
+int mm3_keyboard_driving(void) { return 0; }
+void mm3_keyboard_driving_init(int (*)(void)) {}
+
+} // extern "C"
+
+int main(void)
+{
+    mm3_setup::init();
+    const int play = mm3_launcher();
+    mm3_setup::shutdown();
+    if (play != 1)
+        return 0;
+    const char *script = mm3_setup::start_script();
+    execl(script, script, (char *)nullptr);
+    perror(script);
+    return 1;
+}
diff --git a/src/mm3_setup.cpp b/src/mm3_setup.cpp
new file mode 100644
index 0000000..56905d7
--- /dev/null
+++ b/src/mm3_setup.cpp
@@ -0,0 +1,817 @@
+/* The Linux launcher's first-run setup (src/mm3_setup.h). setup/mm3_setup.py,
+ * beside the launcher, does the work in a child process and reports one
+ * event per line on its standard output; this file shows that over the
+ * launcher and takes the player's choices. */
+#include "mm3_setup.h"
+
+#include <RmlUi/Core.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+/* The controller's buttons as the launcher passes them (XInput bits). */
+#define XINPUT_GAMEPAD_DPAD_UP 0x0001
+#define XINPUT_GAMEPAD_DPAD_DOWN 0x0002
+#define XINPUT_GAMEPAD_START 0x0010
+#define XINPUT_GAMEPAD_A 0x1000
+#define XINPUT_GAMEPAD_B 0x2000
+#define XINPUT_GAMEPAD_X 0x4000
+#define XINPUT_GAMEPAD_Y 0x8000
+
+namespace mm3_setup {
+namespace {
+
+struct Disc {
+    Rml::String name, folder, size, path;
+    double bytes;
+};
+
+/* A child process whose standard output is read line by line. */
+struct Child {
+    pid_t pid = -1;
+    int fd = -1;
+    Rml::String pending;
+    int status = 0;
+};
+
+Rml::String g_app;     /* the launcher's folder */
+Rml::String g_script;  /* setup/mm3_setup.py */
+Rml::String g_data;    /* ~/.local/share/MidtownMadness3 */
+Rml::String g_version; /* setup/VERSION */
+Rml::String g_start;   /* the data folder's start script */
+
+Rml::DataModelHandle g_model;
+Rml::Vector<Disc> g_discs;
+int g_disc = -1;
+int g_focus = -1;     /* controller and arrow-key focus in the setup, -1 none */
+bool g_owned;
+bool g_active;
+bool g_have_files;    /* the disc was copied before: a build needs no disc */
+bool g_scanning;
+int g_state;          /* 0 choosing, 1 building, 2 failed */
+Rml::String g_step, g_title, g_detail, g_error, g_hint, g_width = "0%";
+bool g_busy;          /* the bar sweeps: the step cannot tell how far it is */
+Rml::String g_note;   /* below the settings: Add to Steam and build results */
+bool g_steaming;
+Rml::String g_latest; /* a newer launcher release, empty when none */
+bool g_updating;
+bool g_updated;       /* the update said @done: restart once it exits */
+Rml::String g_iso;    /* what the current build reads */
+
+Child g_build, g_scan, g_steam, g_chooser, g_check, g_update;
+Rml::Vector<pid_t> g_openers; /* xdg-open, reaped as they finish */
+
+Rml::String home_short(const Rml::String &path)
+{
+    const char *home = getenv("HOME");
+    if (home && *home && path.compare(0, strlen(home), home) == 0)
+        return "~" + path.substr(strlen(home));
+    return path;
+}
+
+Rml::String gigabytes(double bytes)
+{
+    char text[32];
+    snprintf(text, sizeof text, "%.1f GB", bytes / (1024.0 * 1024 * 1024));
+    return text;
+}
+
+bool exists(const Rml::String &path) { return access(path.c_str(), F_OK) == 0; }
+
+Rml::String read_file(const Rml::String &path)
+{
+    Rml::String out;
+    if (FILE *f = fopen(path.c_str(), "r")) {
+        char buffer[4096];
+        size_t n;
+        while ((n = fread(buffer, 1, sizeof buffer, f)) > 0)
+            out.append(buffer, n);
+        fclose(f);
+    }
+    while (!out.empty() && (out.back() == '\n' || out.back() == '\r' || out.back() == ' '))
+        out.pop_back();
+    return out;
+}
+
+void mkdirs(const Rml::String &path)
+{
+    for (size_t at = 1; at <= path.size(); at++)
+        if (at == path.size() || path[at] == '/')
+            mkdir(path.substr(0, at).c_str(), 0755);
+}
+
+void dirty(const char *name)
+{
+    if (g_model)
+        g_model.DirtyVariable(name);
+}
+
+void dirty_all()
+{
+    for (const char *name : {"setup", "s_discs", "s_disc", "s_focus", "s_owned", "s_have_files", "s_scanning",
+                             "s_state", "s_step", "s_title", "s_detail", "s_error", "s_hint", "s_width", "s_busy",
+                             "s_note", "s_steaming", "s_can_go", "s_go_label"})
+        dirty(name);
+}
+
+bool spawn(Child &child, const Rml::Vector<Rml::String> &args)
+{
+    int pipe_fds[2];
+    if (pipe(pipe_fds) != 0)
+        return false;
+    const pid_t pid = fork();
+    if (pid < 0) {
+        close(pipe_fds[0]);
+        close(pipe_fds[1]);
+        return false;
+    }
+    if (pid == 0) {
+        /* Its own process group, so Cancel ends the tools it started too. */
+        setpgid(0, 0);
+        const int null = open("/dev/null", O_RDWR);
+        dup2(null, 0);
+        dup2(pipe_fds[1], 1);
+        dup2(null, 2);
+        close(pipe_fds[0]);
+        Rml::Vector<char *> argv;
+        for (const Rml::String &a : args)
+            argv.push_back(const_cast<char *>(a.c_str()));
+        argv.push_back(nullptr);
+        execvp(argv[0], argv.data());
+        _exit(127);
+    }
+    close(pipe_fds[1]);
+    fcntl(pipe_fds[0], F_SETFL, fcntl(pipe_fds[0], F_GETFL) | O_NONBLOCK);
+    fcntl(pipe_fds[0], F_SETFD, FD_CLOEXEC);
+    child.pid = pid;
+    child.fd = pipe_fds[0];
+    child.pending.clear();
+    return true;
+}
+
+/* Hands each complete line to on_line; false once the child has exited
+ * (its exit status in child.status). */
+template <typename F> bool poll(Child &child, F on_line)
+{
+    if (child.pid < 0)
+        return false;
+    char buffer[4096];
+    for (;;) {
+        const ssize_t n = read(child.fd, buffer, sizeof buffer);
+        if (n > 0) {
+            child.pending.append(buffer, (size_t)n);
+            size_t end;
+            while ((end = child.pending.find('\n')) != Rml::String::npos) {
+                on_line(child.pending.substr(0, end));
+                child.pending.erase(0, end + 1);
+            }
+            continue;
+        }
+        if (n < 0 && (errno == EAGAIN || errno == EINTR))
+            return true;
+        break; /* end of output */
+    }
+    if (!child.pending.empty())
+        on_line(child.pending);
+    close(child.fd);
+    waitpid(child.pid, &child.status, 0);
+    child.pid = -1;
+    child.fd = -1;
+    return false;
+}
+
+void stop(Child &child)
+{
+    if (child.pid < 0)
+        return;
+    kill(-child.pid, SIGTERM);
+    close(child.fd);
+    waitpid(child.pid, &child.status, 0);
+    child.pid = -1;
+    child.fd = -1;
+}
+
+Rml::Vector<Rml::String> fields(const Rml::String &line)
+{
+    Rml::Vector<Rml::String> out;
+    size_t start = 0;
+    for (;;) {
+        const size_t tab = line.find('\t', start);
+        out.push_back(line.substr(start, tab == Rml::String::npos ? Rml::String::npos : tab - start));
+        if (tab == Rml::String::npos)
+            return out;
+        start = tab + 1;
+    }
+}
+
+double free_bytes()
+{
+    Rml::String path = g_data;
+    while (!path.empty() && !exists(path))
+        path = path.substr(0, path.rfind('/'));
+    struct statvfs fs;
+    if (path.empty() || statvfs(path.c_str(), &fs) != 0)
+        return -1;
+    return (double)fs.f_bavail * (double)fs.f_frsize;
+}
+
+void update_hint()
+{
+    const double need = (g_disc >= 0 && !g_have_files ? g_discs[g_disc].bytes : 0) + 6.0 * (1 << 30);
+    const double free = free_bytes();
+    char text[512];
+    snprintf(text, sizeof text,
+             "Installs to %s. Needs about %.0f GB free%s%s%s; the build takes 20 to 40 minutes on a "
+             "handheld, so keep it on its charger.",
+             home_short(g_data).c_str(), need / (1 << 30), free >= 0 ? " (" : "",
+             free >= 0 ? gigabytes(free).c_str() : "", free >= 0 ? " free now)" : "");
+    g_hint = text;
+    dirty("s_hint");
+}
+
+bool built()
+{
+    const Rml::String installed = read_file(g_data + "/installed.json");
+    return !g_version.empty() && installed.find("\"version\": \"" + g_version + "\"") != Rml::String::npos &&
+           exists(g_data + "/bin/mm3_recomp");
+}
+
+void scan()
+{
+    if (g_scanning || g_script.empty())
+        return;
+    g_scanning = spawn(g_scan, {"python3", g_script, "scan"});
+    dirty("s_scanning");
+}
+
+void add_disc(const Rml::String &path, double bytes, bool select)
+{
+    for (size_t i = 0; i < g_discs.size(); i++)
+        if (g_discs[i].path == path) {
+            if (select)
+                g_disc = (int)i;
+            return;
+        }
+    Disc d;
+    d.path = path;
+    const size_t slash = path.rfind('/');
+    d.name = slash == Rml::String::npos ? path : path.substr(slash + 1);
+    d.folder = slash == Rml::String::npos ? "" : home_short(path.substr(0, slash));
+    if (d.folder == "~")
+        d.folder = "Home folder";
+    d.bytes = bytes;
+    d.size = gigabytes(bytes);
+    g_discs.push_back(d);
+    if (select || g_disc < 0)
+        g_disc = (int)g_discs.size() - 1;
+    dirty("s_discs");
+    dirty("s_disc");
+    update_hint();
+}
+
+void choose_file()
+{
+    if (g_chooser.pid >= 0)
+        return;
+    const char *home = getenv("HOME");
+    const Rml::String start = Rml::String(home ? home : "") + "/";
+    if (access("/usr/bin/zenity", X_OK) == 0)
+        spawn(g_chooser, {"zenity", "--file-selection", "--title=Choose your Midtown Madness 3 disc image",
+                          "--filename=" + start, "--file-filter=Xbox disc images | *.iso *.ISO *.xiso *.XISO",
+                          "--file-filter=All files | *"});
+    else
+        spawn(g_chooser, {"kdialog", "--getopenfilename", start, "*.iso *.ISO *.xiso *.XISO|Xbox disc images"});
+}
+
+void open_logs()
+{
+    const Rml::String log = g_data + "/logs/build.log";
+    Child opener;
+    if (spawn(opener, {"xdg-open", exists(log) ? log : g_data})) {
+        close(opener.fd);
+        g_openers.push_back(opener.pid);
+    }
+}
+
+bool can_go()
+{
+    if (g_state == 1 || g_updating || g_script.empty())
+        return false;
+    if (g_state == 2 || g_have_files)
+        return true;
+    return g_disc >= 0 && g_owned;
+}
+
+void start_build()
+{
+    if (!can_go())
+        return;
+    if (g_state == 0)
+        g_iso = g_have_files ? "" : g_discs[g_disc].path;
+    if (!spawn(g_build, {"python3", g_script, "build", g_iso})) {
+        g_state = 2;
+        g_error = "Could not start the build: Python 3 is missing.";
+        dirty_all();
+        return;
+    }
+    g_state = 1;
+    g_step = "Starting";
+    g_title = "";
+    g_detail = "";
+    g_error = "";
+    g_busy = true;
+    g_width = "40%";
+    g_focus = -1;
+    dirty_all();
+}
+
+void cancel_build()
+{
+    if (g_build.pid < 0)
+        return;
+    stop(g_build);
+    g_state = 0;
+    g_have_files = exists(g_data + "/game_files/.complete");
+    update_hint();
+    dirty_all();
+}
+
+void add_to_steam()
+{
+    if (g_steaming || g_active || g_script.empty())
+        return;
+    g_steaming = spawn(g_steam, {"python3", g_script, "steam"});
+    g_note = g_steaming ? "Adding to Steam..." : "Could not start Python 3.";
+    dirty("s_note");
+    dirty("s_steaming");
+}
+
+/* Replaces the launcher's files with the newest release, then starts it again. */
+void update_launcher()
+{
+    if (g_latest.empty() || g_updating || g_steaming || g_state == 1 || g_script.empty())
+        return;
+    g_updated = false;
+    g_updating = spawn(g_update, {"python3", g_script, "update"});
+    g_note = g_updating ? "Downloading launcher " + g_latest + "..." : "Could not start Python 3.";
+    dirty("s_note");
+    dirty("s_updating");
+}
+
+void rebuild()
+{
+    if (g_active || g_steaming || g_updating)
+        return;
+    g_active = true;
+    g_state = 0;
+    g_have_files = exists(g_data + "/game_files/.complete");
+    g_note = "";
+    if (!g_have_files)
+        scan();
+    update_hint();
+    dirty_all();
+}
+
+/* The rows the controller and the arrow keys move through. */
+int rows()
+{
+    return g_have_files ? 0 : (int)g_discs.size() + 2;
+}
+
+void activate(int row)
+{
+    const int n = (int)g_discs.size();
+    if (row < 0)
+        return;
+    if (row < n)
+        g_disc = row;
+    else if (row == n)
+        choose_file();
+    else if (row == n + 1)
+        g_owned = !g_owned;
+    update_hint();
+    dirty_all();
+}
+
+void move(int d)
+{
+    const int n = rows();
+    if (!n || g_state != 0)
+        return;
+    g_focus = g_focus < 0 ? 0 : Rml::Math::Clamp(g_focus + d, 0, n - 1);
+    dirty("s_focus");
+}
