Date: Mon, 9 Nov 2026 13:13:39 +0000
Subject: [PATCH 1/3] feat(linux): build and run the game on arm64 linux

The recompiled code and the runtime have portable paths for everything
x86-specific, so CMake accepts Linux on arm64 and builds there with
x86's signed char and without fused multiply-adds, which move the physics
off the x86 results. An installed SDL3 and SDL_shadercross are found at
the top so this directory sees their targets. The Windows-only thread
profiler in the teleport panel and the speedometer's guest-state
includes no longer stop a Linux build.
---
 CMakeLists.txt        | 26 +++++++++++++++++++++-----
 src/mm3_speedometer.c |  2 +-
 src/mods/teleport.c   |  9 +++++++++
 src/recomp_manual.c   |  4 ++++
 4 files changed, 35 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 74deb2e..1d8da98 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,11 +1,14 @@
 cmake_minimum_required(VERSION 3.20)
 project(mm3_recomp C CXX)
 
-# The recompiled game code uses x86 SIMD intrinsics for the guest's MMX/SSE,
-# and the runtime traps hardware registers by decoding x86-64 instructions,
-# so the host must be x86-64 (Windows, Linux or an Intel Mac).
-if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
-    message(FATAL_ERROR "MM3 needs an x86-64 host; this is ${CMAKE_SYSTEM_PROCESSOR}")
+# The recompiled game code uses x86 SIMD intrinsics for the guest's MMX/SSE
+# where the host has them and portable C elsewhere, and the runtime traps
+# hardware registers by decoding x86-64 or AArch64 instructions, so the host
+# is x86-64 (Windows, Linux or an Intel Mac) or Linux on arm64.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$" AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    set(MM3_ARM64_LINUX ON)
+elseif(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
+    message(FATAL_ERROR "MM3 needs an x86-64 host or Linux on arm64; this is ${CMAKE_SYSTEM_PROCESSOR}")
 endif()
 
 # Recompiled x86 code relies on what MSVC does anyway: signed arithmetic wraps
@@ -15,6 +18,12 @@ endif()
 if(NOT MSVC)
     add_compile_options(-fwrapv -fno-strict-aliasing)
 endif()
+# On arm64, char is unsigned and compilers fuse multiply-adds by default; the
+# code was written against x86's signed char and separate roundings, and the
+# physics drift off the x86 results with fused multiply-adds.
+if(MM3_ARM64_LINUX)
+    add_compile_options(-fsigned-char -ffp-contract=off)
+endif()
 
 set(CMAKE_C_STANDARD 11)
 set(CMAKE_C_STANDARD_REQUIRED ON)
@@ -43,6 +52,13 @@ endif()
 set(XBOXRECOMP_DSP_PROGRAM_DIR "${CMAKE_CURRENT_SOURCE_DIR}/game_files/dsp")
 # MM3 owns its depth-view compatibility shader; both host renderers use it.
 set(XBOXRECOMP_NV2A_SHADER_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src/mods/shaders/nv2a")
+# An installed SDL3 and SDL_shadercross (a prebuilt sysroot's, as the arm64
+# Linux build uses) are found here, so that their imported targets are seen
+# by this directory as well as by the runtime's.
+if(NOT WIN32)
+    find_package(SDL3 CONFIG QUIET)
+    find_package(SDL3_shadercross CONFIG QUIET)
+endif()
 add_subdirectory(${XBOXRECOMP_DIR} ${CMAKE_BINARY_DIR}/xboxrecomp)
 # MM3 VP-only playback was measured about 10 dB above GP output (-10.7 vs
 # -20.7 dBFS in a race). Keep its existing calibration outside the runtime.
