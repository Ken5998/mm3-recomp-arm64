+        snprintf(reply, size, "{\"result\":\"the profiler is Windows only\"}");
+#endif
     } else if (strcmp(command, "cars") == 0) {
         uint32_t primary = primary_player();
         size_t n = (size_t)snprintf(reply, size, "{\"cars\":[");
