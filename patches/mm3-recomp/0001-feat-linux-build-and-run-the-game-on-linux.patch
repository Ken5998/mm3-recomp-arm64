+struct XINPUT_STATE {
+    DWORD dwPacketNumber;
+    XINPUT_GAMEPAD Gamepad;
+};
+
+#include "sdl_keys.h" /* the game window's key table */
+
+SDL_Window *mm3_launcher_window(void);
+
+/* The launcher's window while it has the keyboard, as Windows' active
+ * window: input is only read then. */
+static inline HWND GetActiveWindow(void)
+{
+    SDL_Window *w = mm3_launcher_window();
+    return w && (SDL_GetWindowFlags(w) & SDL_WINDOW_INPUT_FOCUS) ? (HWND)w : NULL;
+}
+
+static inline int mm3_vk_down(int vk)
+{
+    const Uint32 mouse = SDL_GetMouseState(NULL, NULL);
+    switch (vk) {
+    case VK_LBUTTON: return (mouse & SDL_BUTTON_LMASK) != 0;
+    case VK_RBUTTON: return (mouse & SDL_BUTTON_RMASK) != 0;
+    case VK_MBUTTON: return (mouse & SDL_BUTTON_MMASK) != 0;
+    case VK_XBUTTON1: return (mouse & SDL_BUTTON_X1MASK) != 0;
+    case VK_XBUTTON2: return (mouse & SDL_BUTTON_X2MASK) != 0;
+    case VK_SHIFT: return mm3_vk_down(VK_LSHIFT) || mm3_vk_down(VK_RSHIFT);
+    case VK_CONTROL: return mm3_vk_down(VK_LCONTROL) || mm3_vk_down(VK_RCONTROL);
+    case VK_MENU: return mm3_vk_down(VK_LMENU) || mm3_vk_down(VK_RMENU);
+    }
+    int count = 0;
+    const Uint8 *keys = SDL_GetKeyboardState(&count);
+    for (int sc = 0; sc < count; sc++)
+        if (keys[sc] && xbox_SdlScancodeToVk(sc) == vk)
+            return 1;
+    return 0;
+}
+
+static inline short GetAsyncKeyState(int vk)
+{
+    return mm3_vk_down(vk) ? (short)0x8000 : 0;
+}
+
+/* The first scancode the game window maps to vk, 0 if none. */
+static inline int mm3_vk_scancode(int vk)
+{
+    for (int sc = 1; sc < SDL_NUM_SCANCODES; sc++)
+        if (xbox_SdlScancodeToVk(sc) == vk)
+            return sc;
+    return 0;
+}
+
+static inline int GetCursorPos(POINT *p)
+{
+    int x = 0, y = 0;
+    SDL_GetGlobalMouseState(&x, &y);
+    p->x = x;
+    p->y = y;
+    return 1;
+}
+
+/* Controllers by SDL's game controller mapping, numbered in the order SDL
+ * lists them, in XInput's layout (as tools/xboxrecomp/src/input/xinput_sdl.c
+ * gives the game). */
+static inline DWORD XInputGetState(DWORD slot, XINPUT_STATE *s)
+{
+    static SDL_GameController *pads[XUSER_MAX_COUNT];
+    if (!SDL_WasInit(SDL_INIT_GAMECONTROLLER) && SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER) != 0)
+        return ERROR_DEVICE_NOT_CONNECTED;
+    if (slot >= XUSER_MAX_COUNT)
+        return ERROR_DEVICE_NOT_CONNECTED;
+    SDL_GameControllerUpdate();
+    SDL_GameController *&pad = pads[slot];
+    if (pad && !SDL_GameControllerGetAttached(pad)) {
+        SDL_GameControllerClose(pad);
+        pad = NULL;
+    }
+    if (!pad) {
+        int index = -1;
+        for (int i = 0, seen = 0; i < SDL_NumJoysticks(); i++)
+            if (SDL_IsGameController(i) && seen++ == (int)slot)
+                index = i;
+        if (index < 0 || !(pad = SDL_GameControllerOpen(index)))
+            return ERROR_DEVICE_NOT_CONNECTED;
+    }
+    static const struct {
+        SDL_GameControllerButton button;
+        WORD bit;
+    } kButtons[] = {
+        {SDL_CONTROLLER_BUTTON_A, XINPUT_GAMEPAD_A},
+        {SDL_CONTROLLER_BUTTON_B, XINPUT_GAMEPAD_B},
+        {SDL_CONTROLLER_BUTTON_X, XINPUT_GAMEPAD_X},
+        {SDL_CONTROLLER_BUTTON_Y, XINPUT_GAMEPAD_Y},
+        {SDL_CONTROLLER_BUTTON_LEFTSHOULDER, XINPUT_GAMEPAD_LEFT_SHOULDER},
+        {SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, XINPUT_GAMEPAD_RIGHT_SHOULDER},
+        {SDL_CONTROLLER_BUTTON_START, XINPUT_GAMEPAD_START},
+        {SDL_CONTROLLER_BUTTON_BACK, XINPUT_GAMEPAD_BACK},
+        {SDL_CONTROLLER_BUTTON_LEFTSTICK, XINPUT_GAMEPAD_LEFT_THUMB},
+        {SDL_CONTROLLER_BUTTON_RIGHTSTICK, XINPUT_GAMEPAD_RIGHT_THUMB},
+        {SDL_CONTROLLER_BUTTON_DPAD_UP, XINPUT_GAMEPAD_DPAD_UP},
+        {SDL_CONTROLLER_BUTTON_DPAD_DOWN, XINPUT_GAMEPAD_DPAD_DOWN},
+        {SDL_CONTROLLER_BUTTON_DPAD_LEFT, XINPUT_GAMEPAD_DPAD_LEFT},
+        {SDL_CONTROLLER_BUTTON_DPAD_RIGHT, XINPUT_GAMEPAD_DPAD_RIGHT},
+    };
+    *s = XINPUT_STATE();
+    for (const auto &b : kButtons)
+        if (SDL_GameControllerGetButton(pad, b.button))
+            s->Gamepad.wButtons |= b.bit;
+    /* SDL's triggers run 0..32767, its Y axes point down. */
+    s->Gamepad.bLeftTrigger = (uint8_t)(SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_TRIGGERLEFT) >> 7);
+    s->Gamepad.bRightTrigger = (uint8_t)(SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_TRIGGERRIGHT) >> 7);
+    s->Gamepad.sThumbLX = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTX);
+    s->Gamepad.sThumbLY = (int16_t)~SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTY);
+    s->Gamepad.sThumbRX = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_RIGHTX);
+    s->Gamepad.sThumbRY = (int16_t)~SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_RIGHTY);
+    return ERROR_SUCCESS;
+}
+
+/* "" removes the variable, as on Windows. */
+static inline int _putenv_s(const char *name, const char *value)
+{
+    return *value ? setenv(name, value, 1) : unsetenv(name);
+}
+
+#endif
diff --git a/src/mm3_launcher_sdl.cpp b/src/mm3_launcher_sdl.cpp
new file mode 100644
index 0000000..343b45a
--- /dev/null
+++ b/src/mm3_launcher_sdl.cpp
@@ -0,0 +1,213 @@
+/* The launcher's RmlUi backend on Linux: SDL2 window and input, OpenGL 3.3
+ * renderer. RmlUi's own SDL_GL3 backend with two changes: no SDL_image (the
+ * launcher draws no images), and GL entry points come from SDL's loader, so
+ * a Wayland EGL context works as well as an X11 GLX one. */
+#include "RmlUi_Backend.h"
+#include "RmlUi_Platform_SDL.h"
+#include "RmlUi_Renderer_GL3.h"
+#include "RmlUi_Include_GL3.h"
+#include <RmlUi/Core/Context.h>
+#include <RmlUi/Core/Core.h>
+#include <RmlUi/Core/Log.h>
+
+namespace {
+
+struct BackendData {
+    explicit BackendData(SDL_Window *window) : system_interface(window) {}
+
+    SystemInterface_SDL system_interface;
+    RenderInterface_GL3 render_interface;
+    TextInputMethodEditor_SDL text_input_method_editor;
+
+    SDL_Window *window = nullptr;
+    SDL_GLContext glcontext = nullptr;
+
+    bool running = true;
+};
+
+Rml::UniquePtr<BackendData> data;
+
+void fail(SDL_Window *window, SDL_GLContext context, const char *what)
+{
+    Rml::Log::Message(Rml::Log::LT_ERROR, "%s: %s", what, SDL_GetError());
+    if (context)
+        SDL_GL_DeleteContext(context);
+    if (window)
+        SDL_DestroyWindow(window);
+    SDL_Quit();
+}
+
+} // namespace
+
+bool Backend::Initialize(const char *window_name, int width, int height, bool allow_resize)
+{
+    RMLUI_ASSERT(!data);
+
+    SDL_SetHint(SDL_HINT_IME_SHOW_UI, "1");
+    if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_EVENTS | SDL_INIT_TIMER) != 0)
+        return false;
+
+    /* Submit click events when focusing the window. */
+    SDL_SetHint(SDL_HINT_MOUSE_FOCUS_CLICKTHROUGH, "1");
+    /* RmlUi handles touch itself: no synthetic mouse events for it. */
+    SDL_SetHint(SDL_HINT_TOUCH_MOUSE_EVENTS, "0");
+
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_FLAGS, 0);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+
+    const Uint32 window_flags = SDL_WINDOW_OPENGL | (allow_resize ? SDL_WINDOW_RESIZABLE : 0);
+    SDL_Window *window = SDL_CreateWindow(window_name, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, width,
+                                          height, window_flags);
+    if (!window) {
+        fail(nullptr, nullptr, "SDL error on create window");
+        return false;
+    }
+    /* SDL2 starts text input with the window; a focused field turns it on. */
+    SDL_StopTextInput();
+
+    SDL_GLContext glcontext = SDL_GL_CreateContext(window);
+    if (!glcontext) {
+        fail(window, nullptr, "No OpenGL 3.3 context");
+        return false;
+    }
+    SDL_GL_MakeCurrent(window, glcontext);
+    SDL_GL_SetSwapInterval(1);
+
+    if (!gladLoadGL((GLADloadfunc)SDL_GL_GetProcAddress)) {
+        fail(window, glcontext, "Failed to load the OpenGL functions");
+        return false;
+    }
+
+    data = Rml::MakeUnique<BackendData>(window);
+    if (!data->render_interface) {
+        data.reset();
+        fail(window, glcontext, "Failed to initialize the OpenGL 3 render interface");
+        return false;
+    }
+
+    data->window = window;
+    data->glcontext = glcontext;
+
+    int pixels_w = width, pixels_h = height;
+    SDL_GL_GetDrawableSize(window, &pixels_w, &pixels_h);
+    data->render_interface.SetViewport(pixels_w, pixels_h);
+
+    Rml::SetTextInputHandler(&data->text_input_method_editor);
+    return true;
+}
+
+void Backend::Shutdown()
+{
+    RMLUI_ASSERT(data);
+
+    SDL_Window *window = data->window;
+    SDL_GLContext glcontext = data->glcontext;
+
+    data.reset();
+
+    SDL_GL_DeleteContext(glcontext);
+    SDL_DestroyWindow(window);
+    SDL_Quit();
+}
+
+Rml::SystemInterface *Backend::GetSystemInterface()
+{
+    RMLUI_ASSERT(data);
+    return &data->system_interface;
+}
+
+Rml::RenderInterface *Backend::GetRenderInterface()
+{
+    RMLUI_ASSERT(data);
+    return &data->render_interface;
+}
+
+bool Backend::ProcessEvents(Rml::Context *context, KeyDownCallback key_down_callback, bool power_save)
+{
+    RMLUI_ASSERT(data && context);
+
+    bool result = data->running;
+    data->running = true;
+
+    SDL_Event ev;
+    int has_event;
+    if (power_save)
+        has_event = SDL_WaitEventTimeout(&ev, static_cast<int>(Rml::Math::Min(context->GetNextUpdateDelay(), 10.0) * 1000));
+    else
+        has_event = SDL_PollEvent(&ev);
+
+    while (has_event) {
+        bool propagate_event = true;
+        switch (ev.type) {
+        case SDL_QUIT:
+            propagate_event = false;
+            result = false;
+            break;
+        case SDL_KEYDOWN: {
+            propagate_event = false;
+            const Rml::Input::KeyIdentifier key = RmlSDL::ConvertKey(ev.key.keysym.sym);
+            const int key_modifier = RmlSDL::GetKeyModifierState();
+            const float native_dp_ratio = 1.f;
+
+            /* Global shortcuts first, then the context, then the
+             * shortcuts that only apply when the context had no use for it. */
+            if (key_down_callback && !key_down_callback(context, key, key_modifier, native_dp_ratio, true))
+                break;
+            if (!RmlSDL::InputEventHandler(context, data->window, ev))
+                break;
+            if (key_down_callback && !key_down_callback(context, key, key_modifier, native_dp_ratio, false))
+                break;
+            break;
+        }
+        case SDL_TEXTEDITING:
+            propagate_event = false;
+            data->text_input_method_editor.HandleEdit(ev.edit);
+            break;
+        case SDL_WINDOWEVENT:
+            if (ev.window.event == SDL_WINDOWEVENT_SIZE_CHANGED) {
+                int pixels_w = ev.window.data1, pixels_h = ev.window.data2;
+                SDL_GL_GetDrawableSize(data->window, &pixels_w, &pixels_h);
+                data->render_interface.SetViewport(pixels_w, pixels_h);
+            }
+            break;
+        default:
+            break;
+        }
+
+        if (propagate_event)
+            RmlSDL::InputEventHandler(context, data->window, ev);
+
+        has_event = SDL_PollEvent(&ev);
+    }
+
+    return result;
+}
+
+void Backend::RequestExit()
+{
+    RMLUI_ASSERT(data);
+    data->running = false;
+}
+
+void Backend::BeginFrame()
+{
+    RMLUI_ASSERT(data);
+    data->render_interface.Clear();
+    data->render_interface.BeginFrame();
+}
+
+void Backend::PresentFrame()
+{
+    RMLUI_ASSERT(data);
+    data->render_interface.EndFrame();
+    SDL_GL_SwapWindow(data->window);
+}
+
+/* The window the launcher draws in, for the launcher's own polling. */
+SDL_Window *mm3_launcher_window(void)
+{
+    return data ? data->window : nullptr;
+}
