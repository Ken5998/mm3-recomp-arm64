@@ -0,0 +1,14 @@
+cmake_minimum_required(VERSION 3.20)
+project(apu_lock_posix_test C)
+# How the APU's frame thread lets the title's MMIO have its lock on a POSIX
+# host (qemu_mutex_let_waiters_in).
+if(WIN32)
+    message(FATAL_ERROR "This regression covers the POSIX lock")
+endif()
+set(CMAKE_C_STANDARD 11)
+add_subdirectory(../../src/platform platform)
+add_executable(apu_lock_posix_test test_main.c)
+target_include_directories(apu_lock_posix_test PRIVATE ../../src ../../src/apu)
+target_link_libraries(apu_lock_posix_test PRIVATE platform)
+enable_testing()
+add_test(NAME apu_lock_posix_test COMMAND apu_lock_posix_test)
diff --git a/tests/apu_lock_posix/test_main.c b/tests/apu_lock_posix/test_main.c
new file mode 100644
index 0000000..8930bd5
--- /dev/null
+++ b/tests/apu_lock_posix/test_main.c
@@ -0,0 +1,136 @@
+/*
+ * The APU lock on a POSIX host: how the frame thread, which holds d->lock
+ * for as long as it runs behind real time, lets the title's MMIO have it.
+ *
+ * It used to unlock, yield and lock, as on Windows. A pthread mutex only
+ * wakes its waiter on unlock, and the yield returned before the waiter ran,
+ * so the frame thread took the lock straight back and the waiter starved;
+ * on a core shared with a busy thread, the same yield instead gave that
+ * thread milliseconds with no waiter at all. qemu_mutex_let_waiters_in keeps
+ * the lock while nobody waits and otherwise waits until the waiters had it.
+ */
+#include "apu_shim.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <time.h>
+
+static int failures;
+
+static void check(int ok, const char *what)
+{
+    printf("  %-62s %s\n", what, ok ? "PASS" : "FAIL");
+    if (!ok) failures++;
+}
+
+static int64_t now_us(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+}
+
+static QemuMutex lock;
+static volatile int holding, done;
+static int64_t worst_wait, total_wait, handing_over;
+static int acquired;
+
+/* The frame thread: busy for 20 us at a time, the lock always held. */
+static void *holder(void *arg)
+{
+    (void)arg;
+    qemu_mutex_lock(&lock);
+    holding = 1;
+    while (!done) {
+        int64_t until = now_us() + 20;
+        while (now_us() < until) {}
+        until = now_us();
+        qemu_mutex_let_waiters_in(&lock);
+        handing_over += now_us() - until;
+    }
+    qemu_mutex_unlock(&lock);
+    return NULL;
+}
+
+/* The title: an MMIO access now and then. */
+static void *title(void *arg)
+{
+    (void)arg;
+    struct timespec gap = { 0, 200 * 1000 };
+    for (int i = 0; i < 200; i++) {
+        int64_t asked = now_us(), waited;
+        qemu_mutex_lock(&lock);
+        waited = now_us() - asked;
+        qemu_mutex_unlock(&lock);
+        acquired++;
+        total_wait += waited;
+        if (waited > worst_wait) worst_wait = waited;
+        nanosleep(&gap, NULL);
+    }
+    return NULL;
+}
+
+int main(void)
+{
+    pthread_t frame, mmio;
+    int64_t start, took;
+
+    qemu_mutex_init(&lock);
+
+    qemu_mutex_lock(&lock);
+    start = now_us();
+    for (int i = 0; i < 100000; i++) qemu_mutex_let_waiters_in(&lock);
+    took = now_us() - start;
+    printf("  100000 calls with nobody waiting: %lld us\n", (long long)took);
+    check(took < 100000, "with nobody waiting it keeps the lock and costs no yield");
+    check(lock.cs.RecursionCount == 1, "and the lock is still held once");
+
+    /* A waiter that was counted but is never scheduled. */
+    lock.waiting = 1;
+    start = now_us();
+    qemu_mutex_let_waiters_in(&lock);
+    took = now_us() - start;
+    printf("  a waiter that never comes: %lld us\n", (long long)took);
+    check(took >= 500 && took < 50000, "a waiter that never comes is waited for 500 us at most");
+    check(lock.cs.RecursionCount == 1, "after which the lock is held again");
+
+    qemu_mutex_lock(&lock);
+    start = now_us();
+    qemu_mutex_let_waiters_in(&lock);
+    took = now_us() - start;
+    check(took < 400 && lock.cs.RecursionCount == 2,
+          "held twice, it cannot be let go and is kept at once");
+    lock.waiting = 0;
+    qemu_mutex_unlock(&lock);
+    qemu_mutex_unlock(&lock);
+
+    pthread_create(&frame, NULL, holder, NULL);
+    while (!holding) {}
+    start = now_us();
+    pthread_create(&mmio, NULL, title, NULL);
+    while (acquired < 200 && now_us() - start < 10000000) {
+        struct timespec poll = { 0, 1000000 };
+        nanosleep(&poll, NULL);
+    }
+    done = 1;
+    pthread_join(frame, NULL);
+    if (acquired == 200) {
+        pthread_join(mmio, NULL);
+        printf("  200 accesses past a busy holder: average %lld us, worst %lld us;\n"
+               "  the holder spent %lld us an access letting them in\n",
+               (long long)(total_wait / acquired), (long long)worst_wait,
+               (long long)(handing_over / acquired));
+    } else {
+        printf("  only %d of 200 accesses got the lock in 10 s\n", acquired);
+    }
+    check(acquired == 200, "the title gets the lock from a thread that always holds it");
+    check(acquired == 200 && total_wait / acquired < 1000, "within 1 ms on average");
+    check(acquired == 200 && worst_wait < 20000, "and 20 ms at worst");
+
+    if (failures) {
+        printf("%d check(s) failed\n", failures);
+        return 1;
+    }
+    printf("All checks passed\n");
+    return 0;
+}
