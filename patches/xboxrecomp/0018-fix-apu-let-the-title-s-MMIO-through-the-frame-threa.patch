From bb432f182da8680deecd8bc045f0170bbf67438a Mon Sep 17 00:00:00 2001
From: Ken5998 <46025606+Ken5998@users.noreply.github.com>
Date: Thu, 15 Oct 2026 09:46:47 +0000
Subject: [PATCH 18/21] fix(apu): let the title's MMIO through the frame
 thread's lock on POSIX

The frame thread holds d->lock while it runs behind real time and drops it
between frames and DSP runs with an unlock, a yield and a lock. With a
pthread mutex that hands nothing over: the unlock only wakes the waiter and
the yield returns before it runs, so the lock was taken straight back and
the title's MMIO waited milliseconds; on a core shared with a busy thread,
the yield instead gave away milliseconds with nobody waiting.

QemuMutex now counts its waiters on POSIX, which spin for up to 50 us
before they sleep, and qemu_mutex_let_waiters_in keeps the lock while
nobody waits and otherwise waits, 500 us at most, until they had it. In
tests/apu_lock_posix a thread that holds the lock all the time lets another
in within 15 us on average (2.7 ms before, 27 ms at worst), at 1-3 us to
the holder. Windows keeps its yields.
---
 src/apu/apu_core.c                  |   4 +
 src/apu/apu_dsp.c                   |   4 +
 src/nv2a/qemu_shim.h                |  68 ++++++++++++++
 tests/apu_lock_posix/CMakeLists.txt |  14 +++
 tests/apu_lock_posix/test_main.c    | 136 ++++++++++++++++++++++++++++
 5 files changed, 226 insertions(+)
 create mode 100644 tests/apu_lock_posix/CMakeLists.txt
 create mode 100644 tests/apu_lock_posix/test_main.c

diff --git a/src/apu/apu_core.c b/src/apu/apu_core.c
index 6963370..793fadb 100644
--- a/src/apu/apu_core.c
+++ b/src/apu/apu_core.c
@@ -723,9 +723,13 @@ static void *mcpx_apu_frame_thread(void *arg)
          * thread starved there indefinitely: Burnout 3 froze on its vehicle
          * select, blocked in voice_lock at raised IRQL, which in turn held
          * off every USB interrupt. */
+#ifdef _WIN32
         qemu_mutex_unlock(&d->lock);
         SwitchToThread();
         qemu_mutex_lock(&d->lock);
+#else
+        qemu_mutex_let_waiters_in(&d->lock);
+#endif
     }
 
     qemu_mutex_unlock(&d->lock);
diff --git a/src/apu/apu_dsp.c b/src/apu/apu_dsp.c
index 5904c5b..1dffc5e 100644
--- a/src/apu/apu_dsp.c
+++ b/src/apu/apu_dsp.c
@@ -337,9 +337,13 @@ static void run_dsp_frame(MCPXAPUState *d, DSPState *dsp)
         }
         if (!dsp_has_work(dsp) || qatomic_read(&d->exiting)) break;
         /* Guest MMIO must be able to reset or command a continuously running DSP. */
+#ifdef _WIN32
         qemu_mutex_unlock(&d->lock);
         Sleep(0);
         qemu_mutex_lock(&d->lock);
+#else
+        qemu_mutex_let_waiters_in(&d->lock);
+#endif
         s_dsp_use[index].between_us += qemu_clock_get_us(QEMU_CLOCK_REALTIME) - ran;
         uint32_t reset = dsp->is_gp ? d->gp.regs[NV_PAPU_GPRST] : d->ep.regs[NV_PAPU_EPRST];
         uint32_t enabled = NV_PAPU_GPRST_GPRST | NV_PAPU_GPRST_GPDSPRST;
diff --git a/src/nv2a/qemu_shim.h b/src/nv2a/qemu_shim.h
index 2a6c746..ed4649d 100644
--- a/src/nv2a/qemu_shim.h
+++ b/src/nv2a/qemu_shim.h
@@ -17,6 +17,9 @@
 #include <stdlib.h>
 #include <stdio.h>
 #include <assert.h>
+#ifndef _WIN32
+#include <time.h>
+#endif
 
 /* The QEMU shim uses Win32-style threading primitives. On Windows this comes
  * from <windows.h>; on POSIX it comes from win32_compat (via xbox_winnt.h). */
@@ -104,6 +107,9 @@ static inline uint64_t muldiv64(uint64_t a, uint32_t b, uint32_t c) {
 
 typedef struct QemuMutex {
     CRITICAL_SECTION cs;
+#ifndef _WIN32
+    int waiting; /* threads blocked in qemu_mutex_lock */
+#endif
 } QemuMutex;
 
 typedef struct QemuCond {
@@ -116,17 +122,79 @@ typedef struct QemuThread {
 
 static inline void qemu_mutex_init(QemuMutex *m) {
     InitializeCriticalSection(&m->cs);
+#ifndef _WIN32
+    m->waiting = 0;
+#endif
 }
 static inline void qemu_mutex_destroy(QemuMutex *m) {
     DeleteCriticalSection(&m->cs);
 }
+#ifndef _WIN32
+static inline void qemu_cpu_relax(void) {
+#if defined(__aarch64__)
+    __asm__ __volatile__("yield");
+#elif defined(__x86_64__) || defined(__i386__)
+    __builtin_ia32_pause();
+#endif
+}
+static inline int64_t qemu_monotonic_ns(void) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1000000000LL + t.tv_nsec;
+}
+#endif
+
 static inline void qemu_mutex_lock(QemuMutex *m) {
+#ifndef _WIN32
+    /* Counted for qemu_mutex_let_waiters_in. A waiter spins for up to 50 us
+     * before it sleeps: the frame thread lets it in between DSP runs a few
+     * microseconds apart, and waking a sleeping one costs tens of them. */
+    int64_t start;
+    if (TryEnterCriticalSection(&m->cs)) return;
+    __atomic_add_fetch(&m->waiting, 1, __ATOMIC_ACQ_REL);
+    start = qemu_monotonic_ns();
+    for (unsigned spins = 1; ; spins++) {
+        qemu_cpu_relax();
+        if (TryEnterCriticalSection(&m->cs)) break;
+        if (spins % 64 == 0 && qemu_monotonic_ns() - start > 50000) {
+            EnterCriticalSection(&m->cs);
+            break;
+        }
+    }
+    __atomic_sub_fetch(&m->waiting, 1, __ATOMIC_ACQ_REL);
+#else
     EnterCriticalSection(&m->cs);
+#endif
 }
 static inline void qemu_mutex_unlock(QemuMutex *m) {
     LeaveCriticalSection(&m->cs);
 }
 
+#ifndef _WIN32
+/* Lets the threads waiting for a lock the caller holds have it, then takes
+ * it back: what the APU's frame thread does between frames and DSP runs, so
+ * the title's MMIO is not starved behind a thread that is never done.
+ *
+ * Windows callers unlock, yield and lock. That does nothing useful with a
+ * pthread mutex: unlocking only wakes a waiter, a yield on a core of its own
+ * returns long before it runs, and the lock was taken straight back -- while
+ * on a core shared with a busy thread, sched_yield gives that thread whole
+ * milliseconds, waiter or not. So with no waiter this keeps the lock, and
+ * with one it waits (spinning, at most 500 us) until the waiters got it. */
+static inline void qemu_mutex_let_waiters_in(QemuMutex *m) {
+    int64_t start;
+    if (!__atomic_load_n(&m->waiting, __ATOMIC_ACQUIRE) ||
+        m->cs.RecursionCount > 1)
+        return;
+    start = qemu_monotonic_ns();
+    LeaveCriticalSection(&m->cs);
+    while (__atomic_load_n(&m->waiting, __ATOMIC_ACQUIRE) &&
+           qemu_monotonic_ns() - start < 500000)
+        qemu_cpu_relax();
+    qemu_mutex_lock(m);
+}
+#endif
+
 static inline void qemu_cond_init(QemuCond *c) {
     InitializeConditionVariable(&c->cv);
 }
