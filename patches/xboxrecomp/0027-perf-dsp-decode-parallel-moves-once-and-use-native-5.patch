From fb9d038868fadf3276d95fa893e3775a02dad171 Mon Sep 17 00:00:00 2001
From: Ken5998 <46025606+Ken5998@users.noreply.github.com>
Date: Sun, 25 Oct 2026 16:21:12 +0000
Subject: [PATCH 27/30] perf(dsp): decode parallel moves once and use native
 56-bit arithmetic

The GP spends most of a frame in the interpreter. Parallel instructions now go through the per-address decode cache too: a bare ALU operation calls its handler directly and a plain X/Y move through (Rn), (Rn)+ or (Rn)- skips the general move decode. Add, subtract and multiply work on one 64-bit value instead of 24-bit pieces and partial products, the common flag update and full-width add/subtract are inlined, and the per-instruction loop checks fewer flags. A captured GP frame replays byte for byte with about 30% less time.
---
 src/apu/dsp/interp/dsp_cpu.c     | 237 +++++++++++++++----------------
 src/apu/dsp/interp/dsp_emu.c.inc |  36 ++++-
 2 files changed, 152 insertions(+), 121 deletions(-)

diff --git a/src/apu/dsp/interp/dsp_cpu.c b/src/apu/dsp/interp/dsp_cpu.c
index 5f209ce..4ce7f3a 100644
--- a/src/apu/dsp/interp/dsp_cpu.c
+++ b/src/apu/dsp/interp/dsp_cpu.c
@@ -453,6 +453,77 @@ static const OpcodeEntry nonparallel_opcodes[] = {
 static bool matches_initialised;
 static uint32_t nonparallel_matches[ARRAY_SIZE(nonparallel_opcodes)][2];
 
+/* Parallel instructions are decoded once per P address too. A bare ALU
+ * operation calls its handler straight away, and a move between an X or Y
+ * address in Rn and a register, without ALU work, skips the general parallel
+ * move decode; everything else takes the parallel move dispatch. */
+static void emu_parallel_move(dsp_core_t* dsp)
+{
+    opcodes_parmove[(dsp->cur_inst>>20) & BITMASK(4)](dsp);
+}
+
+static DSP_HOT void emu_pm_move_rn(dsp_core_t* dsp, int32_t modifier)
+{
+    uint32_t inst = dsp->cur_inst;
+    uint32_t numreg = ((inst>>16) & BITMASK(3)) | ((inst>>17) & (BITMASK(2)<<3));
+    uint32_t memspace = (inst>>19) & 1;
+    uint32_t rn = (inst>>8) & BITMASK(3);
+    uint32_t xy_addr = dsp->registers[DSP_REG_R0+rn], value;
+
+    /* The same order as emu_pm_5: Rn first, then the register side. */
+    if (modifier) emu_update_rn(dsp, rn, modifier);
+    if (inst & (1<<15)) {
+        value = read_memory(dsp, memspace, xy_addr);
+        dsp_write_reg(dsp, numreg, value);
+    } else {
+        if (numreg == DSP_REG_A || numreg == DSP_REG_B)
+            emu_pm_read_accu24(dsp, numreg, &value);
+        else
+            value = dsp_move_source(dsp, numreg);
+        write_memory(dsp, memspace, xy_addr, value);
+    }
+}
+
+static void emu_pm_move_rn_dec(dsp_core_t* dsp) { emu_pm_move_rn(dsp, -1); }
+static void emu_pm_move_rn_inc(dsp_core_t* dsp) { emu_pm_move_rn(dsp, +1); }
+static void emu_pm_move_rn_keep(dsp_core_t* dsp) { emu_pm_move_rn(dsp, 0); }
+
+static OpcodeEntry parallel_alu_only[256];
+static OpcodeEntry parallel_move_rn[3] = {
+    { .name = "move (Rn)-", .emu_func = emu_pm_move_rn_dec },
+    { .name = "move (Rn)+", .emu_func = emu_pm_move_rn_inc },
+    { .name = "move (Rn)", .emu_func = emu_pm_move_rn_keep },
+};
+static const OpcodeEntry parallel_other = { .name = "parallel", .emu_func = emu_parallel_move };
+
+static const OpcodeEntry *lookup_parallel(uint32_t op)
+{
+    uint32_t mode = (op>>11) & BITMASK(3);
+    if ((op & 0xffff00) == 0x200000)
+        return &parallel_alu_only[op & BITMASK(8)];
+    /* 01dd Sddd w1mm mrrr with no ALU part; 0100 l0ll is the L: move. */
+    if ((op & 0xc040ff) == 0x404000 && (op & 0xf40000) != 0x400000 &&
+        mode >= 2 && mode <= 4)
+        return &parallel_move_rn[mode - 2];
+    return &parallel_other;
+}
+
+static void emu_undefined_opcode(dsp_core_t* dsp)
+{
+    DPRINTF("%x - undefined\n", dsp->cur_inst);
+    emu_undefined(dsp);
+}
+
+static const OpcodeEntry undefined_opcode = { .name = "undefined", .emu_func = emu_undefined_opcode };
+static const OpcodeEntry *lookup_opcode(uint32_t op);
+
+/* What the decode cache holds for an instruction word: always a handler. */
+static const OpcodeEntry *lookup_instruction(uint32_t op)
+{
+    const OpcodeEntry *entry = op < 0x100000 ? lookup_opcode(op) : lookup_parallel(op);
+    return entry->emu_func ? entry : &undefined_opcode;
+}
+
