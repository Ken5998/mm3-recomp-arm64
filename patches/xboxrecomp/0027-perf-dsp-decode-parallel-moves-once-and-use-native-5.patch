-        signe ^= 1;
-        source1 = (1<<24) - source1;
-    }
-    if (source2 & (1<<23)) {
-        signe ^= 1;
-        source2 = (1<<24) - source2;
-    }
-
-    /* bits 0-11 * bits 0-11 */
