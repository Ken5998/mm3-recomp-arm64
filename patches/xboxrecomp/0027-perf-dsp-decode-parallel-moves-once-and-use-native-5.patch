+static void emu_ccr_update_scaled(dsp_core_t* dsp, uint32_t reg0, uint32_t reg1, uint32_t reg2);
+
+/* No scaling and no sixteen-bit arithmetic, nearly every update, inline and
+ * without branches: the same flags as case 0 of emu_ccr_update_scaled. */
+static DSP_HOT void emu_ccr_update_e_u_n_z(dsp_core_t* dsp, uint32_t reg0, uint32_t reg1, uint32_t reg2)
+{
+    uint32_t sr = dsp->registers[DSP_REG_SR], value_e, value_u;
+
+    if (sr & ((1u << DSP_SR_SA) | (BITMASK(2) << DSP_SR_S0))) {
+        emu_ccr_update_scaled(dsp, reg0, reg1, reg2);
+        return;
+    }
+    value_e = (reg0<<1) + (reg1>>23);
+    value_u = (reg1>>22) & 3;
+    sr &= ~(((1<<DSP_SR_E) | (1<<DSP_SR_U) | (1<<DSP_SR_N) | (1<<DSP_SR_Z)));
+    sr |= (uint32_t)(value_e != 0 && value_e != BITMASK(9)) << DSP_SR_E;
+    sr |= (uint32_t)(value_u == 0 || value_u == 3) << DSP_SR_U;
+    sr |= (uint32_t)((reg0 | reg1 | reg2) == 0) << DSP_SR_Z;
+    sr |= (reg0>>4) & 0x8;
+    dsp->registers[DSP_REG_SR] = sr;
+}
+
+static void emu_ccr_update_scaled(dsp_core_t* dsp, uint32_t reg0, uint32_t reg1, uint32_t reg2)
 {
     uint32_t scaling, value_e, value_u;
 
@@ -331,11 +353,21 @@ static void emu_ccr_update_e_u_n_z(dsp_core_t* dsp, uint32_t reg0, uint32_t reg1
