             /* A REP keeps the word it fetched even if P memory changed. */
-            op = lookup_opcode(dsp->cur_inst);
+            op = lookup_instruction(dsp->cur_inst);
         } else if (op == NULL) {
-            op = lookup_opcode(dsp->cur_inst);
+            op = lookup_instruction(dsp->cur_inst);
             dsp->pram_opcache[dsp->pc] = op;
         }
-        if (op->emu_func) {
-            op->emu_func(dsp);
-        } else {
-            DPRINTF("%x - %s\n", dsp->cur_inst, op->name);
-            emu_undefined(dsp);
-        }
-    } else {
-        /* Do parallel move read */
-        opcodes_parmove[(dsp->cur_inst>>20) & BITMASK(4)](dsp);
+        op->emu_func(dsp);
     }
 
     /* Disasm current instruction ? (trace mode only) */
@@ -821,8 +891,11 @@ void dsp56k_execute_batch(dsp_core_t* dsp, int *budget,
                           const volatile uint32_t *dma_control, uint32_t dma_running)
 {
     int left = *budget;
-    while (left > 0 && !(dsp->is_idle | dsp->is_waiting | dsp->is_stopped |
-                         dsp->is_debugging | ((*dma_control & dma_running) != 0))) {
+    if (dsp->is_waiting | dsp->is_stopped | dsp->is_debugging)
+        return;
+    /* WAIT, STOP and DEBUG set is_idle along with their own flag, so after
