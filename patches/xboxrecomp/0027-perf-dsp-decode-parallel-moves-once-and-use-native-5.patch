-    value = (dest[1]>>24) & BITMASK(8);
-    if (value) {
-        dest[0] += value;
-        dest[1] &= BITMASK(24);
-    }
-
-    /* Get rid of extra sign bit */
-    dsp_asl56(dest, 1);
-
-    if (signe) {
-        zerodest[0] = zerodest[1] = zerodest[2] = 0;
