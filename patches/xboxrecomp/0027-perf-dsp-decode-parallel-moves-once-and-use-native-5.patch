+    bool tracing = TRACE_DSP_DISASM || trace_event_get_state(TRACE_DSP56K_EXECUTE_INSTRUCTION_DISASM);
+    if (tracing) dsp->disasm_memory_ptr = 0;
 
-    /* Decode and execute current instruction */
-    if (dsp->loop_rep != 2) dsp->cur_inst = read_memory_p(dsp, dsp->pc);
+    /* Decode and execute current instruction. Every path that writes P
