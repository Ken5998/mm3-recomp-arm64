+    while (left > 0 && !(dsp->is_idle | ((*dma_control & dma_running) != 0))) {
         execute_instruction(dsp);
         left -= dsp->instr_cycle;
         dsp->cycle_count += dsp->instr_cycle;
@@ -1458,119 +1531,45 @@ static uint16_t dsp_asr56(uint32_t *dest, int n)
     return (carry<<DSP_SR_C);
 }
 
-static uint16_t dsp_add56(uint32_t *source, uint32_t *dest)
+/* The accumulator as one 56-bit value; each part is masked to its width. */
+static inline uint64_t dsp_pack56(const uint32_t *v)
 {
-    uint16_t overflow, carry, flg_s, flg_d, flg_r;
-
-    flg_s = (source[0]>>7) & 1;
-    flg_d = (dest[0]>>7) & 1;
-
-    /* Add source to dest: D = D+S */
-    dest[2] += source[2];
-    dest[1] += source[1]+((dest[2]>>24) & 1);
-    dest[0] += source[0]+((dest[1]>>24) & 1);
-
-    carry = (dest[0]>>8) & 1;
-
-    dest[2] &= BITMASK(24);
-    dest[1] &= BITMASK(24);
-    dest[0] &= BITMASK(8);
-
-    flg_r = (dest[0]>>7) & 1;
+    return ((uint64_t)(v[0] & BITMASK(8)) << 48) | ((uint64_t)(v[1] & BITMASK(24)) << 24) |
+           (v[2] & BITMASK(24));
+}
 
-    /*set overflow*/
-    overflow = (flg_s ^ flg_r) & (flg_d ^ flg_r);
+static inline void dsp_unpack56(uint64_t value, uint32_t *v)
+{
+    v[0] = (value >> 48) & BITMASK(8);
+    v[1] = (value >> 24) & BITMASK(24);
+    v[2] = value & BITMASK(24);
+}
 
+static uint16_t dsp_add56(uint32_t *source, uint32_t *dest)
+{
+    uint64_t s = dsp_pack56(source), d = dsp_pack56(dest), r = d + s;
+    uint16_t carry = (r >> 56) & 1;
+    uint16_t overflow = (((s ^ r) & (d ^ r)) >> 55) & 1;
+    dsp_unpack56(r, dest);
     return (overflow<<DSP_SR_L)|(overflow<<DSP_SR_V)|(carry<<DSP_SR_C);
 }
 
 static uint16_t dsp_sub56(uint32_t *source, uint32_t *dest)
 {
-    uint16_t overflow, carry, flg_s, flg_d, flg_r, dest_save;
