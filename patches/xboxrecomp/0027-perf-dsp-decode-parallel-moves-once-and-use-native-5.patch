+/* Fractional multiply: the 48-bit product, doubled, negated for -S1*S2. */
 static void dsp_mul56(uint32_t source1, uint32_t source2, uint32_t *dest, uint8_t signe)
 {
-    uint32_t part[4], zerodest[3], value;
-
-    /* Multiply: D = S1*S2 */
