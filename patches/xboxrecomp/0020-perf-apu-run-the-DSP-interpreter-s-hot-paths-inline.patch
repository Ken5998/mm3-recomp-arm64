-        return (dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SC)) ? 0xffff : 0xffffff;
-    if (reg == DSP_REG_SP && (dsp->registers[DSP_REG_OMR] & (1u << DSP_OMR_SEN)))
+    if (((DSP_ADDRESS_REGS >> reg) & 1) ||
+        (reg == DSP_REG_SP && (dsp->registers[DSP_REG_OMR] & (1u << DSP_OMR_SEN))))
         return (dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SC)) ? 0xffff : 0xffffff;
     return BITMASK(registers_mask[reg]);
 }
