--- a/src/apu/dsp/dsp.c
+++ b/src/apu/dsp/dsp.c
@@ -266,6 +266,11 @@ void dsp_run(DSPState *dsp, int cycles)
             continue;
         }
         bool dma_running = (dsp->dma.control & DMA_CONTROL_RUNNING) != 0;
+        if (!dma_running && !dsp->core.is_stopped && !dsp->core.is_debugging) {
+            dsp56k_execute_batch(&dsp->core, &dsp->save_cycles, &dsp->dma.control,
+                                 DMA_CONTROL_RUNNING);
+            continue;
+        }
         dsp56k_execute_instruction(&dsp->core);
         /* A START issued by this instruction schedules work for the next
          * instruction boundary, so the guest can observe the running engine. */
