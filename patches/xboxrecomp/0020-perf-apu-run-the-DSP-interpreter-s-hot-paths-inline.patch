-    return (reg >= DSP_REG_R0 && reg <= DSP_REG_M7) || reg == DSP_REG_LA || reg == DSP_REG_LC || reg == DSP_REG_VBA || reg == DSP_REG_EP || reg == DSP_REG_SZ || reg == DSP_REG_SSH || reg == DSP_REG_SSL || reg == DSP_REG_SP ?
