+/* Most data accesses hit plain X or Y RAM, so those skip the peripheral and
+ * mix buffer decode. The SC peripheral window (0xff80 up) lies above both. */
+static DSP_HOT uint32_t read_memory(dsp_core_t* dsp, int space, uint32_t address)
+{
+    if (space == DSP_SPACE_X) {
+        if (address < 0xc00) return dsp->xram[address];
+        if (address - 0xc00 < DSP_MIXBUFFER_SIZE) return dsp->mixbuffer[address - 0xc00];
+        if (address - DSP_MIXBUFFER_BASE < DSP_MIXBUFFER_SIZE)
+            return dsp->mixbuffer[address - DSP_MIXBUFFER_BASE];
+    } else if (space == DSP_SPACE_Y && address < DSP_YRAM_SIZE) {
+        return dsp->yram[address];
+    }
+    return dsp56k_read_memory(dsp, space, address);
+}
+
+static DSP_HOT void write_memory(dsp_core_t* dsp, int space, uint32_t address, uint32_t value)
+{
+    if (!TRACE_DSP_DISASM_MEM && (value & 0xFF000000) == 0) {
+        if (space == DSP_SPACE_X) {
+            if (address < 0xc00) {
+                dsp->xram[address] = value;
+                return;
+            }
+            if (address - 0xc00 < DSP_MIXBUFFER_SIZE) {
+                dsp->mixbuffer[address - 0xc00] = value;
+                return;
+            }
+            if (address - DSP_MIXBUFFER_BASE < DSP_MIXBUFFER_SIZE) {
+                dsp->mixbuffer[address - DSP_MIXBUFFER_BASE] = value;
+                return;
+            }
+        } else if (space == DSP_SPACE_Y && address < DSP_YRAM_SIZE) {
+            dsp->yram[address] = value;
+            return;
+        }
+    }
+    dsp56k_write_memory(dsp, space, address, value);
+}
+
+static void dsp_write_reg_full(dsp_core_t* dsp, uint32_t numreg, uint32_t value);
+
+/* Outside sixteen-bit arithmetic, data, accumulator and address registers
+ * only take their width; everything else goes through the full path. */
+static DSP_HOT void dsp_write_reg(dsp_core_t* dsp, uint32_t numreg, uint32_t value)
+{
+    if (!(dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SA))) {
+        if (numreg >= DSP_REG_X0 && numreg <= DSP_REG_B1 &&
+            numreg != DSP_REG_A2 && numreg != DSP_REG_B2) {
+            dsp->registers[numreg] = value & 0xffffff;
+            return;
+        }
+        if (numreg == DSP_REG_A || numreg == DSP_REG_B) {
+            unsigned acc = numreg - DSP_REG_A;
+            dsp->registers[DSP_REG_A0 + acc] = 0;
+            dsp->registers[DSP_REG_A1 + acc] = value;
+            dsp->registers[DSP_REG_A2 + acc] = value & (1<<23) ? 0xff : 0x0;
+            return;
+        }
+        if (numreg >= DSP_REG_R0 && numreg <= DSP_REG_M7) {
+            dsp->registers[numreg] = value &
+                ((dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SC)) ? 0xffff : 0xffffff);
+            return;
+        }
+    }
+    dsp_write_reg_full(dsp, numreg, value);
+}
