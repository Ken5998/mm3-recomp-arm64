+void dsp56k_execute_instruction(dsp_core_t* dsp)
+{
+    if (dsp->is_waiting || dsp->is_stopped || dsp->is_debugging) {
+        dsp->instr_cycle = 0;
+        return;
+    }
+    execute_instruction(dsp);
+}
+
+/* Runs instructions back to back while nothing outside the core needs a look
+ * between them: until the cycle budget is spent, the core waits, idles, stops
+ * or enters debug mode, or a DMA transfer runs (the caller steps it after each
+ * instruction). Each instruction executes exactly as a
+ * dsp56k_execute_instruction call would. */
+void dsp56k_execute_batch(dsp_core_t* dsp, int *budget,
+                          const volatile uint32_t *dma_control, uint32_t dma_running)
+{
+    int left = *budget;
+    while (left > 0 && !(dsp->is_idle | dsp->is_waiting | dsp->is_stopped |
+                         dsp->is_debugging | ((*dma_control & dma_running) != 0))) {
+        execute_instruction(dsp);
+        left -= dsp->instr_cycle;
+        dsp->cycle_count += dsp->instr_cycle;
+    }
+    *budget = left;
+}
