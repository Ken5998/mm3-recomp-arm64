 src/apu/dsp/interp/dsp_cpu.c     | 134 ++++++++++++++++---
 src/apu/dsp/interp/dsp_cpu.h     |   2 +
 src/apu/dsp/interp/dsp_emu.c.inc | 212 +++++++++++++++++--------------
 4 files changed, 240 insertions(+), 113 deletions(-)

