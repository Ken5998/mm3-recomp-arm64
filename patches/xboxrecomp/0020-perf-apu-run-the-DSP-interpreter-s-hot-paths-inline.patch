-static uint32_t dsp_register_mask(dsp_core_t* dsp, unsigned reg)
+/* The address-sized registers, whose width follows SR's SC bit: R0-M7, EP,
+ * VBA, SZ, SSH, SSL, LA and LC, one bit per register number. Testing a bit
+ * replaces a chain of comparisons on every register write and address update. */
+#define DSP_ADDRESS_REGS ((((1ull << (DSP_REG_M7 + 1)) - 1) & ~((1ull << DSP_REG_R0) - 1)) | \
+    (1ull << DSP_REG_LA) | (1ull << DSP_REG_LC) | (1ull << DSP_REG_VBA) | (1ull << DSP_REG_EP) | \
+    (1ull << DSP_REG_SZ) | (1ull << DSP_REG_SSH) | (1ull << DSP_REG_SSL))
+
+static DSP_HOT uint32_t dsp_register_mask(dsp_core_t* dsp, unsigned reg)
 {
