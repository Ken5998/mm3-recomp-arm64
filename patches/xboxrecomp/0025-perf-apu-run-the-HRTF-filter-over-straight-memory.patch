diff --git a/tests/apu_hrtf/test_main.c b/tests/apu_hrtf/test_main.c
new file mode 100644
index 0000000..54cd9dc
--- /dev/null
+++ b/tests/apu_hrtf/test_main.c
@@ -0,0 +1,120 @@
+/* The HRTF filter (apu_state.h) against the straightforward form it replaced:
+ * the same output to float rounding, from random histories, coefficients and
+ * interaural delays that move while it runs, and how long each takes. */
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+#include "apu_state.h"
+
+struct McpxApuDebug g_dbg;
+uint8_t *g_apu_ram_ptr;
+uint8_t *mcpx_apu_phys(uint64_t addr) { (void)addr; return NULL; }
+
+/* What xemu's vp/hrtf.h does, as this runtime had it (it uses the first
+ * HRTF_BUFLEN floats of the history). */
+static inline void reference_process(HrtfFilter *f,
+                                       float in[][2],
+                                       float out[][2]) {
+    for (int n = 0; n < HRTF_SAMPLES_PER_FRAME; n++) {
+        hrtf_filter_step_parameters(f);
+        for (int ch = 0; ch < 2; ch++) {
+            float *buf = f->ch[ch].buf;
+            float *coeff = f->ch[ch].hrir_coeff_cur;
+            buf[f->buf_pos] = in[n][ch];
+            float d = f->itd_cur * (ch == 0 ? +1.0f : -1.0f);
+            if (d < 0.0f) d = 0.0f;
+            int di = (int)d;
+            float dfrac = d - di;
+            float acc = 0.0f;
+            for (int k = 0; k < HRTF_NUM_TAPS; k++) {
+                int idx1 = (f->buf_pos - di - k + HRTF_BUFLEN) % HRTF_BUFLEN;
+                float s = buf[idx1];
+                if (dfrac > 0.0f) {
+                    int idx2 = (idx1 - 1 + HRTF_BUFLEN) % HRTF_BUFLEN;
+                    s = s * (1 - dfrac) + buf[idx2] * dfrac;
+                }
+                acc += coeff[k] * s;
+            }
+            out[n][ch] = acc;
+        }
+        f->buf_pos = (f->buf_pos + 1) % HRTF_BUFLEN;
+    }
+}
+
+static float frand(void) { return (float)rand() / (float)RAND_MAX * 2.0f - 1.0f; }
+
+static double now_us(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1e6 + t.tv_nsec / 1e3;
+}
+
+int main(void)
+{
+    static HrtfFilter a, b;
+    float coeff[2][HRTF_NUM_TAPS];
+    float in[HRTF_SAMPLES_PER_FRAME][2], out_a[HRTF_SAMPLES_PER_FRAME][2], out_b[HRTF_SAMPLES_PER_FRAME][2];
+    double worst = 0.0, scale = 0.0, ta = 0.0, tb = 0.0;
+    const int frames = 20000;
+
+    srand(1);
+    hrtf_filter_init(&a);
+    for (int frame = 0; frame < frames; frame++) {
+        if (frame % 50 == 0) {   /* the title moves the source */
+            for (int ch = 0; ch < 2; ch++)
+                for (int k = 0; k < HRTF_NUM_TAPS; k++)
+                    coeff[ch][k] = frand();
+            /* whole, fractional, negative and clamped delays */
+            float itd = frame % 200 == 0 ? 0.0f : frand() * 50.0f;
+            hrtf_filter_set_target_params(&a, coeff, itd);
+        }
+        if (frame == 0)
+            b = a;
+        else {
+            b.itd_tar = a.itd_tar;
+            for (int ch = 0; ch < 2; ch++)
+                memcpy(b.ch[ch].hrir_coeff_tar, a.ch[ch].hrir_coeff_tar, sizeof(a.ch[ch].hrir_coeff_tar));
+        }
+        for (int i = 0; i < HRTF_SAMPLES_PER_FRAME; i++) {
+            in[i][0] = frand();
+            in[i][1] = frand();
+        }
+        double t0 = now_us();
+        reference_process(&a, in, out_a);
+        double t1 = now_us();
+        hrtf_filter_process(&b, in, out_b);
+        double t2 = now_us();
+        ta += t1 - t0;
+        tb += t2 - t1;
+        for (int i = 0; i < HRTF_SAMPLES_PER_FRAME; i++)
+            for (int ch = 0; ch < 2; ch++) {
+                double diff = fabs((double)out_a[i][ch] - out_b[i][ch]);
+                if (!isfinite(out_b[i][ch])) {
+                    fprintf(stderr, "FAIL frame %d: not a number\n", frame);
+                    return 1;
+                }
+                if (diff > worst) worst = diff;
+                if (fabs(out_a[i][ch]) > scale) scale = fabs(out_a[i][ch]);
+            }
+        bool same = a.buf_pos == b.buf_pos && a.itd_cur == b.itd_cur;
+        for (int ch = 0; ch < 2; ch++) {
+            same = same && !memcmp(a.ch[ch].buf, b.ch[ch].buf, HRTF_BUFLEN * sizeof(float)) &&
+                   !memcmp(b.ch[ch].buf, b.ch[ch].buf + HRTF_BUFLEN, HRTF_BUFLEN * sizeof(float)) &&
+                   !memcmp(a.ch[ch].hrir_coeff_cur, b.ch[ch].hrir_coeff_cur, sizeof(a.ch[ch].hrir_coeff_cur));
+        }
+        if (!same) {
+            fprintf(stderr, "FAIL frame %d: the filter state differs\n", frame);
+            return 1;
+        }
+    }
+    printf("HRTF: largest difference %.3g on outputs up to %.3g; %.2f us a voice frame, was %.2f us\n",
+           worst, scale, tb / frames, ta / frames);
+    if (worst > 1e-5 * (scale > 1.0 ? scale : 1.0)) {
+        fprintf(stderr, "FAIL: the output moved by %.3g\n", worst);
+        return 1;
+    }
+    return 0;
+}
