From 3c32131f9a433a22532341e6daf6608d5e43bc70 Mon Sep 17 00:00:00 2001
From: Ken5998 <46025606+Ken5998@users.noreply.github.com>
Date: Mon, 19 Oct 2026 20:54:55 +0000
Subject: [PATCH 25/26] perf(apu): run the HRTF filter over straight memory

Each 3D voice runs a 31-tap filter per ear and sample. With a modulo per tap
and one serial sum that cost several us a voice frame, which with a race's
dozens of 3D voices kept Midtown Madness 3's voice processor at 210-470 us of
the 667 us a frame of sound lasts. The history ring is now kept twice over so
the taps read one straight run, summed in four partial sums: 3.5x faster with
clang. tests/apu_hrtf checks it against the old form (output within float
rounding, same state) and prints both times.
---
 src/apu/apu_state.h           |  48 ++++++++++----
 tests/apu_hrtf/CMakeLists.txt |  14 ++++
 tests/apu_hrtf/test_main.c    | 120 ++++++++++++++++++++++++++++++++++
 3 files changed, 170 insertions(+), 12 deletions(-)
 create mode 100644 tests/apu_hrtf/CMakeLists.txt
 create mode 100644 tests/apu_hrtf/test_main.c

diff --git a/src/apu/apu_state.h b/src/apu/apu_state.h
index eaa5ffd..125fb0a 100644
--- a/src/apu/apu_state.h
+++ b/src/apu/apu_state.h
@@ -93,7 +93,9 @@ static inline float run_svf(sv_filter *sv, float in) {
 typedef struct {
     int buf_pos;
     struct {
-        float buf[HRTF_BUFLEN];
+        /* The history ring, written twice (at buf_pos and buf_pos +
+         * HRTF_BUFLEN) so the taps read it as one straight run. */
+        float buf[2 * HRTF_BUFLEN];
         float hrir_coeff_cur[HRTF_NUM_TAPS];
         float hrir_coeff_tar[HRTF_NUM_TAPS];
     } ch[2];
@@ -145,6 +147,12 @@ static inline void hrtf_filter_step_parameters(HrtfFilter *f) {
     f->itd_cur = hrtf_filter_smooth_param(f->itd_cur, f->itd_tar);
 }
 
+/* Each output sample is a 31-tap FIR over the channel's history, delayed by
+ * the interaural time difference with a linear fraction. The history ring is
+ * kept twice over, so the taps read straight memory, summed in four partial
+ * sums. With a modulo per tap and one serial sum a 3D voice cost several us a
+ * frame, which with a race's dozens of 3D voices kept the voice processor
+ * from real time on a phone-class core. */
 static inline void hrtf_filter_process(HrtfFilter *f,
                                        float in[][2],
                                        float out[][2]) {
@@ -152,23 +160,39 @@ static inline void hrtf_filter_process(HrtfFilter *f,
         hrtf_filter_step_parameters(f);
         for (int ch = 0; ch < 2; ch++) {
             float *buf = f->ch[ch].buf;
-            float *coeff = f->ch[ch].hrir_coeff_cur;
-            buf[f->buf_pos] = in[n][ch];
+            const float *coeff = f->ch[ch].hrir_coeff_cur;
+            buf[f->buf_pos] = buf[f->buf_pos + HRTF_BUFLEN] = in[n][ch];
             float d = f->itd_cur * (ch == 0 ? +1.0f : -1.0f);
             if (d < 0.0f) d = 0.0f;
             int di = (int)d;
             float dfrac = d - di;
-            float acc = 0.0f;
-            for (int k = 0; k < HRTF_NUM_TAPS; k++) {
-                int idx1 = (f->buf_pos - di - k + HRTF_BUFLEN) % HRTF_BUFLEN;
-                float s = buf[idx1];
-                if (dfrac > 0.0f) {
-                    int idx2 = (idx1 - 1 + HRTF_BUFLEN) % HRTF_BUFLEN;
-                    s = s * (1 - dfrac) + buf[idx2] * dfrac;
+            /* tap k is history pos - di - k; one more for the fraction. */
+            int at = f->buf_pos - di;
+            if (at < 0) at += HRTF_BUFLEN;
+            const float *h = &buf[at + HRTF_BUFLEN];
+            float acc0 = 0.0f, acc1 = 0.0f, acc2 = 0.0f, acc3 = 0.0f;
+            int k = 0;
+            if (dfrac > 0.0f) {
+                float keep = 1 - dfrac;
+                for (; k + 4 <= HRTF_NUM_TAPS; k += 4) {
+                    acc0 += coeff[k] * (h[-k] * keep + h[-(k + 1)] * dfrac);
+                    acc1 += coeff[k + 1] * (h[-(k + 1)] * keep + h[-(k + 2)] * dfrac);
+                    acc2 += coeff[k + 2] * (h[-(k + 2)] * keep + h[-(k + 3)] * dfrac);
+                    acc3 += coeff[k + 3] * (h[-(k + 3)] * keep + h[-(k + 4)] * dfrac);
                 }
-                acc += coeff[k] * s;
+                for (; k < HRTF_NUM_TAPS; k++)
+                    acc0 += coeff[k] * (h[-k] * keep + h[-(k + 1)] * dfrac);
+            } else {
+                for (; k + 4 <= HRTF_NUM_TAPS; k += 4) {
+                    acc0 += coeff[k] * h[-k];
+                    acc1 += coeff[k + 1] * h[-(k + 1)];
+                    acc2 += coeff[k + 2] * h[-(k + 2)];
+                    acc3 += coeff[k + 3] * h[-(k + 3)];
+                }
+                for (; k < HRTF_NUM_TAPS; k++)
+                    acc0 += coeff[k] * h[-k];
             }
-            out[n][ch] = acc;
+            out[n][ch] = (acc0 + acc1) + (acc2 + acc3);
         }
         f->buf_pos = (f->buf_pos + 1) % HRTF_BUFLEN;
     }
diff --git a/tests/apu_hrtf/CMakeLists.txt b/tests/apu_hrtf/CMakeLists.txt
