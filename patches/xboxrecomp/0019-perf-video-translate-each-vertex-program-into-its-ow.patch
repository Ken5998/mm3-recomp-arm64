+static void vs_compile(VsSpec *e)
+{
+    static const char marker[] = "/*VSPEC_FN*/";
+    const char *define = e->key.n ? "#define VSPEC 1\n#define VSPEC_PT 0\n"
+                                  : "#define VSPEC 1\n#define VSPEC_PT 1\n";
+    size_t dl = strlen(define);
+    size_t base_len, fn_len, head, cap = 256 * 1024;
+    const char *base = hlsl_source(&base_len);
+    const char *at = strstr(base, marker);
+    char *fn = (char *)malloc(cap), *src = NULL;
+    ID3DBlob *b = NULL;
+    fn_len = fn && at ? (e->key.n ? vs_source(&e->key, fn, cap) : (fn[0] = ' ', 1)) : 0;
+    if (fn_len) src = (char *)malloc(dl + base_len + fn_len + 1);
+    if (src) {
+        head = (size_t)(at - base);
+        memcpy(src, define, dl);
+        memcpy(src + dl, base, head);
+        memcpy(src + dl + head, fn, fn_len);
+        memcpy(src + dl + head + fn_len, at, base_len - head);
+        b = compile_text(src, dl + base_len + fn_len, "ub_vs", "vs_5_0", NULL);
+    }
+    if (b && SUCCEEDED(ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(b),
+                                                       ID3D10Blob_GetBufferSize(b), NULL, &e->vs))) {
+        LONG n;
+        InterlockedExchange(&e->state, 2);
+        n = InterlockedIncrement(&s_vspec_ready);
+        if (!(n & (n - 1)))
+            fprintf(stderr, "[D3D11] %ld specialised vertex programs\n", (long)n);
+    } else {
+        InterlockedExchange(&e->state, 3);
+    }
+    if (b) ID3D10Blob_Release(b);
+    free(src);
+    free(fn);
+}
+
+/* The specialised vertex shader for the program from slot start (NULL for a
+ * pre-transformed draw), or NULL if it is not ready yet. pver is the
+ * program memory's change counter: while it and start stay the same the
+ * last answer stands without hashing the program again. */
+static ID3D11VertexShader *spec_vs(const uint32_t (*prog)[4], uint32_t start, uint32_t pver)
+{
+    static int enabled = -1, sync;
+    static VsKey k;
+    static VsSpec *last;
+    static uint32_t last_start = 0xFFFFFFFFu, last_pver;
+    static int last_prog = -1;
+    uint32_t h = 2166136261u, i, words;
+    VsSpec *e;
+    if (enabled < 0) {
+        const char *v = getenv("RECOMP_VS_SPEC");
+        enabled = !(v && *v == '0');
+        sync = v && !strcmp(v, "sync");
+        if (enabled) s_vspec = (VsSpec *)calloc(VS_SPEC_SLOTS, sizeof *s_vspec);
+        if (!s_vspec) enabled = 0;
+        if (enabled && !sync) enabled = spec_start();
+    }
+    if (!enabled) return NULL;
+    if (last && last_prog == (prog != NULL) && (!prog || (start == last_start && pver == last_pver)))
+        return InterlockedCompareExchange(&last->state, 0, 0) == 2 ? last->vs : NULL;
+    memset(&k, 0, sizeof k);
+    if (prog)
+        for (i = start; i < VS_SPEC_MAX; i++) {
+            memcpy(k.w[k.n++], prog[i], 16);
+            if (prog[i][3] & 1u) break;
+        }
+    words = 1 + k.n * 4;
+    for (i = 0; i < words; i++) h = (h ^ ((const uint32_t *)&k)[i]) * 16777619u;
+    for (i = 0; i < VS_SPEC_SLOTS; i++) {
+        e = &s_vspec[(h + i) & (VS_SPEC_SLOTS - 1)];
+        if (!e->state) break;
+        if (!memcmp(&e->key, &k, sizeof k)) {
+            last = e; last_prog = prog != NULL; last_start = start; last_pver = pver;
+            return InterlockedCompareExchange(&e->state, 0, 0) == 2 ? e->vs : NULL;
+        }
+    }
+    if (i == VS_SPEC_SLOTS) return NULL;            /* table full: ub_vs */
+    if (sync) {
+        e->key = k;
+        e->state = 1;
+        vs_compile(e);
+        last = e; last_prog = prog != NULL; last_start = start; last_pver = pver;
+        return e->state == 2 ? e->vs : NULL;
+    }
+    EnterCriticalSection(&s_spec_cs);
+    if (s_vspec_head - s_vspec_tail < VS_SPEC_QUEUE) {
+        e->key = k;
+        e->state = 1;
+        s_vspec_q[s_vspec_head++ % VS_SPEC_QUEUE] = e;
+        WakeConditionVariable(&s_spec_cv);
+        last = e; last_prog = prog != NULL; last_start = start; last_pver = pver;
+    }
+    LeaveCriticalSection(&s_spec_cs);
+    return NULL;
+}
