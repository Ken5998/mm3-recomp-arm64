+
+/* ------------------------------------------------- compiled shader cache
+ * vkd3d's HLSL compiler takes from tens of milliseconds to seconds a shader,
+ * so with RECOMP_SHADER_CACHE naming a directory every compiled shader is
+ * kept there, named by a hash of its source, entry, target and defines and
+ * of this build's time (a new build starts afresh), and later runs load it
+ * instead of compiling. */
+typedef struct { ID3D10Blob iface; volatile LONG ref; SIZE_T size; } CacheBlob;
+static HRESULT STDMETHODCALLTYPE cache_blob_qi(ID3D10Blob *b, REFIID iid, void **out)
+{ (void)b; (void)iid; *out = NULL; return E_NOINTERFACE; }
+static ULONG STDMETHODCALLTYPE cache_blob_addref(ID3D10Blob *b)
+{ return (ULONG)InterlockedIncrement(&((CacheBlob *)b)->ref); }
+static ULONG STDMETHODCALLTYPE cache_blob_release(ID3D10Blob *b)
+{
+    LONG n = InterlockedDecrement(&((CacheBlob *)b)->ref);
+    if (!n) free(b);
+    return (ULONG)n;
+}
+static void *STDMETHODCALLTYPE cache_blob_ptr(ID3D10Blob *b) { return (CacheBlob *)b + 1; }
+static SIZE_T STDMETHODCALLTYPE cache_blob_size(ID3D10Blob *b) { return ((CacheBlob *)b)->size; }
+static ID3D10BlobVtbl s_cache_blob_vtbl = {
+    cache_blob_qi, cache_blob_addref, cache_blob_release, cache_blob_ptr, cache_blob_size };
+
+static uint64_t cache_hash(uint64_t h, const char *p, size_t n)
+{
+    while (n--) h = (h ^ (uint8_t)*p++) * 0x100000001b3ull;
+    return (h ^ 0xFF) * 0x100000001b3ull;           /* a separator */
+}
+
+/* The cache file for this compile, or 0 without a cache directory. */
+static int cache_path(char *path, size_t cap, const char *src, size_t len, const char *entry,
+                      const char *target, const D3D_SHADER_MACRO *def)
+{
+    static const char build[] = __DATE__ " " __TIME__;
+    const char *dir = getenv("RECOMP_SHADER_CACHE");
+    uint64_t h = 0xcbf29ce484222325ull;
+    if (!dir || !*dir) return 0;
+    h = cache_hash(h, build, sizeof build - 1);
+    h = cache_hash(h, src, len);
+    h = cache_hash(h, entry, strlen(entry));
+    h = cache_hash(h, target, strlen(target));
+    for (; def && def->Name; def++) {
+        h = cache_hash(h, def->Name, strlen(def->Name));
+        h = cache_hash(h, def->Definition ? def->Definition : "", def->Definition ? strlen(def->Definition) : 0);
+    }
+    return snprintf(path, cap, "%s/%016llx.dxbc", dir, (unsigned long long)h) < (int)cap;
+}
+
+static ID3DBlob *cache_load(const char *path)
+{
+    FILE *f = fopen(path, "rb");
+    CacheBlob *b = NULL;
+    long n;
+    if (!f) return NULL;
+    if (fseek(f, 0, SEEK_END) == 0 && (n = ftell(f)) > 4 && fseek(f, 0, SEEK_SET) == 0 &&
+        (b = (CacheBlob *)malloc(sizeof *b + (size_t)n)) != NULL) {
+        b->iface.lpVtbl = &s_cache_blob_vtbl;
+        b->ref = 1;
+        b->size = (SIZE_T)n;
+        if (fread(b + 1, 1, (size_t)n, f) != (size_t)n || memcmp(b + 1, "DXBC", 4)) {
+            free(b);
+            b = NULL;
+        }
+    }
+    fclose(f);
+    return b ? &b->iface : NULL;
+}
+
+/* Written beside the final name and renamed over it, so a reader never sees
+ * half a file. */
+static void cache_store(const char *path, ID3DBlob *code)
+{
+    char tmp[1100];
+    FILE *f;
+    size_t n = ID3D10Blob_GetBufferSize(code);
+    if (snprintf(tmp, sizeof tmp, "%s.%p.tmp", path, (void *)code) >= (int)sizeof tmp) return;
+    if (!(f = fopen(tmp, "wb"))) return;
+    if (fwrite(ID3D10Blob_GetBufferPointer(code), 1, n, f) != n) { fclose(f); remove(tmp); return; }
+    if (fclose(f) != 0 || rename(tmp, path) != 0) remove(tmp);
+}
+
+static ID3DBlob *compile_text(const char *src, size_t len, const char *entry,
+                              const char *target, const D3D_SHADER_MACRO *def)
+{
+    static const D3D_SHADER_MACRO vs_def[] = { { "RT_SAMPLES", "1u" }, { NULL, NULL } };
+    ID3DBlob *code = NULL, *err = NULL;
+    HRESULT hr;
+    char path[1024];
+    int cached;
     if (!def && target[0] == 'v')
         def = vs_def;
+    cached = cache_path(path, sizeof path, src, len, entry, target, def);
+    if (cached && (code = cache_load(path)) != NULL)
+        return code;
     hr = D3DCompile(src, len, "nv2a_d3d11", def, NULL,
                     entry, target, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0,
                     &code, &err);
@@ -948,9 +1063,17 @@ static ID3DBlob *compile_def(const char *entry, const char *target, const D3D_SH
         fflush(stderr);
     }
     if (err) ID3D10Blob_Release(err);
+    if (SUCCEEDED(hr) && code && cached) cache_store(path, code);
     return SUCCEEDED(hr) ? code : NULL;
 }
 
+static ID3DBlob *compile_def(const char *entry, const char *target, const D3D_SHADER_MACRO *def)
+{
+    size_t len;
+    const char *src = hlsl_source(&len);
+    return compile_text(src, len, entry, target, def);
+}
+
 static ID3DBlob *compile(const char *entry, const char *target)
 {
     return compile_def(entry, target, NULL);
@@ -986,6 +1109,36 @@ static CRITICAL_SECTION s_spec_cs;
 static CONDITION_VARIABLE s_spec_cv;
 static volatile LONG s_spec_ready;
 
+/* ------------------------------------------------- specialised vertex shaders
+ * ub_vs interprets the vertex program per vertex, keeping the temporaries,
+ * inputs and outputs in arrays it indexes at run time. Mobile GPUs (Adreno)
+ * put such arrays in memory rather than registers, and the interpreter was
+ * most of a frame's GPU time there. Each program (the slots from the start
+ * slot to the final flag) gets a variant translated to straight-line code by
+ * vs_source, compiled on the same workers as the pixel variants; draws use
+ * ub_vs until it is ready. A variant with no program serves pre-transformed
+ * draws. Constants, input formats and everything else stay in the cbuffers.
+ * RECOMP_VS_SPEC=0 disables this; =sync compiles on the drawing thread. */
+#define VS_SPEC_MAX 136             /* program slots */
+typedef struct {
+    uint32_t n;                     /* instructions; 0 for pre-transformed */
+    uint32_t w[VS_SPEC_MAX][4];
+} VsKey;
+
+typedef struct {
+    VsKey key;
+    volatile LONG state;            /* 0 empty, 1 queued, 2 ready, 3 failed */
+    ID3D11VertexShader *vs;         /* valid once state is 2 */
+} VsSpec;
+
+#define VS_SPEC_SLOTS 1024          /* power of two */
+#define VS_SPEC_QUEUE 256
+static VsSpec *s_vspec;
+static VsSpec *s_vspec_q[VS_SPEC_QUEUE];
+static unsigned s_vspec_head, s_vspec_tail;  /* guarded by s_spec_cs */
+static volatile LONG s_vspec_ready;
+static void vs_compile(VsSpec *e);
+
 static DWORD WINAPI spec_worker(LPVOID arg)
 {
     (void)arg;
@@ -997,8 +1150,14 @@ static DWORD WINAPI spec_worker(LPVOID arg)
         int flat;
         D3D_SHADER_MACRO m[4];
         EnterCriticalSection(&s_spec_cs);
-        while (s_spec_head == s_spec_tail)
+        while (s_spec_head == s_spec_tail && s_vspec_head == s_vspec_tail)
             SleepConditionVariableCS(&s_spec_cv, &s_spec_cs, INFINITE);
+        if (s_vspec_head != s_vspec_tail) {    /* vertex programs first */
+            VsSpec *v = s_vspec_q[s_vspec_tail++ % VS_SPEC_QUEUE];
+            LeaveCriticalSection(&s_spec_cs);
+            vs_compile(v);
+            continue;
+        }
         e = s_spec_q[s_spec_tail++ % PS_SPEC_QUEUE];
         LeaveCriticalSection(&s_spec_cs);
         k = &e->key;
@@ -1048,6 +1207,22 @@ static DWORD WINAPI spec_worker(LPVOID arg)
     }
 }
 
+/* The compile workers, shared by pixel and vertex variants; started once. */
+static int spec_start(void)
+{
+    static int started;
+    int threads = 2;
+    if (started) return 1;
+    started = 1;
+    InitializeCriticalSection(&s_spec_cs);
+    InitializeConditionVariable(&s_spec_cv);
+    while (threads--) {
+        HANDLE t = CreateThread(NULL, 0, spec_worker, NULL, 0, NULL);
+        if (t) { SetThreadPriority(t, THREAD_PRIORITY_BELOW_NORMAL); CloseHandle(t); }
+    }
+    return 1;
+}
+
 /* The specialised shader for this configuration, or NULL (not ready yet). */
 static ID3D11PixelShader *spec_ps(const PSConsts *pc, uint32_t variant)
 {
@@ -1058,18 +1233,10 @@ static ID3D11PixelShader *spec_ps(const PSConsts *pc, uint32_t variant)
     PsSpec *e;
     if (enabled < 0) {
         const char *v = getenv("RECOMP_PS_SPEC");
-        int threads = 2;
         enabled = !(v && *v == '0');
         if (enabled) s_spec = (PsSpec *)calloc(PS_SPEC_SLOTS, sizeof *s_spec);
         if (!s_spec) enabled = 0;
-        if (enabled) {
-            InitializeCriticalSection(&s_spec_cs);
-            InitializeConditionVariable(&s_spec_cv);
-            while (threads--) {
-                HANDLE t = CreateThread(NULL, 0, spec_worker, NULL, 0, NULL);
-                if (t) { SetThreadPriority(t, THREAD_PRIORITY_BELOW_NORMAL); CloseHandle(t); }
-            }
-        }
+        if (enabled) enabled = spec_start();
     }
     if (!enabled) return NULL;
     memset(&k, 0, sizeof k);
@@ -1104,6 +1271,259 @@ static ID3D11PixelShader *spec_ps(const PSConsts *pc, uint32_t variant)
     return NULL;
 }
 
+/* Appends to a growing string; on overflow the text is dropped (len = cap). */
+typedef struct { char *p; size_t len, cap; } VsText;
+static void vt(VsText *t, const char *fmt, ...)
+{
+    va_list ap;
+    int n;
+    if (t->len >= t->cap) return;
+    va_start(ap, fmt);
+    n = vsnprintf(t->p + t->len, t->cap - t->len, fmt, ap);
+    va_end(ap);
+    t->len = n < 0 || (size_t)n >= t->cap - t->len ? t->cap : t->len + (size_t)n;
+}
+
+/* One operand as ub_vs's rd() reads it, with the fields as constants. */
+static void vs_operand(VsText *t, uint32_t swz, uint32_t neg, uint32_t mux, uint32_t reg,
+                       uint32_t vi, uint32_t ci, int rel)
+{
+    static const char comp[] = "xyzw";
+    char base[40];
+    if (mux == 1) snprintf(base, sizeof base, "R%u", reg < 13u ? reg : 0u);
+    else if (mux == 2) snprintf(base, sizeof base, "V%u", vi);
+    else if (rel) snprintf(base, sizeof base, "C[vs_ci(a0 + %u)]", ci);
+    else snprintf(base, sizeof base, "C[%u]", ci < 192u ? ci : 0u);
+    vt(t, "%s%s.%c%c%c%c", neg ? "-" : "", base, comp[(swz >> 6) & 3], comp[(swz >> 4) & 3],
+       comp[(swz >> 2) & 3], comp[swz & 3]);
+}
+
+static const char *vs_mask(uint32_t m)
+{
+    static const char *const names[16] = { "", "w", "z", "zw", "y", "yw", "yz", "yzw",
+        "x", "xw", "xz", "xzw", "xy", "xyw", "xyz", "xyzw" };
+    return names[m & 15u];
+}
+
+/* The HLSL of vs_prog for one program: ub_vs's loop body once per
+ * instruction, every field a constant, every register its own variable.
+ * Returns the text's length, or 0 if it did not fit. */
+static size_t vs_source(const VsKey *k, char *buf, size_t cap)
+{
+    VsText t = { buf, 0, cap };
+    uint32_t used = 0, s, i;
+    for (s = 0; s < k->n; s++) {
+        const uint32_t *w = k->w[s];
+        uint32_t mac = (w[1] >> 21) & 15u, ilu = (w[1] >> 25) & 7u;
+        if ((mac != 0u && ((w[2] >> 26) & 3u) == 2u) ||
+            ((mac == 2u || (mac >= 4u && mac <= 12u)) && ((w[2] >> 11) & 3u) == 2u) ||
+            ((mac == 3u || mac == 4u || ilu != 0u) && ((w[3] >> 28) & 3u) == 2u))
+            used |= 1u << ((w[1] >> 9) & 15u);
+    }
+    vt(&t, "uint vs_ci(int c) { return c >= 0 && c < 192 ? (uint)c : 0u; }\n"
+           "void vs_prog(uint vid, out float4 P, out float4 d0, out float4 d1, out float fog,\n"
+           "    out float4 t0, out float4 t1, out float4 t2, out float4 t3) {\n"
+           "  float4 R0 = 0, R1 = 0, R2 = 0, R3 = 0, R4 = 0, R5 = 0, R6 = 0, R7 = 0, R8 = 0,"
+           " R9 = 0, R10 = 0, R11 = 0, R12 = 0;\n"
+           "  float4 O3 = float4(0, 0, 0, 1), O4 = float4(0, 0, 0, 1), O5 = 0;\n"
+           "  float4 O9 = float4(0, 0, 0, 1), O10 = float4(0, 0, 0, 1), O11 = float4(0, 0, 0, 1),"
+           " O12 = float4(0, 0, 0, 1);\n"
+           "  int a0 = 0;\n");
+    for (i = 0; i < 16; i++)
+        if (used & (1u << i)) vt(&t, "  float4 V%u = fetch(%uu, vid);\n", i, i);
+    for (s = 0; s < k->n; s++) {
+        const uint32_t *w = k->w[s];
+        uint32_t mac = (w[1] >> 21) & 15u, ilu = (w[1] >> 25) & 7u, vi = (w[1] >> 9) & 15u;
+        uint32_t ci = (w[1] >> 13) & 255u;
+        int rel = (int)((w[3] >> 1) & 1u);
+        uint32_t mm = (w[3] >> 24) & 15u, im = (w[3] >> 16) & 15u, td = (w[3] >> 20) & 15u;
+        uint32_t om = (w[3] >> 12) & 15u, oa = (w[3] >> 3) & 255u;
+        uint32_t osel = (w[3] >> 2) & 1u;
+        /* Only what the instruction uses: vkd3d's compile time grows with
+         * the text, not just with what survives. */
+        int need_b = mac == 2u || (mac >= 4u && mac <= 12u);
+        int need_c = mac == 3u || mac == 4u || ilu != 0u;
+        int mac_w = mac != 0u && mac != 13u && mm != 0u && td < 13u && !(ilu != 0u && td == 1u);
+        int ilu_w = ilu != 0u && im != 0u && (mac ? 1u : td) < 13u;
+        /* Outputs vs_prog returns: oPos (R12), oD0, oD1, oFog, oT0-oT3. */
+        int out_w = om != 0u && ((w[3] >> 11) & 1u) && (osel ? ilu : mac) != 0u && oa < 13u &&
+                    (oa == 0u || (oa >= 3u && oa <= 5u) || oa >= 9u);
+        if (!mac_w && !ilu_w && !out_w && mac != 13u) continue;   /* writes nothing */
+        vt(&t, "  {");
+        if (mac != 0u) {
+            vt(&t, " float4 A = ");
+            vs_operand(&t, w[1] & 255u, (w[1] >> 8) & 1u, (w[2] >> 26) & 3u, (w[2] >> 28) & 15u, vi, ci, rel);
+            vt(&t, ";");
+        }
+        if (need_b) {
+            vt(&t, " float4 B = ");
+            vs_operand(&t, (w[2] >> 17) & 255u, (w[2] >> 25) & 1u, (w[2] >> 11) & 3u, (w[2] >> 13) & 15u,
+                       vi, ci, rel);
+            vt(&t, ";");
+        }
+        if (need_c) {
+            vt(&t, " float4 Cc = ");
+            vs_operand(&t, (w[2] >> 2) & 255u, (w[2] >> 10) & 1u, (w[3] >> 28) & 3u,
+                       ((w[2] & 3u) << 2) | (w[3] >> 30), vi, ci, rel);
+            vt(&t, ";");
+        }
+        if (mac != 0u && mac != 13u && (mac_w || (out_w && !osel))) {
+        vt(&t, "\n    float4 mr = ");
+        switch (mac) {
+        case 0: vt(&t, "float4(0, 0, 0, 0)"); break;
+        case 2: vt(&t, "A * B"); break;
+        case 3: vt(&t, "A + Cc"); break;
+        case 4: vt(&t, "A * B + Cc"); break;
+        case 5: vt(&t, "dot(A.xyz, B.xyz).xxxx"); break;
+        case 6: vt(&t, "(dot(A.xyz, B.xyz) + B.w).xxxx"); break;
+        case 7: vt(&t, "dot(A, B).xxxx"); break;
+        case 8: vt(&t, "float4(1.0, A.y * B.y, A.z, B.w)"); break;
+        case 9: vt(&t, "A < B ? A : B"); break;
+        case 10: vt(&t, "A >= B ? A : B"); break;
+        case 11: vt(&t, "A < B ? 1.0 : 0.0"); break;
+        case 12: vt(&t, "A >= B ? 1.0 : 0.0"); break;
+        default: vt(&t, "A"); break;
+        }
+        vt(&t, ";");
+        }
+        if (ilu != 0u && (ilu_w || (out_w && osel))) {
+        vt(&t, "\n    float x = Cc.x; float4 ir = ");
+        switch (ilu) {
+        case 0: vt(&t, "float4(0, 0, 0, 0)"); break;
+        case 2: vt(&t, "(x == 0.0 ? asfloat(0x7F800000u) : 1.0 / x).xxxx"); break;
+        case 3: vt(&t, "0; { float f = 1.0 / x; float af = clamp(abs(f), 5.42101e-20, 1.884467e19);"
+                       " ir = (f < 0 ? -af : af).xxxx; }"); break;
+        case 4: vt(&t, "(1.0 / sqrt(abs(x))).xxxx"); break;
+        case 5: vt(&t, "0; { float fl = floor(x); ir = float4(exp2(fl), x - fl, exp2(x), 1.0); }"); break;
+        case 6: vt(&t, "0; { float ax = abs(x);\n"
+                       "      if (ax == 0.0) ir = float4(-asfloat(0x7F800000u), 1.0, -asfloat(0x7F800000u), 1.0);\n"
+                       "      else { float e = floor(log2(ax)); ir = float4(e, ax / exp2(e), log2(ax), 1.0); } }");
+                break;
+        case 7: vt(&t, "0; { float nl = max(x, 0.0), nh = max(Cc.y, 0.0), p = clamp(Cc.w, -127.9961, 127.9961);\n"
+                       "      ir = float4(1.0, nl, x > 0.0 ? (p == 0.0 ? 1.0 : pow(nh, p)) : 0.0, 1.0); }");
+                break;
+        default: vt(&t, "Cc"); break;
+        }
+        vt(&t, ";");
+        }
+        vt(&t, "\n");
+        /* MAC 13 (ARL) runs the MAC: an output it selects takes A. */
+        if (mac == 13u && out_w && !osel) vt(&t, "    float4 mr = A;\n");
+        if (mac == 13u) vt(&t, "    a0 = (int)floor(A.x + 0.001);\n");
+        /* As ub_vs (and xemu): paired with an ILU op the MAC cannot write
+         * R1, and an output comes only from a unit that ran. */
+        if (mac_w)
+            vt(&t, "    R%u.%s = mr.%s;\n", td, vs_mask(mm), vs_mask(mm));
+        if (ilu_w)
+            vt(&t, "    R%u.%s = ir.%s;\n", mac ? 1u : td, vs_mask(im), vs_mask(im));
+        if (out_w) {
+            const char *ov = osel ? "ir" : "mr";
+            if (oa == 0u) vt(&t, "    R12.%s = %s.%s;\n", vs_mask(om), ov, vs_mask(om));
+            else vt(&t, "    O%u.%s = %s.%s;\n", oa, vs_mask(om), ov, vs_mask(om));
+        }
+        vt(&t, "  }\n");
+    }
+    vt(&t, "  P = R12; d0 = O3; d1 = O4; fog = ub_fog(O5.x);\n"
+           "  t0 = O9; t1 = O10; t2 = O11; t3 = O12;\n}\n");
+    return t.len < t.cap ? t.len : 0;
+}
