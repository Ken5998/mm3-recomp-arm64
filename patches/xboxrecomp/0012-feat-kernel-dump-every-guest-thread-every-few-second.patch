diff --git a/tests/thread_dump_posix/test_main.c b/tests/thread_dump_posix/test_main.c
new file mode 100644
index 0000000..f09c595
--- /dev/null
+++ b/tests/thread_dump_posix/test_main.c
@@ -0,0 +1,245 @@
+/*
+ * RECOMP_THREAD_DUMP_SECS: every guest thread, every n seconds.
+ *
+ * Three guest threads, each standing where a hung title's threads stand: the
+ * entry thread in a host wait, a worker inside a kernel call (a 2.5 s
+ * KeDelayExecutionThread), and a worker spinning in code that makes no calls.
+ * The first dump has to name each one -- registers, the kernel call and its
+ * guest caller, the return sites on its guest stack, and for the spinning
+ * one the host pc inside this executable, which is the only clue such a
+ * thread leaves. Once the sleeping worker has left, a later dump must no
+ * longer list it: its registers live in thread-local storage that is gone.
+ */
+#include "kernel.h"
+#include "xbox_memory_layout.h"   /* RECOMP_TLS */
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+typedef void (*recomp_func_t)(void);
+recomp_func_t recomp_lookup(uint32_t xbox_va);
+recomp_func_t recomp_lookup(uint32_t xbox_va) { (void)xbox_va; return NULL; }
+recomp_func_t recomp_lookup_manual(uint32_t xbox_va);
+recomp_func_t recomp_lookup_manual(uint32_t xbox_va) { (void)xbox_va; return NULL; }
+
+extern recomp_func_t recomp_lookup_kernel(uint32_t xbox_va);
+extern RECOMP_TLS uint32_t g_eax, g_ebx, g_esp;
+extern ptrdiff_t g_xbox_mem_offset;
+extern uint32_t g_xbox_code_lo, g_xbox_code_hi;
+void guest_cpu_join(void);
+void guest_cpu_part(void);
+
+enum {
+    THUNK_VA    = 0x00010000,
+    MAIN_SP     = 0x00020000,
+    SLEEPER_SP  = 0x00030000,
+    SPINNER_SP  = 0x00040000,
+    INTERVAL_VA = 0x00200000,
+};
+
+static uint8_t *mem;
+static volatile int stop_spinning;
+static int failures;
+
+static void check(int ok, const char *what)
+{
+    printf("  %-58s %s\n", what, ok ? "PASS" : "FAIL");
+    if (!ok) failures++;
+}
+
+static uint32_t *guest(uint32_t va) { return (uint32_t *)(mem + va); }
+
+/* The dump's signal ends a plain sleep early; finish it. */
+static void sleep_ms(long ms)
+{
+    struct timespec left = { ms / 1000, (ms % 1000) * 1000000L };
+    while (nanosleep(&left, &left) != 0 && errno == EINTR)
+        ;
+}
+
+static void *sleeper(void *unused)
+{
+    (void)unused;
+    guest_cpu_join();
+    /* KeDelayExecutionThread(KernelMode, FALSE, &interval), called from a
+     * guest site at 0x00034000 by a function that 0x00056780 called. */
+    guest(SLEEPER_SP)[0] = 0x00034000u;      /* return address of the call */
+    guest(SLEEPER_SP)[1] = 0;
+    guest(SLEEPER_SP)[2] = 0;
+    guest(SLEEPER_SP)[3] = INTERVAL_VA;
+    guest(SLEEPER_SP)[4] = 0x00056780u;      /* the caller's own return site */
+    *(int64_t *)(mem + INTERVAL_VA) = -25000000;  /* 2.5 s, relative */
+    g_esp = SLEEPER_SP;
+    g_eax = 0x11111111u;
+    g_ebx = 0x22222222u;
+    recomp_lookup_kernel(*guest(THUNK_VA))();
+    guest_cpu_part();
+    return NULL;
+}
+
+static void *spinner(void *unused)
+{
+    volatile unsigned long n = 0;
+
+    (void)unused;
+    guest_cpu_join();
+    guest(SPINNER_SP)[0] = 0x00078900u;
+    g_esp = SPINNER_SP;
+    g_eax = 0x33333333u;
+    while (!stop_spinning)
+        n++;
+    guest_cpu_part();
+    return NULL;
+}
+
+/* The lines of the last dump in the log, or of dump `which`. */
+static char *dump_block(const char *log, int which)
+{
+    char header[32];
+    const char *start = NULL, *p;
+    char *block;
+    size_t len;
+
+    if (which > 0) {
+        snprintf(header, sizeof header, "[THREADS] dump %d ", which);
+        start = strstr(log, header);
+    } else {
+        for (p = log; (p = strstr(p, "[THREADS] dump ")) != NULL; p++)
+            start = p;
+    }
+    if (!start)
+        return NULL;
+    p = strstr(start + 1, "[THREADS] dump ");
+    len = p ? (size_t)(p - start) : strlen(start);
+    block = malloc(len + 1);
+    memcpy(block, start, len);
+    block[len] = 0;
+    return block;
+}
+
+static char *read_log(const char *path)
+{
+    FILE *f = fopen(path, "rb");
+    char *text = calloc(1, 1 << 20);
+    if (f) {
+        fread(text, 1, (1 << 20) - 1, f);
+        fclose(f);
+    }
+    return text;
+}
+
+static int count(const char *text, const char *needle)
+{
+    int n = 0;
+    for (; (text = strstr(text, needle)) != NULL; text++)
+        n++;
+    return n;
+}
+
+/* The thread line that mentions `marker` (a register value). */
+static int line_has(const char *block, const char *marker, const char *what)
+{
+    const char *line = strstr(block, marker);
+    const char *end;
+    if (!line)
+        return 0;
+    while (line > block && line[-1] != '\n')
+        line--;
+    end = strchr(line, '\n');
+    end = end ? strchr(end + 1, '\n') : NULL;   /* and its stack line */
+    {
+        size_t len = end ? (size_t)(end - line) : strlen(line);
+        char *copy = malloc(len + 1);
+        int found;
+        memcpy(copy, line, len);
+        copy[len] = 0;
+        found = strstr(copy, what) != NULL;
+        free(copy);
+        return found;
+    }
+}
+
+int main(void)
+{
+    char path[] = "/tmp/thread_dump_XXXXXX";
+    pthread_t sleeping, spinning;
+    char *log, *first, *last;
+    int fd = mkstemp(path);
+
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (fd < 0 || !freopen(path, "w", stderr)) {
+        printf("cannot capture stderr\n");
+        return 1;
+    }
+    close(fd);
+
+    mem = VirtualAlloc(NULL, 16 * 1024 * 1024, MEM_RESERVE | MEM_COMMIT,
+                       PAGE_READWRITE);
+    if (!mem) {
+        printf("no guest memory stand-in\n");
+        return 1;
+    }
+    g_xbox_mem_offset = (ptrdiff_t)mem;
+    g_xbox_code_lo = 0x00012000u;
+    g_xbox_code_hi = 0x00100000u;
+
+    setenv("RECOMP_THREAD_DUMP_SECS", "1", 1);
+    *guest(THUNK_VA) = 0x80000000u | 99u;   /* KeDelayExecutionThread */
+    xbox_kernel_set_thunk_address(THUNK_VA, 1);
+    xbox_kernel_bridge_init();              /* this thread joins here */
+
+    guest(MAIN_SP)[0] = 0x00001234u;        /* data, not a return site */
+    guest(MAIN_SP)[1] = 0x00045678u;
+    g_esp = MAIN_SP;
+    g_eax = 0x44444444u;
+
+    pthread_create(&sleeping, NULL, sleeper, NULL);
+    pthread_create(&spinning, NULL, spinner, NULL);
+    sleep_ms(1600);                         /* dump 1 lands at about 1 s */
+
+    log = read_log(path);
+    first = dump_block(log, 1);
+    check(first != NULL, "a dump is written after RECOMP_THREAD_DUMP_SECS");
+    if (first) {
+        check(count(first, "[THREADS] t") == 3, "it lists the three guest threads");
+        check(line_has(first, "eax=11111111", "ebx=22222222"),
+              "the sleeper's own registers, not the dumper's");
+        check(line_has(first, "eax=11111111", "in kernel ordinal 99 from 00034000"),
+              "the sleeper is in KeDelayExecutionThread, called from 00034000");
+        check(line_has(first, "eax=11111111", "guest stack: 00056780"),
+              "the sleeper's stack names its caller's return site");
+        check(line_has(first, "eax=33333333", "in guest code"),
+              "the spinner is in guest code");
+        check(line_has(first, "eax=33333333", "pc=+0x"),
+              "the spinner's host pc is inside the executable");
+        check(line_has(first, "eax=44444444", "guest stack: 00045678") &&
+              !line_has(first, "eax=44444444", "00001234"),
+              "the entry thread's stack skips what is not code");
+        free(first);
+    }
+    free(log);
+
+    pthread_join(sleeping, NULL);
+    sleep_ms(1200);                         /* at least one dump after it left */
+    stop_spinning = 1;
+    pthread_join(spinning, NULL);
+
+    log = read_log(path);
+    last = dump_block(log, 0);
+    check(last != NULL && count(last, "[THREADS] t") == 2 &&
+          !strstr(last, "eax=11111111"),
+          "a thread that left is no longer dumped");
+    if (failures)
+        printf("\nThe captured log:\n%s", log);
+    free(last);
+    free(log);
+    unlink(path);
+
+    printf("\n%d failure(s)\n", failures);
+    return failures ? 1 : 0;
+}
