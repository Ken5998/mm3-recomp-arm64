diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
index a200174..e9dc43d 100644
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -43,6 +43,12 @@
 #include <string.h>
 #include <ctype.h>
 #include <wctype.h>
+#if !defined(_WIN32)
+/* The thread dump samples each guest thread's host pc with a signal. */
+#include <pthread.h>
+#include <signal.h>
+#include <ucontext.h>
+#endif
 
 /* Access to recompiled code registers. Per-thread: RECOMP_TLS comes from
  * xbox_memory_layout.h and must match the definitions there -- a plain extern
@@ -1984,6 +1990,7 @@ static void bridge_PsTerminateSystemThread(void)
          * to do it. */
         xbox_FreeThreadStack(g_thread_stack_top);
         g_thread_stack_top = 0;
+        guest_cpu_part();
         ExitThread(exit_status);
     }
 }
@@ -9423,6 +9430,230 @@ static RECOMP_TLS int g_kernel_dispatch_slot = -1;
 
 static void kernel_thunk_dispatch_body(void);
 
+/* Every thread that runs guest code, for RECOMP_THREAD_DUMP_SECS=<n>.
+ *
+ * A title that stops on a loading screen leaves a log that simply ends. The
+ * watchdog samples one thread, the one that started the title, and a title
+ * whose entry hands the game to a worker (MM3) has that one parked in a host
+ * wait by then. So each guest thread registers here from guest_cpu_join to
+ * guest_cpu_part and keeps the kernel call it is in up to date, and every n
+ * seconds a dump walks all of them: guest registers, the kernel call and its
+ * guest caller, the return sites on the guest stack and, on POSIX, the host
+ * pc, which names the lifted function a thread spins in when it makes no
+ * kernel calls at all. Off unless set, as it costs a store per kernel call. */
+#define GUEST_THREAD_SLOTS 64
+
+typedef struct {
+    int           used;
+    unsigned long tid;
+    uint32_t     *esp, *regs[6];
+    uint32_t      stack_top;
+    volatile int      ordinal;       /* kernel call in progress, or -1 */
+    volatile uint32_t caller, arg0, arg1;
+#if !defined(_WIN32)
+    pthread_t          self;
+    volatile uintptr_t pc, lr;
+    volatile int       sampled;
+#endif
+} GuestThreadSlot;
+
+static GuestThreadSlot g_guest_threads[GUEST_THREAD_SLOTS];
+static CRITICAL_SECTION g_guest_threads_lock;
+static unsigned g_thread_dump_secs;
+static RECOMP_TLS GuestThreadSlot *t_guest_slot;
+static volatile DWORD g_guest_cpu_owner;  /* who holds the guest CPU lock */
+
+#if !defined(_WIN32)
+extern char __executable_start[], etext[];
+
+/* Where this thread is on the host, asked by the dump with SIGUSR2. */
+static void guest_thread_sample(int sig, siginfo_t *si, void *uctx)
+{
+    GuestThreadSlot *s = t_guest_slot;
+    const ucontext_t *uc = (const ucontext_t *)uctx;
+
+    (void)sig; (void)si;
+    if (!s)
+        return;
+#if defined(__aarch64__)
+    s->pc = (uintptr_t)uc->uc_mcontext.pc;
+    s->lr = (uintptr_t)uc->uc_mcontext.regs[30];
+#elif defined(__x86_64__) && defined(REG_RIP)
+    s->pc = (uintptr_t)uc->uc_mcontext.gregs[REG_RIP];
+#else
+    (void)uc;
+#endif
+    s->sampled = 1;
+}
+
+/* A host code address, as an offset into the executable when it is one. */
+static void guest_thread_print_pc(const char *name, uintptr_t pc)
+{
+    if (pc >= (uintptr_t)__executable_start && pc < (uintptr_t)etext)
+        fprintf(stderr, " %s=+0x%lx", name,
+                (unsigned long)(pc - (uintptr_t)__executable_start));
+    else if (pc)
+        fprintf(stderr, " %s=%p", name, (void *)pc);
+}
+#endif
+
+static void guest_threads_dump(unsigned seq)
+{
+    const uint8_t *mem = (const uint8_t *)g_xbox_mem_offset;
+    extern volatile uint64_t g_icall_count;
+    int i;
+
+    EnterCriticalSection(&g_guest_threads_lock);
+#if !defined(_WIN32)
+    for (i = 0; i < GUEST_THREAD_SLOTS; i++) {
+        GuestThreadSlot *s = &g_guest_threads[i];
+        if (s->used) {
+            s->sampled = 0;
+            s->pc = s->lr = 0;
+            pthread_kill(s->self, SIGUSR2);
+        }
+    }
+    {   /* a thread answers on its next instruction; 100 ms covers a busy host */
+        int waited, pending = 1;
+        for (waited = 0; waited < 100 && pending; waited++) {
+            Sleep(1);
+            pending = 0;
+            for (i = 0; i < GUEST_THREAD_SLOTS; i++)
+                if (g_guest_threads[i].used && !g_guest_threads[i].sampled)
+                    pending = 1;
+        }
+    }
+#endif
+    fprintf(stderr, "[THREADS] dump %u after %us: %lld kernel calls, %llu indirect calls",
+            seq, seq * g_thread_dump_secs, g_kernel_call_count,
+            (unsigned long long)g_icall_count);
+    if (g_guest_cpu_owner)
+        fprintf(stderr, ", guest CPU held by t%lu", (unsigned long)g_guest_cpu_owner);
+    fprintf(stderr, "\n");
+    for (i = 0; i < GUEST_THREAD_SLOTS; i++) {
+        GuestThreadSlot *s = &g_guest_threads[i];
+        uint32_t sp, top, a;
+        int shown = 0;
+
+        if (!s->used)
+            continue;
+        sp = *s->esp;
+        fprintf(stderr, "[THREADS] t%lu esp=%08X eax=%08X ecx=%08X edx=%08X"
+                        " ebx=%08X esi=%08X edi=%08X",
+                s->tid, sp, *s->regs[0], *s->regs[1], *s->regs[2],
+                *s->regs[3], *s->regs[4], *s->regs[5]);
+        if (s->ordinal >= 0)
+            fprintf(stderr, " in kernel ordinal %d from %08X (args %08X %08X)",
+                    s->ordinal, s->caller, s->arg0, s->arg1);
+        else
+            fprintf(stderr, " in guest code");
+#if !defined(_WIN32)
+        if (s->sampled) {
+            fprintf(stderr, ", host");
+            guest_thread_print_pc("pc", s->pc);
+            guest_thread_print_pc("lr", s->lr);
+        }
+#endif
+        fprintf(stderr, "\n[THREADS]   guest stack:");
+        /* Lifted calls push their guest return address, so the words in the
+         * code range are the call chain, give or take a stale one. */
+        top = s->stack_top ? s->stack_top : sp + 0x4000;
+        for (a = sp; sp && a < top && a < XBOX_TOTAL_RAM && shown < 24; a += 4) {
+            uint32_t word = *(const uint32_t *)(mem + a);
+            if (word >= g_xbox_code_lo && word < g_xbox_code_hi) {
+                fprintf(stderr, " %08X", word);
+                shown++;
+            }
+        }
+        fprintf(stderr, "\n");
+    }
+    fflush(stderr);
+    LeaveCriticalSection(&g_guest_threads_lock);
+}
+
+static DWORD WINAPI guest_threads_dump_thread(LPVOID unused)
+{
+    unsigned seq;
+
+    (void)unused;
+    for (seq = 1; ; seq++) {
+        Sleep(g_thread_dump_secs * 1000u);
+        guest_threads_dump(seq);
+    }
+    return 0;
+}
+
+static int guest_thread_dump_enabled(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *e = getenv("RECOMP_THREAD_DUMP_SECS");
+        g_thread_dump_secs = e ? (unsigned)atoi(e) : 0u;
+        on = g_thread_dump_secs > 0;
+        if (on) {
+            HANDLE h;
+#if !defined(_WIN32)
+            struct sigaction sa;
+            memset(&sa, 0, sizeof sa);
+            sa.sa_sigaction = guest_thread_sample;
+            sa.sa_flags = SA_SIGINFO | SA_RESTART;
+            sigemptyset(&sa.sa_mask);
+            sigaction(SIGUSR2, &sa, NULL);
+#endif
+            InitializeCriticalSection(&g_guest_threads_lock);
+            h = CreateThread(NULL, 0, guest_threads_dump_thread, NULL, 0, NULL);
+            if (h)
+                CloseHandle(h);
+            fprintf(stderr, "  [KERNEL] guest threads dumped every %us\n",
+                    g_thread_dump_secs);
+        }
+    }
+    return on;
+}
+
+/* First called from xbox_kernel_bridge_init, before any other guest thread
+ * exists, so the lazy setup above runs on one thread. */
+static void guest_thread_register(void)
+{
+    int i;
+
+    if (t_guest_slot || !guest_thread_dump_enabled())
+        return;
+    EnterCriticalSection(&g_guest_threads_lock);
+    for (i = 0; i < GUEST_THREAD_SLOTS; i++) {
+        GuestThreadSlot *s = &g_guest_threads[i];
+        if (s->used)
+            continue;
+        memset(s, 0, sizeof *s);
+        s->tid = GetCurrentThreadId();
+        s->esp = &g_esp;
+        s->regs[0] = &g_eax; s->regs[1] = &g_ecx; s->regs[2] = &g_edx;
+        s->regs[3] = &g_ebx; s->regs[4] = &g_esi; s->regs[5] = &g_edi;
+        s->stack_top = g_thread_stack_top;
+        s->ordinal = -1;
+#if !defined(_WIN32)
+        s->self = pthread_self();
+#endif
+        s->used = 1;
+        t_guest_slot = s;
+        break;
+    }
+    LeaveCriticalSection(&g_guest_threads_lock);
+}
+
+static void guest_thread_unregister(void)
+{
+    GuestThreadSlot *s = t_guest_slot;
+
+    if (!s)
+        return;
+    EnterCriticalSection(&g_guest_threads_lock);
+    s->used = 0;
+    t_guest_slot = NULL;
+    LeaveCriticalSection(&g_guest_threads_lock);
+}
+
 /* The guest CPU lock (RECOMP_GUEST_LOCK=1).
  *
  * The Xbox has one CPU: two guest threads never run guest code at the same
@@ -9464,19 +9695,25 @@ static int guest_cpu_enabled(void)
 void guest_cpu_join(void)
 {
     t_guest_thread = 1;
+    guest_thread_register();
     if (guest_cpu_enabled() && !t_guest_held) {
         EnterCriticalSection(&g_guest_cpu);
         t_guest_held = 1;
+        g_guest_cpu_owner = GetCurrentThreadId();
     }
 }
 
+/* Called when a host thread stops running guest code: its guest thread
+ * ended, or (the title's entry thread) it handed the game to a worker. */
 void guest_cpu_part(void)
 {
     if (t_guest_held) {
         t_guest_held = 0;
+        g_guest_cpu_owner = 0;
         LeaveCriticalSection(&g_guest_cpu);
     }
     t_guest_thread = 0;
+    guest_thread_unregister();
 }
 
 /* A guest thread lets go of the guest CPU for the length of every kernel
@@ -9486,6 +9723,7 @@ static void kernel_thunk_dispatch(void)
     int held = t_guest_held;
     if (held) {                        /* let other guest threads run meanwhile */
         t_guest_held = 0;
+        g_guest_cpu_owner = 0;
         LeaveCriticalSection(&g_guest_cpu);
     }
     t_dispatch_depth++;
@@ -9497,6 +9735,7 @@ static void kernel_thunk_dispatch(void)
     if (t_guest_thread && t_dispatch_depth == 0 && guest_cpu_enabled()) {
         EnterCriticalSection(&g_guest_cpu);
         t_guest_held = 1;
+        g_guest_cpu_owner = GetCurrentThreadId();
     }
     (void)held;
 }
@@ -9580,6 +9819,22 @@ static void kernel_thunk_dispatch_body(void)
     g_xbox_kernel_caller = g_esp ? BRIDGE_MEM32(g_esp) : 0;
     g_esp += 4;
 
+    /* What this thread is in, for the thread dump. Kept as a stack: an APC a
+     * wait runs makes kernel calls of its own. */
+    GuestThreadSlot *self = t_guest_slot;
+    int saved_ordinal = -1;
+    uint32_t saved_caller = 0, saved_arg0 = 0, saved_arg1 = 0;
+    if (self) {
+        saved_ordinal = self->ordinal;
+        saved_caller = self->caller;
+        saved_arg0 = self->arg0;
+        saved_arg1 = self->arg1;
+        self->caller = g_xbox_kernel_caller;
+        self->arg0 = STACK_ARG(0);
+        self->arg1 = STACK_ARG(1);
+        self->ordinal = (int)ordinal;
+    }
+
     /* Name the bridge that corrupts a watched dword.
      *
      * A bridge hands Xbox pointers to real Win32 calls, so a bad one has
@@ -9646,6 +9901,13 @@ static void kernel_thunk_dispatch_body(void)
      * above; now pop the args. */
     g_esp += g_slot_arg_bytes[slot];
 
+    if (self) {
+        self->caller = saved_caller;
+        self->arg0 = saved_arg0;
+        self->arg1 = saved_arg1;
+        self->ordinal = saved_ordinal;
+    }
+
     if (g_kernel_watch_va) {
         uint32_t _after = BRIDGE_MEM32(g_kernel_watch_va);
         if (_after != _watch_before) {
diff --git a/tests/thread_dump_posix/CMakeLists.txt b/tests/thread_dump_posix/CMakeLists.txt
new file mode 100644
index 0000000..ef7455b
--- /dev/null
