From 26e909901d34d4f969bdabeb3210105720c4ba53 Mon Sep 17 00:00:00 2001
From: Ken5998 <46025606+Ken5998@users.noreply.github.com>
Date: Wed, 14 Oct 2026 02:49:32 +0000
Subject: [PATCH 06/27] feat(video): share the window's scancode to virtual key
 table

A settings screen that binds keys before the game window exists can read SDL's keyboard in the same virtual keys RECOMP_KEYMAP uses: the table moves to sdl_keys.c.
---
 src/video/CMakeLists.txt |  1 +
 src/video/fb_present.c   | 58 ++--------------------------------------
 src/video/sdl_keys.c     | 58 ++++++++++++++++++++++++++++++++++++++++
 src/video/sdl_keys.h     | 21 +++++++++++++++
 4 files changed, 82 insertions(+), 56 deletions(-)
 create mode 100644 src/video/sdl_keys.c
 create mode 100644 src/video/sdl_keys.h

diff --git a/src/video/CMakeLists.txt b/src/video/CMakeLists.txt
index eee2bdc..430f3bc 100644
--- a/src/video/CMakeLists.txt
+++ b/src/video/CMakeLists.txt
@@ -32,6 +32,7 @@ else()
         find_package(SDL2)
         if(DXVK_FOUND AND VKD3D_UTILS_FOUND AND SDL2_FOUND)
             target_compile_definitions(xbox_video PUBLIC XBOXRECOMP_DXVK)
+            target_sources(xbox_video PRIVATE sdl_keys.c)
             target_link_libraries(xbox_video PUBLIC
                 PkgConfig::DXVK PkgConfig::VKD3D_UTILS SDL2::SDL2 platform)
             message(STATUS "xbox_video: D3D11 renderer on DXVK-native ${DXVK_dxvk-d3d11_VERSION}")
