 #endif
 #include <stdio.h>
 #include "platform/recomp_profile.h"
@@ -629,61 +630,6 @@ static void fb_toggle_fullscreen(SDL_Window *win)
     SDL_ShowCursor(full ? SDL_ENABLE : SDL_DISABLE);
 }
 
