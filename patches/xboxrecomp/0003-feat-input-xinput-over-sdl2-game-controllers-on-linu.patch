diff --git a/src/input/xinput_sdl.c b/src/input/xinput_sdl.c
new file mode 100644
index 0000000..f07a464
--- /dev/null
+++ b/src/input/xinput_sdl.c
@@ -0,0 +1,168 @@
+/**
+ * XInput over SDL2 game controllers. See xinput_sdl.h.
+ */
+#include "xinput_sdl.h"
+
+#include <SDL.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+
+#define PORTS 4
+
+static SDL_GameController *s_pad[PORTS];
+static XINPUT_STATE s_last[PORTS];
+static XINPUT_VIBRATION s_rumble[PORTS];
+static Uint32 s_rumble_at[PORTS];
+/* The USB pad model and the title's own XInput calls may poll from
+ * different threads; the ports and their last states are shared. */
+static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* Drop pads that went away and give new ones the first free port. Cheap
+ * enough to run on every poll that finds its port empty, but rate-limited
+ * anyway: enumerating opens device nodes. */
+static void rescan(void)
+{
+    static Uint32 last;
+    Uint32 now = SDL_GetTicks();
+    int i, p;
+    if (last && now - last < 500)
+        return;
+    last = now;
+    for (p = 0; p < PORTS; p++)
+        if (s_pad[p] && !SDL_GameControllerGetAttached(s_pad[p])) {
+            SDL_GameControllerClose(s_pad[p]);
+            s_pad[p] = NULL;
+        }
+    for (i = 0; i < SDL_NumJoysticks(); i++) {
+        SDL_JoystickID id = SDL_JoystickGetDeviceInstanceID(i);
+        int taken = 0;
+        if (!SDL_IsGameController(i))
+            continue;
+        for (p = 0; p < PORTS; p++)
+            if (s_pad[p] && SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(s_pad[p])) == id)
+                taken = 1;
+        if (taken)
+            continue;
+        for (p = 0; p < PORTS && s_pad[p]; p++) {}
+        if (p == PORTS)
+            break;
+        if ((s_pad[p] = SDL_GameControllerOpen(i)) != NULL)
+            fprintf(stderr, "[INPUT] port %d: %s\n", p, SDL_GameControllerName(s_pad[p]));
+    }
+}
+
+/* Called with s_lock held. */
+static SDL_GameController *pad(DWORD port)
+{
+    static int init;
+    if (!init) {
+        init = 1;
+        if (!SDL_WasInit(SDL_INIT_GAMECONTROLLER))
+            SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER);
+    }
+    SDL_GameControllerUpdate();
+    if (!s_pad[port] || !SDL_GameControllerGetAttached(s_pad[port]))
+        rescan();
+    return s_pad[port] && SDL_GameControllerGetAttached(s_pad[port]) ? s_pad[port] : NULL;
+}
+
+static WORD buttons(SDL_GameController *c)
+{
+    static const struct { SDL_GameControllerButton b; WORD bit; } map[] = {
+        { SDL_CONTROLLER_BUTTON_DPAD_UP, XINPUT_GAMEPAD_DPAD_UP },
+        { SDL_CONTROLLER_BUTTON_DPAD_DOWN, XINPUT_GAMEPAD_DPAD_DOWN },
+        { SDL_CONTROLLER_BUTTON_DPAD_LEFT, XINPUT_GAMEPAD_DPAD_LEFT },
+        { SDL_CONTROLLER_BUTTON_DPAD_RIGHT, XINPUT_GAMEPAD_DPAD_RIGHT },
+        { SDL_CONTROLLER_BUTTON_START, XINPUT_GAMEPAD_START },
+        { SDL_CONTROLLER_BUTTON_BACK, XINPUT_GAMEPAD_BACK },
+        { SDL_CONTROLLER_BUTTON_LEFTSTICK, XINPUT_GAMEPAD_LEFT_THUMB },
+        { SDL_CONTROLLER_BUTTON_RIGHTSTICK, XINPUT_GAMEPAD_RIGHT_THUMB },
+        { SDL_CONTROLLER_BUTTON_LEFTSHOULDER, XINPUT_GAMEPAD_LEFT_SHOULDER },
+        { SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, XINPUT_GAMEPAD_RIGHT_SHOULDER },
+        { SDL_CONTROLLER_BUTTON_A, XINPUT_GAMEPAD_A },
+        { SDL_CONTROLLER_BUTTON_B, XINPUT_GAMEPAD_B },
+        { SDL_CONTROLLER_BUTTON_X, XINPUT_GAMEPAD_X },
+        { SDL_CONTROLLER_BUTTON_Y, XINPUT_GAMEPAD_Y },
+    };
+    WORD w = 0;
+    size_t i;
+    for (i = 0; i < sizeof map / sizeof map[0]; i++)
+        if (SDL_GameControllerGetButton(c, map[i].b))
+            w |= map[i].bit;
+    return w;
+}
+
+static void rumble(DWORD port, SDL_GameController *c, const XINPUT_VIBRATION *v)
+{
+    s_rumble[port] = *v;
+    s_rumble_at[port] = SDL_GetTicks();
+    SDL_GameControllerRumble(c, v->wLeftMotorSpeed, v->wRightMotorSpeed, 0xFFFF);
+}
+
+DWORD XInputGetState(DWORD port, XINPUT_STATE *state)
+{
+    SDL_GameController *c;
+    XINPUT_GAMEPAD g;
+    if (port >= PORTS || !state)
+        return ERROR_DEVICE_NOT_CONNECTED;
+    pthread_mutex_lock(&s_lock);
+    if (!(c = pad(port))) {
+        pthread_mutex_unlock(&s_lock);
+        return ERROR_DEVICE_NOT_CONNECTED;
+    }
+    memset(&g, 0, sizeof g);
+    g.wButtons = buttons(c);
+    /* SDL's triggers run 0..32767, XInput's 0..255. */
+    g.bLeftTrigger = (BYTE)(SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_TRIGGERLEFT) >> 7);
+    g.bRightTrigger = (BYTE)(SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_TRIGGERRIGHT) >> 7);
+    /* SDL's Y axes point down, XInput's up. */
+    g.sThumbLX = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTX);
+    g.sThumbLY = (SHORT)(-1 - SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTY));
+    g.sThumbRX = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_RIGHTX);
+    g.sThumbRY = (SHORT)(-1 - SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_RIGHTY));
+    /* XInput moves the packet number only when the state changes. */
+    if (memcmp(&g, &s_last[port].Gamepad, sizeof g)) {
+        s_last[port].Gamepad = g;
+        s_last[port].dwPacketNumber++;
+    }
+    /* SDL rumble runs for a set time; keep a held setting going. */
+    if ((s_rumble[port].wLeftMotorSpeed || s_rumble[port].wRightMotorSpeed) &&
+        SDL_GetTicks() - s_rumble_at[port] > 30000)
+        rumble(port, c, &s_rumble[port]);
+    *state = s_last[port];
+    pthread_mutex_unlock(&s_lock);
+    return ERROR_SUCCESS;
+}
+
+DWORD XInputSetState(DWORD port, XINPUT_VIBRATION *vibration)
+{
+    SDL_GameController *c;
+    DWORD r = ERROR_DEVICE_NOT_CONNECTED;
+    if (port >= PORTS || !vibration)
+        return r;
+    pthread_mutex_lock(&s_lock);
+    if ((c = s_pad[port]) != NULL && SDL_GameControllerGetAttached(c)) {
+        rumble(port, c, vibration);
+        r = ERROR_SUCCESS;
+    }
+    pthread_mutex_unlock(&s_lock);
+    return r;
+}
+
+DWORD XInputGetCapabilities(DWORD port, DWORD flags, XINPUT_CAPABILITIES *caps)
+{
+    (void)flags;
+    int connected;
+    if (port >= PORTS || !caps)
+        return ERROR_DEVICE_NOT_CONNECTED;
+    pthread_mutex_lock(&s_lock);
+    connected = pad(port) != NULL;
+    pthread_mutex_unlock(&s_lock);
+    if (!connected)
+        return ERROR_DEVICE_NOT_CONNECTED;
+    memset(caps, 0, sizeof *caps);
+    caps->Type = XINPUT_DEVTYPE_GAMEPAD;
+    caps->SubType = XINPUT_DEVSUBTYPE_GAMEPAD;
+    return ERROR_SUCCESS;
+}
diff --git a/src/input/xinput_sdl.h b/src/input/xinput_sdl.h
new file mode 100644
index 0000000..691240c
--- /dev/null
+++ b/src/input/xinput_sdl.h
@@ -0,0 +1,42 @@
+/**
+ * The slice of Windows XInput that xinput_device.c calls, over SDL2's
+ * GameController API, so the keyboard pad, RECOMP_KEYMAP, RECOMP_PADMAP and
+ * the menu pointer work the same on Linux as on Windows.
+ *
+ * Ports are SDL game controllers in the order they were found; a pad plugged
+ * in later takes the first free port. Steam's virtual pads (and the handheld
+ * controls Steam Input exposes as one) are game controllers like any other.
+ */
+#ifndef XBOXRECOMP_XINPUT_SDL_H
+#define XBOXRECOMP_XINPUT_SDL_H
+
+#include "platform/win32_compat.h"
+
+/* XINPUT_GAMEPAD, XINPUT_STATE and the button bits come from win32_compat.h,
+ * along with a disconnected XInputGetState stub for code that only needs to
+ * link; the backend here goes by its own names, mapped onto XInput's below. */
+#define XINPUT_DEVTYPE_GAMEPAD          0x01
+#define XINPUT_DEVSUBTYPE_GAMEPAD       0x01
+
+typedef struct {
+    WORD wLeftMotorSpeed;
+    WORD wRightMotorSpeed;
+} XINPUT_VIBRATION;
+
+typedef struct {
+    BYTE             Type;
+    BYTE             SubType;
+    WORD             Flags;
+    XINPUT_GAMEPAD   Gamepad;
+    XINPUT_VIBRATION Vibration;
+} XINPUT_CAPABILITIES;
+
+DWORD xinput_sdl_get_state(DWORD port, XINPUT_STATE *state);
+DWORD xinput_sdl_set_state(DWORD port, XINPUT_VIBRATION *vibration);
+DWORD xinput_sdl_get_capabilities(DWORD port, DWORD flags, XINPUT_CAPABILITIES *caps);
+
+#define XInputGetState        xinput_sdl_get_state
+#define XInputSetState        xinput_sdl_set_state
+#define XInputGetCapabilities xinput_sdl_get_capabilities
+
+#endif
