     pthread_mutex_lock(&o->lock);
     o->signaled = 1;
@@ -637,7 +752,7 @@ HANDLE CreateSemaphoreW(LPSECURITY_ATTRIBUTES sa, LONG initial, LONG maximum, LP
 
