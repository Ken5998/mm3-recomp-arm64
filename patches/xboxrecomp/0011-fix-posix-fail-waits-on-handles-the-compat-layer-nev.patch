From 1d1b1386ed18b196a99daa64cd1254f3b92df0e7 Mon Sep 17 00:00:00 2001
From: Ken5998 <46025606+Ken5998@users.noreply.github.com>
Date: Wed, 14 Oct 2026 17:04:29 +0000
Subject: [PATCH 11/29] fix(posix): fail waits on handles the compat layer
 never made

On POSIX a HANDLE is the address of its object, so a value that is not one
of ours was dereferenced. The kernel bridge passes untagged guest values
through as handles: Midtown Madness 3's D3D waits with KeWaitForSingleObject
on an object in its own data at its first loading screen, and the wait
locked a mutex at that guest address and faulted. Windows answers the same
wait with WAIT_FAILED and ERROR_INVALID_HANDLE, and the title carries on.

Keep a table of the objects this layer made and look every handle up in it:
an unknown one fails the call as on Windows, and a multi-object wait with
one fails whole. tests/win32_handles_posix covers foreign, closed and live
handles.
---
 src/platform/win32_compat.c              | 169 +++++++++++++++++++----
 tests/win32_handles_posix/CMakeLists.txt |  13 ++
 tests/win32_handles_posix/test_main.c    |  94 +++++++++++++
 3 files changed, 249 insertions(+), 27 deletions(-)
 create mode 100644 tests/win32_handles_posix/CMakeLists.txt
 create mode 100644 tests/win32_handles_posix/test_main.c

diff --git a/src/platform/win32_compat.c b/src/platform/win32_compat.c
index a4c00d8..2708fa2 100644
--- a/src/platform/win32_compat.c
+++ b/src/platform/win32_compat.c
@@ -327,6 +327,102 @@ DWORD GetCurrentProcessId(void) { return (DWORD)getpid(); }
 HANDLE GetCurrentThread(void)   { return t_self_obj ? (HANDLE)t_self_obj : PSEUDO_CURRENT_THREAD; }
 HANDLE GetCurrentProcess(void)  { return PSEUDO_CURRENT_PROCESS; }
 
+/* The objects this layer made. Windows answers a HANDLE it never issued with
+ * ERROR_INVALID_HANDLE; here a HANDLE is the object's address, so one this
+ * layer did not make has to be caught before it is dereferenced. The kernel
+ * bridge passes untagged guest values through as handles -- Midtown Madness
+ * 3's D3D waits with KeWaitForSingleObject on an object in its own data at its
+ * first loading screen -- and the wait locked a "mutex" at that guest address
+ * and faulted, where Windows fails the wait and the title carries on. */
+static pthread_mutex_t s_live_lock = PTHREAD_MUTEX_INITIALIZER;
+static uintptr_t *s_live;       /* open addressing: 0 empty, 1 removed */
+static size_t     s_live_cap;   /* a power of two */
+static size_t     s_live_used;  /* slots not empty, removed ones included */
+static size_t     s_live_count;
+
+static size_t live_slot(uintptr_t key)
+{
+    uint64_t x = (uint64_t)key;
+    x ^= x >> 33;
+    x *= 0xff51afd7ed558ccdULL;
+    x ^= x >> 33;
+    return (size_t)x & (s_live_cap - 1);
+}
+
+static void live_put(uintptr_t key)
+{
+    size_t i = live_slot(key);
+    while (s_live[i] > 1)
+        i = (i + 1) & (s_live_cap - 1);
+    if (s_live[i] == 0)
+        s_live_used++;
+    s_live[i] = key;
+}
+
+static void live_add(w32_object *o)
+{
+    pthread_mutex_lock(&s_live_lock);
+    if ((s_live_used + 1) * 2 > s_live_cap) {
+        uintptr_t *old = s_live;
+        size_t old_cap = s_live_cap, cap = 64, i;
+        while (cap < (s_live_count + 1) * 4)
+            cap <<= 1;
+        s_live = (uintptr_t *)calloc(cap, sizeof *s_live);
+        if (!s_live) {
+            fprintf(stderr, "win32_compat: out of memory for the handle table\n");
+            abort();
+        }
+        s_live_cap = cap;
+        s_live_used = 0;
+        for (i = 0; i < old_cap; i++)
+            if (old[i] > 1)
+                live_put(old[i]);
+        free(old);
+    }
+    live_put((uintptr_t)o);
+    s_live_count++;
+    pthread_mutex_unlock(&s_live_lock);
+}
+
+static void live_remove(w32_object *o)
+{
+    pthread_mutex_lock(&s_live_lock);
+    if (s_live_cap) {
+        size_t i = live_slot((uintptr_t)o);
+        while (s_live[i] != 0) {
+            if (s_live[i] == (uintptr_t)o) {
+                s_live[i] = 1;
+                s_live_count--;
+                break;
+            }
+            i = (i + 1) & (s_live_cap - 1);
+        }
+    }
+    pthread_mutex_unlock(&s_live_lock);
+}
+
+/* The object behind h, or NULL with ERROR_INVALID_HANDLE. */
+static w32_object *obj_of(HANDLE h)
+{
+    uintptr_t key = (uintptr_t)h;
+    w32_object *o = NULL;
+    pthread_mutex_lock(&s_live_lock);
+    if (s_live_cap && key > 1) {
+        size_t i = live_slot(key);
+        while (s_live[i] != 0) {
+            if (s_live[i] == key) {
+                o = (w32_object *)h;
+                break;
+            }
+            i = (i + 1) & (s_live_cap - 1);
+        }
+    }
+    pthread_mutex_unlock(&s_live_lock);
+    if (!o)
+        SetLastError(ERROR_INVALID_HANDLE);
+    return o;
+}
+
 static w32_object *obj_alloc(w32_kind kind)
 {
     w32_object *o = (w32_object *)calloc(1, sizeof(w32_object));
@@ -335,6 +431,7 @@ static w32_object *obj_alloc(w32_kind kind)
     pthread_mutex_init(&o->lock, NULL);
     pthread_cond_init(&o->cond, NULL);
     pthread_cond_init(&o->gate, NULL);
+    live_add(o);
     return o;
 }
 
@@ -342,6 +439,7 @@ static void obj_release(w32_object *o)
 {
     if (InterlockedDecrement(&o->refcount) > 0)
         return;
+    live_remove(o);
     if (o->kind == K_FILE) {
         if (o->fd >= 0) close(o->fd);
         free(o->file_path);
@@ -367,13 +465,13 @@ HANDLE w32_open_handle(int fd, const char *host_path)
 
 int w32_handle_fd(HANDLE h)
 {
-    w32_object *o = (w32_object *)h;
+    w32_object *o = obj_of(h);
     return (o && o->kind == K_FILE) ? o->fd : -1;
 }
 
 const char *w32_handle_path(HANDLE h)
 {
-    w32_object *o = (w32_object *)h;
+    w32_object *o = obj_of(h);
     return (o && o->kind == K_FILE) ? o->file_path : NULL;
 }
 
@@ -382,7 +480,10 @@ BOOL CloseHandle(HANDLE h)
     if (!h || h == PSEUDO_CURRENT_THREAD || h == PSEUDO_CURRENT_PROCESS ||
         h == INVALID_HANDLE_VALUE)
         return TRUE;
-    obj_release((w32_object *)h);
+    w32_object *o = obj_of(h);
+    if (!o)
+        return FALSE;
+    obj_release(o);
     return TRUE;
 }
 
@@ -394,7 +495,7 @@ BOOL DuplicateHandle(HANDLE srcProc, HANDLE src, HANDLE dstProc, PHANDLE dst,
     if (src == PSEUDO_CURRENT_THREAD)  src = GetCurrentThread();
     if (src == PSEUDO_CURRENT_PROCESS) { *dst = src; return TRUE; }
     if (src == PSEUDO_CURRENT_THREAD || !src) { *dst = src; return TRUE; }
-    w32_object *o = (w32_object *)src;
+    w32_object *o = obj_of(src);
     InterlockedIncrement(&o->refcount);
     *dst = src;
     if (options & DUPLICATE_CLOSE_SOURCE)
@@ -514,7 +615,8 @@ DWORD WaitForSingleObject(HANDLE h, DWORD ms)
 {
     if (!h || h == PSEUDO_CURRENT_THREAD || h == PSEUDO_CURRENT_PROCESS)
         return WAIT_OBJECT_0;
-    return wait_single((w32_object *)h, ms);
+    w32_object *o = obj_of(h);
+    return o ? wait_single(o, ms) : WAIT_FAILED;
 }
 
 DWORD WaitForSingleObjectEx(HANDLE h, DWORD ms, BOOL alertable)
@@ -540,19 +642,32 @@ DWORD WaitForMultipleObjectsEx(DWORD count, const HANDLE *handles, BOOL waitAll,
     int timed = (ms != INFINITE);
     if (timed) deadline_from_ms(ms, &ts);
 
+    /* Like Windows, one handle that is not an object fails the whole wait,
+     * whatever the others' states. */
+    for (DWORD i = 0; i < count; i++) {
+        HANDLE h = handles[i];
+        if (h && h != PSEUDO_CURRENT_THREAD && h != PSEUDO_CURRENT_PROCESS && !obj_of(h))
+            return WAIT_FAILED;
+    }
+
     for (;;) {
         if (alertable && drain_apcs() > 0)
             return WAIT_IO_COMPLETION;
 
         if (waitAll) {
             DWORD got = 0;
-            for (DWORD i = 0; i < count; i++)
-                if (WaitForSingleObject(handles[i], 0) == WAIT_OBJECT_0) got++;
+            for (DWORD i = 0; i < count; i++) {
+                DWORD r = WaitForSingleObject(handles[i], 0);
+                if (r == WAIT_FAILED) return WAIT_FAILED;
+                if (r == WAIT_OBJECT_0) got++;
+            }
             if (got == count) return WAIT_OBJECT_0;
         } else {
-            for (DWORD i = 0; i < count; i++)
-                if (WaitForSingleObject(handles[i], 0) == WAIT_OBJECT_0)
-                    return WAIT_OBJECT_0 + i;
+            for (DWORD i = 0; i < count; i++) {
+                DWORD r = WaitForSingleObject(handles[i], 0);
+                if (r == WAIT_FAILED) return WAIT_FAILED;
+                if (r == WAIT_OBJECT_0) return WAIT_OBJECT_0 + i;
+            }
         }
 
         if (timed) {
@@ -586,7 +701,7 @@ HANDLE CreateEventW(LPSECURITY_ATTRIBUTES sa, BOOL manualReset, BOOL initialStat
 
 BOOL SetEvent(HANDLE h)
 {
-    w32_object *o = (w32_object *)h;
+    w32_object *o = obj_of(h);
     if (!o || o->kind != K_EVENT) return FALSE;
     pthread_mutex_lock(&o->lock);
     o->signaled = 1;
@@ -597,7 +712,7 @@ BOOL SetEvent(HANDLE h)
 
 BOOL ResetEvent(HANDLE h)
 {
-    w32_object *o = (w32_object *)h;
+    w32_object *o = obj_of(h);
     if (!o || o->kind != K_EVENT) return FALSE;
     pthread_mutex_lock(&o->lock);
