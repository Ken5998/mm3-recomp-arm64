+cmake_minimum_required(VERSION 3.20)
+project(win32_handles_posix_test C)
+# Handles on a POSIX host: win32_compat.c answers a HANDLE it never made the
+# way Windows does, instead of dereferencing it.
+if(WIN32)
+    message(FATAL_ERROR "This regression covers the POSIX handle layer")
+endif()
+set(CMAKE_C_STANDARD 11)
+add_subdirectory(../../src/platform platform)
+add_executable(win32_handles_posix_test test_main.c)
+target_link_libraries(win32_handles_posix_test PRIVATE platform)
+enable_testing()
+add_test(NAME win32_handles_posix_test COMMAND win32_handles_posix_test)
diff --git a/tests/win32_handles_posix/test_main.c b/tests/win32_handles_posix/test_main.c
new file mode 100644
index 0000000..30396fc
--- /dev/null
+++ b/tests/win32_handles_posix/test_main.c
@@ -0,0 +1,94 @@
+/*
+ * win32_handles_posix - a HANDLE win32_compat.c did not make.
+ *
+ * On POSIX a HANDLE is the address of the object behind it, so a value that
+ * is not one of ours used to be dereferenced. The kernel bridge passes untagged
+ * guest values through as handles: Midtown Madness 3's D3D waits with
+ * KeWaitForSingleObject on an object in its own data (0x0035185C) at its first
+ * loading screen, and the wait locked a mutex at that address and faulted. On
+ * Windows the same wait fails with ERROR_INVALID_HANDLE and the title carries
+ * on, which is what is checked here, along with the objects that are ours
+ * still working once the table that tells them apart has grown and shrunk.
+ */
+#include <stdint.h>
+#include <stdio.h>
+
+#include "win32_compat.h"
+
+static int failures;
+#define CHECK(name, cond) \
+    do { if (!(cond)) { printf("FAIL: %s\n", name); failures++; } } while (0)
+
+static DWORD WINAPI worker(LPVOID param)
+{
+    SetEvent((HANDLE)param);
+    return 7;
+}
+
+int main(void)
+{
+    /* An unmapped guest address, and one that is mapped but not an object. */
+    static uint8_t not_an_object[256];
+    HANDLE foreign[] = { (HANDLE)(uintptr_t)0x0035185Cu, (HANDLE)not_an_object };
+    HANDLE ev = CreateEventA(NULL, TRUE, FALSE, NULL);
+    HANDLE many[1000];
+    DWORD code = 0;
+
+    CHECK("event created", ev != NULL);
+    CHECK("unsignalled event times out", WaitForSingleObject(ev, 0) == WAIT_TIMEOUT);
+    CHECK("SetEvent", SetEvent(ev));
+    CHECK("signalled event", WaitForSingleObject(ev, INFINITE) == WAIT_OBJECT_0);
+
+    for (int i = 0; i < 2; i++) {
+        HANDLE h = foreign[i];
+        SetLastError(0);
+        CHECK("foreign wait fails", WaitForSingleObjectEx(h, INFINITE, FALSE) == WAIT_FAILED);
+        CHECK("foreign wait sets ERROR_INVALID_HANDLE", GetLastError() == ERROR_INVALID_HANDLE);
+        CHECK("foreign SetEvent fails", !SetEvent(h));
+        CHECK("foreign ResetEvent fails", !ResetEvent(h));
+        CHECK("foreign ReleaseSemaphore fails", !ReleaseSemaphore(h, 1, NULL));
+        CHECK("foreign ReleaseMutex fails", !ReleaseMutex(h));
+        CHECK("foreign CloseHandle fails", !CloseHandle(h));
+        {
+            HANDLE pair[2] = { ev, h };
+            CHECK("wait-any with a foreign handle fails",
+                  WaitForMultipleObjects(2, pair, FALSE, INFINITE) == WAIT_FAILED);
+            CHECK("wait-all with a foreign handle fails",
+                  WaitForMultipleObjects(2, pair, TRUE, INFINITE) == WAIT_FAILED);
+        }
+    }
+
+    /* Enough objects to grow the table several times, then half of them gone. */
+    for (int i = 0; i < 1000; i++)
+        many[i] = CreateEventA(NULL, TRUE, i & 1, NULL);
+    for (int i = 0; i < 1000; i += 2)
+        CHECK("CloseHandle", CloseHandle(many[i]));
+    for (int i = 0; i < 1000; i++) {
+        DWORD r = WaitForSingleObject(many[i], 0);
+        if (i & 1)
+            CHECK("live event still signalled", r == WAIT_OBJECT_0);
+        else
+            CHECK("closed event is no longer a handle", r == WAIT_FAILED);
+    }
+    for (int i = 1; i < 1000; i += 2)
+        CloseHandle(many[i]);
+
+    CHECK("ResetEvent", ResetEvent(ev));
+    {
+        HANDLE t = CreateThread(NULL, 0, worker, ev, 0, NULL);
+        CHECK("thread created", t != NULL);
+        CHECK("event set by the thread", WaitForSingleObject(ev, 5000) == WAIT_OBJECT_0);
+        CHECK("thread finished", WaitForSingleObject(t, 5000) == WAIT_OBJECT_0);
+        CHECK("thread exit code", GetExitCodeThread(t, &code) && code == 7);
+        CHECK("thread handle closes", CloseHandle(t));
+    }
+    CHECK("event closes", CloseHandle(ev));
+    CHECK("closed event cannot be set", !SetEvent(ev));
+
+    if (failures) {
+        printf("%d check(s) failed\n", failures);
+        return 1;
+    }
+    printf("win32 handles: all checks passed\n");
+    return 0;
+}
