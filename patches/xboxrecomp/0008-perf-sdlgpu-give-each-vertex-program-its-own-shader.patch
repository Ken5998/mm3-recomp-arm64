+++ b/src/video/nv2a_vspec.h
@@ -0,0 +1,31 @@
+/* Vertex programs as straight-line HLSL (nv2a_vspec.c).
+ *
+ * The SDL3 GPU renderer's ub_vs interprets the NV2A vertex program per
+ * vertex, keeping the temporaries, inputs and outputs in arrays it indexes at
+ * run time. Mobile GPUs (Adreno) keep such arrays in memory rather than in
+ * registers, and on a Retroid Pocket 6 the interpreter was most of the
+ * frame. nv2a_vspec_source writes one program as a vs_prog function with
+ * every field a constant and every register its own variable; the renderer
+ * compiles ub_vs with VSPEC defined around it. */
+#ifndef NV2A_VSPEC_H
+#define NV2A_VSPEC_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define NV2A_VSPEC_MAX 136          /* program slots */
+
+typedef struct {
+    uint32_t n;                     /* instructions; 0 for pre-transformed draws */
+    uint32_t w[NV2A_VSPEC_MAX][4];
+} Nv2aVsKey;
+
+/* The key for the program from slot start to the final flag (prog NULL: a
+ * pre-transformed draw, n = 0). */
+void nv2a_vspec_key(Nv2aVsKey *k, const uint32_t (*prog)[4], uint32_t start);
+
+/* The HLSL of vs_prog for k into buf; returns its length, or 0 if it did not
+ * fit in cap bytes. */
+size_t nv2a_vspec_source(const Nv2aVsKey *k, char *buf, size_t cap);
+
+#endif
