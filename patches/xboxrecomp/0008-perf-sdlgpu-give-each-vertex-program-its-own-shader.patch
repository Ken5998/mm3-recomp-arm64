@@ -2241,6 +2490,7 @@ static int setup_pipeline(const NvD3DState *st, int topology, Surface **out_s,
         uint32_t v = (st->flat_shade ? 1u : 0u) | (wdepth && d ? 2u : 0u);
         static const uint8_t ps[4] = { SH_PS_MAIN, SH_PS_MAIN_FLAT, SH_PS_WDEPTH, SH_PS_WDEPTH_FLAT };
         k.vs = SH_UB_VS;
+        k.vspec = s_draw_vspec;
         k.ps = ps[v];
     }
     k.color = s ? FMT_BGRA8 : FMT_NONE;
@@ -2430,8 +2680,16 @@ void nv2a_d3d_draw_ub(const NvD3DState *st, int topology, const NvD3DAttrib attr
 
     t_draw = s_prof_on > 0 ? qpc() : 0;
     s_prof_draws++;
-    if (!setup_pipeline(st, topology, &s, &gw, &gh, &zmax, 1))
+    {
+        uint32_t vstart = 0, vver = 0;
+        const uint32_t (*vprog)[4] = program ? nv2a_vsh_program(&vstart, &vver) : NULL;
+        s_draw_vspec = program && !vprog ? 0 : vspec_for(vprog, vstart, vver);
+    }
+    if (!setup_pipeline(st, topology, &s, &gw, &gh, &zmax, 1)) {
+        s_draw_vspec = 0;
         return;
+    }
+    s_draw_vspec = 0;
     if (pos && s && s->sx > s->sy * 1.001f && s_overlay.place) {
         float xlo = 1e30f, xhi = -1e30f, ylo = 1e30f, yhi = -1e30f;
