diff --git a/src/video/nv2a_sdlgpu.c b/src/video/nv2a_sdlgpu.c
index fffccd5..316aa20 100644
--- a/src/video/nv2a_sdlgpu.c
+++ b/src/video/nv2a_sdlgpu.c
@@ -346,6 +346,248 @@ static int create_shaders(void)
     return 1;
 }
 
+/* ------------------------------------------- vertex programs as shaders
+ * ub_vs interprets the NV2A vertex program per vertex, keeping temporaries,
+ * inputs and outputs in arrays it indexes at run time; Adreno keeps those in
+ * memory, and on a Retroid Pocket 6 the interpreter took the GPU to 100% at
+ * 6-10 fps. Each program (the slots from the start slot to the final flag)
+ * gets ub_vs compiled with VSPEC around a straight-line vs_prog
+ * (nv2a_vspec.c), by SDL_shadercross on a worker thread; draws use ub_vs
+ * until the variant is ready, so nothing changes on screen meanwhile. A
+ * variant without a program serves pre-transformed draws. RECOMP_VS_SPEC=0
+ * turns this off, =sync compiles on the drawing thread. With
+ * RECOMP_SHADER_CACHE naming a directory the SPIR-V is kept there, keyed by
+ * the program and the source it was inserted into. */
+#ifdef XBOXRECOMP_NV2A_VSPEC
+#include <SDL3_shadercross/SDL_shadercross.h>
+#include "nv2a_vspec.h"
+#include "sdlgpu/ub_vspec.hlsl.h"
+
+enum { VSPEC_EMPTY, VSPEC_QUEUED, VSPEC_COMPILED, VSPEC_READY, VSPEC_FAILED };
+
+typedef struct {
+    Nv2aVsKey key;
+    SDL_AtomicInt state;
+    void *spirv;                    /* VSPEC_COMPILED: SDL_malloc'd SPIR-V */
+    size_t spirv_size;
+    SDL_GPUShader *shader;          /* VSPEC_READY */
+} VsSpec;
+
+#define VS_SPEC_SLOTS 1024          /* power of two; fits PipeKey.vspec */
+#define VS_SPEC_QUEUE 256
+static VsSpec *s_vspec;
+static VsSpec *s_vspec_q[VS_SPEC_QUEUE];
+static unsigned s_vq_head, s_vq_tail;
+static SDL_Mutex *s_vq_lock;
+static SDL_Condition *s_vq_cv;
+static int s_vspec_on = -1, s_vspec_sync;
+static char s_vspec_dir[1024];
+static uint64_t s_vspec_src_hash;
+static SDL_AtomicInt s_vspec_ready;
+
+static uint64_t fnv64(uint64_t h, const void *p, size_t n)
+{
+    const uint8_t *b = (const uint8_t *)p;
+    while (n--) h = (h ^ *b++) * 1099511628211ull;
+    return h;
+}
+
+static int vspec_cache_path(const VsSpec *e, char *path, size_t cap)
+{
+    uint64_t h;
+    if (!s_vspec_dir[0]) return 0;
+    h = fnv64(s_vspec_src_hash, &e->key.n, sizeof e->key.n);
+    h = fnv64(h, e->key.w, e->key.n * 16u);
+    return snprintf(path, cap, "%s/vs-%016llx.spv", s_vspec_dir, (unsigned long long)h) < (int)cap;
+}
+
+static void vspec_compile(VsSpec *e)
+{
+    static const char marker[] = "static const uint VSPEC_INSERT = 0u;";
+    static SDL_AtomicInt warned;
+    char path[1200];
+    const char *at = strstr(ub_vspec_hlsl, marker);
+    size_t base_len = sizeof ub_vspec_hlsl - 1, cap = 256 * 1024, fn_len = 0, head, size = 0;
+    char *fn = NULL, *src = NULL;
+    void *spirv = NULL;
+    int cached = vspec_cache_path(e, path, sizeof path);
+    if (cached) {
+        size_t n = 0;
+        void *data = SDL_LoadFile(path, &n);
+        if (data && n >= 20 && ((const uint32_t *)data)[0] == 0x07230203u) {
+            e->spirv = data;
+            e->spirv_size = n;
+            SDL_SetAtomicInt(&e->state, VSPEC_COMPILED);
+            return;
+        }
+        SDL_free(data);
+    }
+    if (at && (fn = (char *)malloc(cap)) != NULL)
+        fn_len = nv2a_vspec_source(&e->key, fn, cap);
+    if (fn_len && (src = (char *)malloc(base_len + fn_len + 2)) != NULL) {
+        SDL_ShaderCross_HLSL_Info hi;
+        head = (size_t)(at - ub_vspec_hlsl) + sizeof marker - 1;
+        memcpy(src, ub_vspec_hlsl, head);
+        src[head] = '\n';
+        memcpy(src + head + 1, fn, fn_len);
+        memcpy(src + head + 1 + fn_len, ub_vspec_hlsl + head, base_len - head + 1);
+        memset(&hi, 0, sizeof hi);
+        hi.source = src;
+        hi.entrypoint = "ub_vs";
+        hi.shader_stage = SDL_SHADERCROSS_SHADERSTAGE_VERTEX;
+        spirv = SDL_ShaderCross_CompileSPIRVFromHLSL(&hi, &size);
+        if (!spirv && SDL_CompareAndSwapAtomicInt(&warned, 0, 1))
+            fprintf(stderr, "[SDLGPU] vertex program variant: %s\n", SDL_GetError());
+    }
+    free(fn);
+    free(src);
+    if (!spirv) {
+        SDL_SetAtomicInt(&e->state, VSPEC_FAILED);
+        return;
+    }
+    if (cached) {
+        char tmp[1300];
+        snprintf(tmp, sizeof tmp, "%s.tmp", path);
+        if (SDL_SaveFile(tmp, spirv, size)) SDL_RenamePath(tmp, path);
+    }
+    e->spirv = spirv;
+    e->spirv_size = size;
+    SDL_SetAtomicInt(&e->state, VSPEC_COMPILED);
+}
+
+static int SDLCALL vspec_worker(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        VsSpec *e;
+        SDL_LockMutex(s_vq_lock);
+        while (s_vq_head == s_vq_tail) SDL_WaitCondition(s_vq_cv, s_vq_lock);
+        e = s_vspec_q[s_vq_tail++ % VS_SPEC_QUEUE];
+        SDL_UnlockMutex(s_vq_lock);
+        vspec_compile(e);
+    }
+    return 0;
+}
+
+static int vspec_init(void)
+{
+    const char *v = getenv("RECOMP_VS_SPEC"), *dir = getenv("RECOMP_SHADER_CACHE");
+    int i, workers;
+    if (v && *v == '0') return 0;
+    s_vspec_sync = v && !strcmp(v, "sync");
+    if (!(SDL_GetGPUShaderFormats(s_dev) & SDL_GPU_SHADERFORMAT_SPIRV)) return 0;
+    if (!strstr(ub_vspec_hlsl, "VSPEC_INSERT")) return 0;
+    if (!(s_vspec = (VsSpec *)calloc(VS_SPEC_SLOTS, sizeof *s_vspec))) return 0;
+    s_vspec_src_hash = fnv64(1469598103934665603ull, ub_vspec_hlsl, sizeof ub_vspec_hlsl);
+    if (dir && *dir && SDL_CreateDirectory(dir))
+        snprintf(s_vspec_dir, sizeof s_vspec_dir, "%s", dir);
+    if (s_vspec_sync) return 1;
+    s_vq_lock = SDL_CreateMutex();
+    s_vq_cv = SDL_CreateCondition();
+    if (!s_vq_lock || !s_vq_cv) return 0;
+    /* Two workers: DXC takes tens to hundreds of ms a program, and the game
+     * and the audio need the other cores. */
+    workers = SDL_GetNumLogicalCPUCores() > 4 ? 2 : 1;
+    for (i = 0; i < workers; i++) {
+        SDL_Thread *t = SDL_CreateThread(vspec_worker, "vs-compile", NULL);
+        if (!t) return i > 0;
+        SDL_DetachThread(t);
+    }
+    return 1;
+}
+
+/* The ready variant's shader, from the drawing thread. */
+static SDL_GPUShader *vspec_shader(VsSpec *e)
+{
+    int st = SDL_GetAtomicInt(&e->state);
+    if (st == VSPEC_COMPILED) {
+        const ShaderSource *src = &s_shader_src[SH_UB_VS];
+        SDL_GPUShaderCreateInfo ci;
+        memset(&ci, 0, sizeof ci);
+        ci.entrypoint = "ub_vs";
+        ci.stage = SDL_GPU_SHADERSTAGE_VERTEX;
+        ci.num_samplers = src->samplers;
+        ci.num_storage_buffers = src->storage_buffers;
+        ci.num_uniform_buffers = src->uniforms;
+        ci.format = SDL_GPU_SHADERFORMAT_SPIRV;
+        ci.code = (const Uint8 *)e->spirv;
+        ci.code_size = e->spirv_size;
+        e->shader = SDL_CreateGPUShader(s_dev, &ci);
+        SDL_free(e->spirv);
+        e->spirv = NULL;
+        if (!e->shader) {
+            fail("SDL_CreateGPUShader (vertex program variant)");
+            SDL_SetAtomicInt(&e->state, VSPEC_FAILED);
+            return NULL;
+        }
+        SDL_SetAtomicInt(&e->state, VSPEC_READY);
+        {
+            int n = SDL_AddAtomicInt(&s_vspec_ready, 1) + 1;
+            if (!(n & (n - 1)))
+                fprintf(stderr, "[SDLGPU] %d vertex programs as their own shaders\n", n);
+        }
+        return e->shader;
+    }
+    return st == VSPEC_READY ? e->shader : NULL;
+}
+
+/* The PipeKey.vspec of the variant for this draw's program (prog NULL: a
+ * pre-transformed draw), or 0 (ub_vs) while it is not ready. pver is the
+ * program memory's change counter: while it and start stay the same the
+ * last answer stands without hashing the program again. */
+static uint16_t vspec_for(const uint32_t (*prog)[4], uint32_t start, uint32_t pver)
+{
+    static Nv2aVsKey k;
+    static VsSpec *last;
+    static uint32_t last_start = 0xFFFFFFFFu, last_pver;
+    static int last_prog = -1;
+    uint64_t h;
+    uint32_t i;
+    VsSpec *e = NULL;
+    if (s_vspec_on < 0) s_vspec_on = vspec_init();
+    if (!s_vspec_on) return 0;
+    if (last && last_prog == (prog != NULL) && (!prog || (start == last_start && pver == last_pver))) {
+        e = last;
+    } else {
+        nv2a_vspec_key(&k, prog, start);
+        h = fnv64(1469598103934665603ull, &k.n, sizeof k.n);
+        h = fnv64(h, k.w, k.n * 16u);
+        for (i = 0; i < VS_SPEC_SLOTS; i++) {
+            VsSpec *c = &s_vspec[(h + i) & (VS_SPEC_SLOTS - 1)];
+            if (SDL_GetAtomicInt(&c->state) == VSPEC_EMPTY) {
+                c->key = k;
+                if (s_vspec_sync) {
+                    SDL_SetAtomicInt(&c->state, VSPEC_QUEUED);
+                    vspec_compile(c);
+                } else {
+                    SDL_LockMutex(s_vq_lock);
+                    if (s_vq_head - s_vq_tail < VS_SPEC_QUEUE) {
+                        SDL_SetAtomicInt(&c->state, VSPEC_QUEUED);
+                        s_vspec_q[s_vq_head++ % VS_SPEC_QUEUE] = c;
+                        SDL_SignalCondition(s_vq_cv);
+                    } else {
+                        c = NULL;   /* queue full: try again on a later draw */
+                    }
+                    SDL_UnlockMutex(s_vq_lock);
+                }
+                e = c;
+                break;
+            }
+            if (c->key.n == k.n && !memcmp(c->key.w, k.w, k.n * 16u)) { e = c; break; }
+        }
+        if (!e) return 0;           /* table full or queue full: ub_vs */
+        last = e; last_prog = prog != NULL; last_start = start; last_pver = pver;
+    }
+    return vspec_shader(e) ? (uint16_t)(e - s_vspec + 1) : 0;
+}
+#else
+static uint16_t vspec_for(const uint32_t (*prog)[4], uint32_t start, uint32_t pver)
+{
+    (void)prog; (void)start; (void)pver;
+    return 0;
+}
+#endif
+
 /* ------------------------------------------------------- command buffers */
 
 static SDL_GPUCommandBuffer *cmd(void)
@@ -809,7 +1051,7 @@ typedef struct {
     uint8_t vs, ps, color, depth, prim, blend_enable, write_mask, cull;
     uint8_t front_ccw, zt, zw, zfunc, st, sfunc, rmask, wmask;
     uint8_t sfail, szfail, szpass, pad;
-    uint16_t sf, df, eq, pad2;
+    uint16_t sf, df, eq, vspec;     /* vspec: 0 ub_vs, else a VsSpec slot + 1 */
     int32_t bias;
     float slope;
 } PipeKey;
@@ -923,6 +1165,9 @@ static SDL_GPUGraphicsPipeline *pipeline(const PipeKey *k)
         memset(&ci, 0, sizeof ci);
         memset(&ctd, 0, sizeof ctd);
         ci.vertex_shader = s_shader[k->vs];
+#ifdef XBOXRECOMP_NV2A_VSPEC
+        if (k->vspec && k->vs == SH_UB_VS) ci.vertex_shader = s_vspec[k->vspec - 1].shader;
+#endif
         ci.fragment_shader = s_shader[k->ps];
         ci.primitive_type = (SDL_GPUPrimitiveType)k->prim;
         ci.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
@@ -2029,6 +2274,10 @@ static Op *draw_op(OpKind kind, uint32_t count, uint32_t first)
 
 /* Everything a draw needs apart from its vertices, recorded into the batch
  * (see setup_pipeline in nv2a_d3d11.c, which this follows step for step). */
+/* The vertex program variant for the draw setup_pipeline is preparing
+ * (vspec_for); 0 draws with ub_vs. */
+static uint16_t s_draw_vspec;
+
 static int setup_pipeline(const NvD3DState *st, int topology, Surface **out_s,
                           uint32_t *out_gw, uint32_t *out_gh, uint32_t *out_zmax, int indexed)
