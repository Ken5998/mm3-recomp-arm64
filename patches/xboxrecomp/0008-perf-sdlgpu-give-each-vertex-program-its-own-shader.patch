 cmake/Nv2aSdlgpu.cmake             |  13 ++
 src/video/CMakeLists.txt           |   5 +
 src/video/nv2a_sdlgpu.c            | 262 ++++++++++++++++++++++++++++-
 src/video/nv2a_vspec.c             | 185 ++++++++++++++++++++
 src/video/nv2a_vspec.h             |  31 ++++
 src/video/shaders/nv2a_vertex.hlsl |  11 ++
 7 files changed, 511 insertions(+), 25 deletions(-)
 create mode 100644 src/video/nv2a_vspec.c
 create mode 100644 src/video/nv2a_vspec.h

diff --git a/cmake/EmbedText.cmake b/cmake/EmbedText.cmake
index 1fd9084..d7c84a1 100644
--- a/cmake/EmbedText.cmake
+++ b/cmake/EmbedText.cmake
@@ -1,23 +1,6 @@
-# Writes the concatenation of INPUTS (files, separated by |) to OUT as a C string
-# constant named NAME, one string literal per source line, so no literal
-# reaches a compiler's length limit. OUT is replaced only when it changes.
-#
-#   cmake -DNAME=s_hlsl -DOUT=out.inc "-DINPUTS=a.hlsl|b.hlsl" -P EmbedText.cmake
-#
-# (| separates INPUTS: a ; would not survive add_custom_command.)
-if(NOT NAME OR NOT OUT OR NOT INPUTS)
-    message(FATAL_ERROR "EmbedText.cmake needs NAME, OUT and INPUTS")
-endif()
-string(REPLACE "|" ";" INPUTS "${INPUTS}")
-set(text "")
-foreach(input IN LISTS INPUTS)
-    file(READ "${input}" chunk)
-    string(APPEND text "${chunk}")
-endforeach()
-string(REPLACE "\r" "" text "${text}")
-string(REPLACE "\\" "\\\\" text "${text}")
-string(REPLACE "\"" "\\\"" text "${text}")
-string(REPLACE "\n" "\\n\"\n\"" text "${text}")
-file(WRITE "${OUT}.tmp" "/* Generated by cmake/EmbedText.cmake. Do not edit. */\nstatic const char ${NAME}[] =\n\"${text}\";\n")
-execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
-file(REMOVE "${OUT}.tmp")
+# cmake -DIN=<file> -DOUT=<header> -DNAME=<symbol> -P EmbedText.cmake
+# Writes <file> as "static const char NAME[]", NUL-terminated, for a source
+# the renderer compiles while it runs (see the VSPEC variants in nv2a_sdlgpu.c).
+file(READ "${IN}" _hex HEX)
+string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
+file(WRITE "${OUT}" "static const char ${NAME}[] = {${_bytes}0};\n")
diff --git a/cmake/Nv2aSdlgpu.cmake b/cmake/Nv2aSdlgpu.cmake
index d17a27f..9a14b06 100644
--- a/cmake/Nv2aSdlgpu.cmake
+++ b/cmake/Nv2aSdlgpu.cmake
@@ -83,6 +83,19 @@ function(xbr_sdlgpu_shaders gen out)
             list(APPEND _shader_headers ${_out})
         endforeach()
     endforeach()
+    # ub_vs preprocessed with VSPEC, as text: the renderer inserts each
+    # vertex program's straight-line vs_prog and compiles it while it runs.
+    set(_vspec ${gen}/sdlgpu/ub_vspec.hlsl)
+    add_custom_command(OUTPUT ${_vspec}.h
+        COMMAND ${CMAKE_COMMAND} -E make_directory ${gen}/sdlgpu
+        COMMAND ${XBOXRECOMP_DXC} -nologo -P -Fi ${_vspec}
+                -D SDLGPU -D STAGE_VS -D VSPEC ${gen}/units/ub.hlsl
+        COMMAND ${CMAKE_COMMAND} -DIN=${_vspec} -DOUT=${_vspec}.h -DNAME=ub_vspec_hlsl
+                -P ${_xbr_sdlgpu_root}/cmake/EmbedText.cmake
+        DEPENDS ${gen}/units/ub.hlsl ${NV2A_HLSL_DEPENDS} ${_xbr_sdlgpu_root}/cmake/EmbedText.cmake
+        COMMENT "dxc -P ub_vs (VSPEC source)"
+        VERBATIM)
+    list(APPEND _shader_headers ${_vspec}.h)
     set(${out} ${_shader_headers} PARENT_SCOPE)
 endfunction()
 
