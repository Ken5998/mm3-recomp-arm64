diff --git a/tests/memory_regressions/test_main.c b/tests/memory_regressions/test_main.c
index 84629a8..339d2ce 100644
--- a/tests/memory_regressions/test_main.c
+++ b/tests/memory_regressions/test_main.c
@@ -24,6 +24,15 @@
  *      the console. Both were no-ops, so the old contents came back.
  *   6. MmFreeContiguousMemory gives a contiguous block back and the next
  *      request of that size reuses it; contiguous pages are reused in both modes.
+ *   7. A page-aligned request fits in a freed block that does not start on a
+ *      page. Only blocks starting aligned were considered, so once a small
+ *      request had split a freed block, page-aligned requests grew the heap.
+ *
+ *   map-128       RECOMP_HEAP_RECLAIM=1 on 64 MB of RAM in a 128 MB map, as
+ *                 Midtown Madness 3 runs. Reservations come from above RAM,
+ *                 and a heap that grows past RAM must step over them, as a
+ *                 reservation made later must start above the heap. The heap
+ *                 used to grow straight into the title's reserved CRT heap.
  *
  *   ext-vma       RECOMP_EXT_VMA=1. A title that reserves a specific address
  *                 above the RAM mirrors gets it, can commit inside it and use
@@ -177,7 +186,8 @@ int main(int argc, char **argv)
 {
     const char *mode = argc > 1 ? argv[1] : "default";
     const char *path = argc > 2 ? argv[2] : "tools/conformance/test.xbe";
-    int reclaim = !strcmp(mode, "heap-reclaim");
+    int map128 = !strcmp(mode, "map-128");
+    int reclaim = map128 || !strcmp(mode, "heap-reclaim");
     int ext128 = !strcmp(mode, "ext-vma-128");
     int ext = ext128 || !strcmp(mode, "ext-vma");
     size_t xbe_len = 0;
@@ -196,6 +206,8 @@ int main(int argc, char **argv)
         set_env("RECOMP_EXT_VMA", "1");
     if (ext128)
         xbox_SetTotalRam(XBOX_DEVKIT_RAM);
+    if (map128)
+        xbox_SetMapSize(128u * 1024 * 1024);
 
     xbe = load_file(path, &xbe_len);
     if (!xbe) {
@@ -315,6 +327,41 @@ int main(int argc, char **argv)
         check(c1 && c2 == c1, "a freed contiguous block is reused in both modes", d);
     }
 
+    /* 7. A page-aligned request in a freed block that starts off a page. */
+    if (reclaim) {
+        uint32_t b1 = xbox_HeapAlloc(16, 4096);
+        uint32_t b2 = xbox_HeapAlloc(0x2FF0, 16);
+        /* Larger than any freed block, so it comes from the top of the heap. */
+        uint32_t top = xbox_HeapAlloc(0x400000, 16);
+        uint32_t p;
+
+        (void)b1;
+        xbox_HeapFree(b2);
+        p = xbox_HeapAlloc(0x1000, 4096);
+        snprintf(d, sizeof d, "got 0x%08X, heap had reached 0x%08X", p, top);
+        check(p && p < top && !(p & 0xFFF) && xbox_HeapBlockSize(p) == 0x1000,
+              "a page-aligned request reuses freed space instead of growing the heap", d);
+    }
+
+    /* 8. The heap and the reservations above RAM stay apart. */
+    if (map128) {
+        const uint32_t big_size = 0x03800000u;
+        uint32_t r = xbox_ReserveAlloc(0x400000, 4096);
+        uint32_t big, r2;
+
+        snprintf(d, sizeof d, "got 0x%08X", r);
+        check(r == 0x04000000u, "a reservation starts at the top of RAM", d);
+        big = xbox_HeapAlloc(big_size, 4096);
+        snprintf(d, sizeof d, "heap block 0x%08X..0x%08X, reservation 0x%08X..0x%08X",
+                 big, big + big_size, r, r + 0x400000);
+        check(big && (big >= r + 0x400000 || big + big_size <= r),
+              "a heap block that grows past RAM steps over the reservation", d);
+        r2 = xbox_ReserveAlloc(0x100000, 4096);
+        snprintf(d, sizeof d, "got 0x%08X, heap reaches 0x%08X", r2, big + big_size);
+        check(r2 >= big + big_size, "a later reservation starts above the heap", d);
+        xbox_MemoryReport("map-128");
+    }
+
     /* 4. Above the RAM mirrors: [0x74000000, 0x7FFE0000) at 64 MB. */
     {
         const uint32_t hi = 0x76000000u;
