 /* ============================================================
  * Public API
  * ============================================================ */
@@ -448,7 +484,7 @@ bool nv2a_hook_handle_vram(uintptr_t fault_addr, uint32_t fault_xbox_va)
     return false;
 }
 
-#else /* !_WIN32 -- SIGSEGV-based MMIO trapping deferred to main.c port */
+#else /* no fault decoder for this host */
 
 bool nv2a_hook_pvideo_snapshot(uint32_t regs[0x1000 / 4])
 { (void)regs; return false; }
@@ -464,4 +500,4 @@ bool nv2a_hook_handle_mmio(PCONTEXT ctx, uintptr_t fault_addr,
 bool nv2a_hook_handle_vram(uintptr_t fault_addr, uint32_t fault_xbox_va)
