diff --git a/src/kernel/xbox_memory_layout.c b/src/kernel/xbox_memory_layout.c
index 1289c36..81fb4fc 100644
--- a/src/kernel/xbox_memory_layout.c
+++ b/src/kernel/xbox_memory_layout.c
@@ -407,6 +407,42 @@ static const struct { uint32_t offset; uint32_t idle_mask; } NV2A_IDLE[] = {
 #define AC97_TRAP_BYTES   0x1000u
 #define AC97_RR           0x02u
 
+#if !defined(_WIN32)
+#include "mmio_decode.h"
+
+/* POSIX has no trap flag to single-step a write with, so the write traps
+ * below are serviced by doing the store: decode it (mmio_decode.h), apply it
+ * to the page made writable for the moment, and step past it. The caller
+ * does its own work and protects the page again. Returns 0 for an
+ * instruction the decoder does not know, leaving the fault unhandled. */
+static uint64_t step_plain_read(void *page, uint32_t off, int size)
+{
+    uint64_t v = 0;
+    memcpy(&v, (const uint8_t *)page + off, (size_t)size);
+    return v;
+}
+
+static void step_plain_write(void *page, uint32_t off, uint64_t v, int size)
+{
+    memcpy((uint8_t *)page + off, &v, (size_t)size);
+}
+
+static int step_store(PEXCEPTION_POINTERS ep, void *page, size_t len)
+{
+#if defined(MMIO_TRAP_SUPPORTED)
+    uintptr_t fault = ep->ExceptionRecord->ExceptionInformation[1];
+    DWORD old;
+    if (!VirtualProtect(page, len, PAGE_READWRITE, &old))
+        return 0;
+    return mmio_emulate(ep->ContextRecord, (uint32_t)(fault - (uintptr_t)page),
+                        page, step_plain_read, step_plain_write);
+#else
+    (void)ep; (void)page; (void)len;
+    return 0;
+#endif
+}
+#endif
+
 static void *g_ac97_page = NULL;      /* host address of the trapped page */
 static void *g_ac97_veh  = NULL;
 static RECOMP_TLS int s_ac97_stepping = 0;
@@ -444,6 +480,7 @@ static LONG CALLBACK ac97_write_veh(PEXCEPTION_POINTERS ep)
      * because another thread must not mistake its own single-step for this
      * one -- and re-protecting from the wrong thread would strand this one
      * mid-step. */
+#if defined(_WIN32)
     if (code == EXCEPTION_SINGLE_STEP && s_ac97_stepping) {
         s_ac97_stepping = 0;
         ac97_clear_reset_bits();
@@ -451,6 +488,7 @@ static LONG CALLBACK ac97_write_veh(PEXCEPTION_POINTERS ep)
         ep->ContextRecord->EFlags &= ~0x100u;   /* clear TF */
         return EXCEPTION_CONTINUE_EXECUTION;
     }
+#endif
 
     if (code == EXCEPTION_ACCESS_VIOLATION
             && ep->ExceptionRecord->ExceptionInformation[0] == 1) {
@@ -458,12 +496,21 @@ static LONG CALLBACK ac97_write_veh(PEXCEPTION_POINTERS ep)
 
         if (fault >= (uintptr_t)g_ac97_page
                 && fault < (uintptr_t)g_ac97_page + AC97_TRAP_BYTES) {
+#if defined(_WIN32)
             if (!VirtualProtect(g_ac97_page, AC97_TRAP_BYTES,
                                 PAGE_READWRITE, &old))
                 return EXCEPTION_CONTINUE_SEARCH;
             s_ac97_stepping = 1;
             ep->ContextRecord->EFlags |= 0x100u;   /* TF: step the write */
             return EXCEPTION_CONTINUE_EXECUTION;
+#else
+            (void)s_ac97_stepping;
+            if (!step_store(ep, g_ac97_page, AC97_TRAP_BYTES))
+                return EXCEPTION_CONTINUE_SEARCH;
+            ac97_clear_reset_bits();
+            VirtualProtect(g_ac97_page, AC97_TRAP_BYTES, PAGE_READONLY, &old);
+            return EXCEPTION_CONTINUE_EXECUTION;
+#endif
         }
     }
     return EXCEPTION_CONTINUE_SEARCH;
@@ -1496,6 +1543,7 @@ static LONG CALLBACK watch_veh(PEXCEPTION_POINTERS ep)
     if (!g_watch_page)
         return EXCEPTION_CONTINUE_SEARCH;
 
+#if defined(_WIN32)
     if (code == EXCEPTION_SINGLE_STEP && s_watch_stepping) {
         s_watch_stepping = 0;
         watch_report();
@@ -1503,6 +1551,7 @@ static LONG CALLBACK watch_veh(PEXCEPTION_POINTERS ep)
         ep->ContextRecord->EFlags &= ~0x100u;
         return EXCEPTION_CONTINUE_EXECUTION;
     }
+#endif
 
     if (code == EXCEPTION_ACCESS_VIOLATION
             && ep->ExceptionRecord->ExceptionInformation[0] == 1) {
@@ -1510,11 +1559,20 @@ static LONG CALLBACK watch_veh(PEXCEPTION_POINTERS ep)
 
         if (fault >= (uintptr_t)g_watch_page
                 && fault < (uintptr_t)g_watch_page + 4096) {
+#if defined(_WIN32)
             if (!VirtualProtect(g_watch_page, 4096, PAGE_READWRITE, &old))
                 return EXCEPTION_CONTINUE_SEARCH;
             s_watch_stepping = 1;
             ep->ContextRecord->EFlags |= 0x100u;
             return EXCEPTION_CONTINUE_EXECUTION;
+#else
+            (void)s_watch_stepping;
+            if (!step_store(ep, g_watch_page, 4096))
+                return EXCEPTION_CONTINUE_SEARCH;
+            watch_report();
+            VirtualProtect(g_watch_page, 4096, PAGE_READONLY, &old);
+            return EXCEPTION_CONTINUE_EXECUTION;
+#endif
         }
     }
     return EXCEPTION_CONTINUE_SEARCH;
