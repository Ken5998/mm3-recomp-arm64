@@ -1912,8 +1935,175 @@ VOID RaiseException(DWORD code, DWORD flags, DWORD nargs, const ULONG_PTR *args)
     /* TODO: on Windows this does not return; SEH dispatch unimplemented. */
 }
 
+/* ---- Vectored exception handlers over POSIX signals ------------------
+ *
+ * The runtime traps device registers by leaving their pages inaccessible and
+ * servicing the fault (mmio_decode.h). On Windows that is a VEH; here the
+ * same handlers are called from a SIGSEGV/SIGBUS handler with an
+ * EXCEPTION_RECORD built the way Windows builds one -- ExceptionInformation[0]
+ * is 1 for a write, [1] the faulting address -- and the ucontext_t as the
+ * CONTEXT. A handler that returns EXCEPTION_CONTINUE_EXECUTION resumes at the
+ * (possibly edited) context; when none does, the unhandled-exception filter
+ * runs and the signal goes to whatever was installed before, or the default
+ * action, so a real crash still crashes. */
+#if defined(__linux__) && (defined(__aarch64__) || defined(__x86_64__))
+#include "mmio_decode.h"
+
+__thread uintptr_t g_posix_fault_address;
+
+#define VEH_SLOTS 16
+static PVECTORED_EXCEPTION_HANDLER s_veh[VEH_SLOTS];
+static pthread_mutex_t s_veh_lock = PTHREAD_MUTEX_INITIALIZER;
+static LPTOP_LEVEL_EXCEPTION_FILTER s_unhandled_filter;
+static struct sigaction s_prev_segv, s_prev_bus;
+static int s_veh_installed;
+
+static int posix_fault_is_write(ucontext_t *uc)
+{
+#if defined(__aarch64__)
+    return mmio_a64_is_write((PCONTEXT)uc);
+#else
+    return (uc->uc_mcontext.gregs[19] & 2) ? 1 : 0;      /* REG_ERR: W bit */
+#endif
+}
+
+static void *posix_fault_pc(ucontext_t *uc)
+{
+#if defined(__aarch64__)
+    return (void *)(uintptr_t)uc->uc_mcontext.pc;
+#else
+    return (void *)(uintptr_t)uc->uc_mcontext.gregs[16]; /* REG_RIP */
+#endif
+}
+
+static void veh_signal(int sig, siginfo_t *si, void *uctx)
+{
+    ucontext_t *uc = (ucontext_t *)uctx;
+    EXCEPTION_RECORD rec;
+    EXCEPTION_POINTERS ep;
+    struct sigaction *prev = sig == SIGBUS ? &s_prev_bus : &s_prev_segv;
+    int saved_errno = errno;
+    int i;
+
+    memset(&rec, 0, sizeof rec);
+    rec.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+    rec.ExceptionAddress = posix_fault_pc(uc);
+    rec.NumberParameters = 2;
+    rec.ExceptionInformation[0] = (ULONG_PTR)posix_fault_is_write(uc);
+    rec.ExceptionInformation[1] = (ULONG_PTR)si->si_addr;
+    ep.ExceptionRecord = &rec;
+    ep.ContextRecord = (PCONTEXT)uc;
+    g_posix_fault_address = (uintptr_t)si->si_addr;
+
+    for (i = 0; i < VEH_SLOTS; i++) {
+        PVECTORED_EXCEPTION_HANDLER h =
+            __atomic_load_n(&s_veh[i], __ATOMIC_ACQUIRE);
+        if (h && h(&ep) == EXCEPTION_CONTINUE_EXECUTION) {
+            errno = saved_errno;
+            return;
+        }
+    }
+    if (s_unhandled_filter &&
+        s_unhandled_filter(&ep) == EXCEPTION_CONTINUE_EXECUTION) {
+        errno = saved_errno;
+        return;
+    }
+    /* Nobody wanted it: hand it on. Returning re-runs the faulting
+     * instruction under the previous disposition, which for SIG_DFL is the
+     * usual crash and core dump. */
+    if ((prev->sa_flags & SA_SIGINFO) && prev->sa_sigaction) {
+        prev->sa_sigaction(sig, si, uctx);
+        return;
+    }
+    if (prev->sa_handler != SIG_DFL && prev->sa_handler != SIG_IGN &&
+        prev->sa_handler) {
+        prev->sa_handler(sig);
+        return;
+    }
+    sigaction(sig, prev, NULL);
+    errno = saved_errno;
+}
+
+static int veh_install(void)
+{
+    struct sigaction sa;
+    if (s_veh_installed)
+        return 1;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = veh_signal;
+    sa.sa_flags = SA_SIGINFO | SA_RESTART | SA_ONSTACK;
+    sigemptyset(&sa.sa_mask);
+    if (sigaction(SIGSEGV, &sa, &s_prev_segv) != 0)
+        return 0;
+    if (sigaction(SIGBUS, &sa, &s_prev_bus) != 0) {
+        sigaction(SIGSEGV, &s_prev_segv, NULL);
+        return 0;
+    }
+    s_veh_installed = 1;
+    return 1;
+}
+
+PVOID AddVectoredExceptionHandler(ULONG First, PVECTORED_EXCEPTION_HANDLER Handler)
+{
+    PVOID slot = NULL;
+    int i;
+    if (!Handler)
+        return NULL;
+    pthread_mutex_lock(&s_veh_lock);
+    if (veh_install()) {
+        if (First) {
+            /* first: shift the others down to make room at the front */
+            if (!s_veh[VEH_SLOTS - 1]) {
+                for (i = VEH_SLOTS - 1; i > 0; i--)
+                    __atomic_store_n(&s_veh[i], s_veh[i - 1], __ATOMIC_RELEASE);
+                __atomic_store_n(&s_veh[0], Handler, __ATOMIC_RELEASE);
+                slot = (PVOID)Handler;
+            }
+        } else {
+            for (i = 0; i < VEH_SLOTS; i++)
+                if (!s_veh[i]) {
+                    __atomic_store_n(&s_veh[i], Handler, __ATOMIC_RELEASE);
+                    slot = (PVOID)Handler;
+                    break;
+                }
+        }
+    }
+    pthread_mutex_unlock(&s_veh_lock);
+    return slot;
+}
+
+ULONG RemoveVectoredExceptionHandler(PVOID h)
+{
+    ULONG found = 0;
+    int i, j;
+    pthread_mutex_lock(&s_veh_lock);
+    for (i = 0; i < VEH_SLOTS; i++)
+        if ((PVOID)s_veh[i] == h) {
+            for (j = i; j < VEH_SLOTS - 1; j++)
+                __atomic_store_n(&s_veh[j], s_veh[j + 1], __ATOMIC_RELEASE);
+            __atomic_store_n(&s_veh[VEH_SLOTS - 1], NULL, __ATOMIC_RELEASE);
+            found = 1;
+            break;
+        }
+    pthread_mutex_unlock(&s_veh_lock);
+    return found;
+}
+
+LPTOP_LEVEL_EXCEPTION_FILTER SetUnhandledExceptionFilter(LPTOP_LEVEL_EXCEPTION_FILTER filter)
+{
+    LPTOP_LEVEL_EXCEPTION_FILTER old = s_unhandled_filter;
+    pthread_mutex_lock(&s_veh_lock);
+    s_unhandled_filter = filter;
+    veh_install();
+    pthread_mutex_unlock(&s_veh_lock);
+    return old;
+}
+#else
 PVOID AddVectoredExceptionHandler(ULONG First, PVECTORED_EXCEPTION_HANDLER Handler)
-{ (void)First; (void)Handler; return NULL; }   /* TODO: wire to sigaction */
+{ (void)First; (void)Handler; return NULL; }   /* no fault decoder for this host */
 ULONG RemoveVectoredExceptionHandler(PVOID h) { (void)h; return 1; }
+LPTOP_LEVEL_EXCEPTION_FILTER SetUnhandledExceptionFilter(LPTOP_LEVEL_EXCEPTION_FILTER filter)
+{ (void)filter; return NULL; }
+#endif
 
 #endif /* !_WIN32 */
