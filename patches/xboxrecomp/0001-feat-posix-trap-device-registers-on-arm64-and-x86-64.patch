+
+BOOL GetComputerNameA(LPSTR buffer, LPDWORD size)
+{
+    char name[256];
+    size_t n;
+    if (!buffer || !size || gethostname(name, sizeof name) != 0)
+        return FALSE;
+    name[sizeof name - 1] = '\0';
+    n = strlen(name);
+    if (n + 1 > *size) {
+        *size = (DWORD)(n + 1);
+        return FALSE;
+    }
+    memcpy(buffer, name, n + 1);
+    *size = (DWORD)n;
+    return TRUE;
+}
