+        const uint8_t *ip = mmio_ctx_pc(ctx);
+        fprintf(stderr, "[NV2A] MMIO decode fail at PC=%p: %02X %02X %02X %02X\n",
+                (void *)ip, ip[0], ip[1], ip[2], ip[3]);
+        fflush(stderr);
+    }
