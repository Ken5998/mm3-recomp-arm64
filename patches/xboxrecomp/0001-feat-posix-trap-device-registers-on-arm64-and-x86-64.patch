diff --git a/src/platform/mmio_decode.h b/src/platform/mmio_decode.h
index c0dd9e0..fb7bedb 100644
--- a/src/platform/mmio_decode.h
+++ b/src/platform/mmio_decode.h
@@ -30,10 +30,31 @@
 
 #if defined(_WIN32)
 #include <windows.h>
+#define MMIO_TRAP_X86_64 1
+#elif defined(__linux__) && (defined(__x86_64__) || defined(__aarch64__))
+/* POSIX: PCONTEXT is the ucontext_t a SA_SIGINFO handler receives (see
+ * AddVectoredExceptionHandler in win32_compat.c). */
+#include <stddef.h>
+#include <ucontext.h>
+#include "win32_compat.h"
+#if defined(__x86_64__)
+#define MMIO_TRAP_X86_64 1
+#else
+#define MMIO_TRAP_AARCH64 1
+#endif
+#endif
+
+#if defined(MMIO_TRAP_X86_64) || defined(MMIO_TRAP_AARCH64)
+#define MMIO_TRAP_SUPPORTED 1
 
 /* Service one register access. dev is passed straight back to the callbacks. */
 typedef uint64_t (*mmio_read_fn)(void *dev, uint32_t off, int size);
 typedef void     (*mmio_write_fn)(void *dev, uint32_t off, uint64_t val, int size);
+#endif
+
+#if defined(_WIN32)
+#define MMIO_CTX_RIP(c)    ((c)->Rip)
+#define MMIO_CTX_EFLAGS(c) ((c)->EFlags)
 
 static inline uint64_t *mmio_ctx_reg(PCONTEXT c, int reg)
 {
@@ -49,7 +70,23 @@ static inline uint64_t *mmio_ctx_reg(PCONTEXT c, int reg)
     default: return NULL;
     }
 }
+#elif defined(MMIO_TRAP_X86_64)
+/* glibc's REG_* indices, spelled out so this header does not depend on
+ * _GNU_SOURCE having been defined before the first #include. */
+#define MMIO_GREGS(c)      (((ucontext_t *)(c))->uc_mcontext.gregs)
+#define MMIO_CTX_RIP(c)    (MMIO_GREGS(c)[16])          /* REG_RIP */
+#define MMIO_CTX_EFLAGS(c) (MMIO_GREGS(c)[17])          /* REG_EFL */
+
+static inline uint64_t *mmio_ctx_reg(PCONTEXT c, int reg)
+{
+    /* ModRM order rax rcx rdx rbx rsp rbp rsi rdi r8..r15 -> REG_* */
+    static const unsigned char map[16] = {
+        13, 14, 12, 11, 15, 10, 9, 8, 0, 1, 2, 3, 4, 5, 6, 7 };
+    return (uint64_t *)&MMIO_GREGS(c)[map[reg & 0xF]];
+}
+#endif
 
+#if defined(MMIO_TRAP_X86_64)
 static inline int mmio_modrm_len(const uint8_t *ip, int rex_b)
 {
     uint8_t modrm = *ip;
@@ -71,22 +108,22 @@ static inline int mmio_modrm_len(const uint8_t *ip, int rex_b)
 static inline void mmio_set_flags(PCONTEXT ctx, uint64_t result, int size,
                                   int carry)
 {
-    ctx->EFlags &= ~(0x0001u | 0x0040u | 0x0080u | 0x0800u);
+    MMIO_CTX_EFLAGS(ctx) &= ~(0x0001u | 0x0040u | 0x0080u | 0x0800u);
     if (size < 8)
         result &= (1ULL << (size * 8)) - 1;
     if (result == 0)
-        ctx->EFlags |= 0x0040u;                                   /* ZF */
+        MMIO_CTX_EFLAGS(ctx) |= 0x0040u;                                   /* ZF */
     if (result & (1ULL << (size * 8 - 1)))
-        ctx->EFlags |= 0x0080u;                                   /* SF */
+        MMIO_CTX_EFLAGS(ctx) |= 0x0080u;                                   /* SF */
     if (carry)
-        ctx->EFlags |= 0x0001u;                                   /* CF */
+        MMIO_CTX_EFLAGS(ctx) |= 0x0001u;                                   /* CF */
 }
 
-/* 1 if the instruction at ctx->Rip was serviced and Rip advanced past it. */
+/* 1 if the instruction at MMIO_CTX_RIP(ctx) was serviced and Rip advanced past it. */
 static inline int mmio_emulate(PCONTEXT ctx, uint32_t off, void *dev,
                                mmio_read_fn rd, mmio_write_fn wr)
 {
-    const uint8_t *ip = (const uint8_t *)ctx->Rip;
+    const uint8_t *ip = (const uint8_t *)MMIO_CTX_RIP(ctx);
     int prefix = 0, has66 = 0, rex = 0, has_rex = 0;
     const uint8_t *op;
     int size, rex_w, rex_r, rex_b, mlen, reg;
@@ -114,19 +151,19 @@ static inline int mmio_emulate(PCONTEXT ctx, uint32_t off, void *dev,
         mlen = mmio_modrm_len(op + 1, rex_b);
         reg  = ((op[1] >> 3) & 7) | (rex_r ? 8 : 0);
         wr(dev, off, *mmio_ctx_reg(ctx, reg), size);
-        ctx->Rip += prefix + 1 + mlen;
+        MMIO_CTX_RIP(ctx) += prefix + 1 + mlen;
         return 1;
 
     case 0xC7:                                       /* MOV r/m, imm32       */
         mlen = mmio_modrm_len(op + 1, rex_b);
         wr(dev, off, *(const uint32_t *)(op + 1 + mlen), size);
-        ctx->Rip += prefix + 1 + mlen + 4;
