@@ -0,0 +1,14 @@
+cmake_minimum_required(VERSION 3.20)
+project(mmio_decode_posix_test C)
+# Trapped MMIO on a POSIX host: the SIGSEGV-backed vectored handler in
+# win32_compat.c plus the host's instruction decoder (mmio_decode.h), driven
+# by real faulting loads and stores.
+if(WIN32)
+    message(FATAL_ERROR "This regression covers the POSIX fault path")
+endif()
+set(CMAKE_C_STANDARD 11)
+add_subdirectory(../../src/platform platform)
+add_executable(mmio_decode_posix_test test_main.c)
+target_link_libraries(mmio_decode_posix_test PRIVATE platform)
+enable_testing()
+add_test(NAME mmio_decode_posix_test COMMAND mmio_decode_posix_test)
diff --git a/tests/mmio_decode_posix/test_main.c b/tests/mmio_decode_posix/test_main.c
new file mode 100644
index 0000000..a8c625d
--- /dev/null
+++ b/tests/mmio_decode_posix/test_main.c
@@ -0,0 +1,246 @@
+/*
+ * mmio_decode_posix - trapped MMIO on a POSIX host, end to end.
+ *
+ * A page is left PROT_NONE and a vectored handler -- the SIGSEGV path behind
+ * AddVectoredExceptionHandler in win32_compat.c -- services each access with
+ * mmio_emulate() against a recording device. Unlike tests/mmio_decode, which
+ * feeds hand-encoded x86 to the Windows decoder, the instructions here are
+ * the host's own: on arm64 the A64 forms a compiler emits for volatile
+ * accesses, written out in inline assembly so each one is pinned down.
+ *
+ * What is checked is what goes wrong silently: the device offset (from the
+ * effective address, so a pair's second half lands at +size), the width, sign
+ * and zero extension into the destination, base-register writeback, and the
+ * PC landing exactly on the next instruction.
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+
+#include "win32_compat.h"
+#include "mmio_decode.h"
+
+static int failures;
+#define CHECK_U64(name, got, want) \
+    do { uint64_t g_ = (uint64_t)(got), w_ = (uint64_t)(want); \
+         if (g_ != w_) { \
+            printf("FAIL: %s (got 0x%llX, want 0x%llX)\n", name, \
+                   (unsigned long long)g_, (unsigned long long)w_); \
+            failures++; } } while (0)
+
+static uint8_t *page;                 /* the trapped page */
+static uint8_t regs[4096];            /* what the device holds */
+static struct { uint32_t off; int size; uint64_t val; int reads, writes; } last;
+static int unhandled;
+
+static uint64_t dev_read(void *d, uint32_t off, int size)
+{
+    uint64_t v = 0;
+    (void)d;
+    memcpy(&v, regs + off, (size_t)size);
+    last.off = off; last.size = size; last.val = v; last.reads++;
+    return v;
+}
+
+static void dev_write(void *d, uint32_t off, uint64_t v, int size)
+{
+    (void)d;
+    memcpy(regs + off, &v, (size_t)size);
+    last.off = off; last.size = size; last.val = v; last.writes++;
+}
+
+static LONG handler(PEXCEPTION_POINTERS ep)
+{
+    uintptr_t fault = ep->ExceptionRecord->ExceptionInformation[1];
+    if (fault < (uintptr_t)page || fault >= (uintptr_t)page + 4096)
+        return EXCEPTION_CONTINUE_SEARCH;
+    if (mmio_emulate(ep->ContextRecord, (uint32_t)(fault - (uintptr_t)page),
+                     NULL, dev_read, dev_write))
+        return EXCEPTION_CONTINUE_EXECUTION;
+    unhandled++;
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+static void reset(void)
+{
+    memset(&last, 0, sizeof last);
+    for (int i = 0; i < 4096; i++)
+        regs[i] = (uint8_t)(0x80 + i * 7);
+}
+
+static uint64_t reg_at(uint32_t off, int size)
+{
+    uint64_t v = 0;
+    memcpy(&v, regs + off, (size_t)size);
+    return v;
+}
+
+#if defined(__aarch64__)
+static void test_a64(void)
+{
+    uint64_t x, y, base;
+    uint32_t w;
+
+    reset();
+    __asm__ volatile("ldr %w0, [%1, #0x40]" : "=r"(w) : "r"(page) : "memory");
+    CHECK_U64("ldr w imm off", last.off, 0x40);
+    CHECK_U64("ldr w imm size", last.size, 4);
+    CHECK_U64("ldr w imm value", w, reg_at(0x40, 4));
+
+    reset();
+    x = ~0ULL;
+    __asm__ volatile("ldrb %w0, [%1, #3]" : "+r"(x) : "r"(page) : "memory");
+    CHECK_U64("ldrb zero-extends", x, reg_at(3, 1));
+
+    reset();
+    __asm__ volatile("ldrsh %0, [%1, #0x10]" : "=r"(x) : "r"(page) : "memory");
+    CHECK_U64("ldrsh x sign-extends", x, (uint64_t)(int64_t)(int16_t)reg_at(0x10, 2));
+
+    reset();
+    __asm__ volatile("ldrsb %w0, [%1, #0x11]" : "=r"(x) : "r"(page) : "memory");
+    CHECK_U64("ldrsb w sign-extends to 32", x,
+              (uint64_t)(uint32_t)(int32_t)(int8_t)reg_at(0x11, 1));
+
+    reset();
+    __asm__ volatile("ldrsw %0, [%1, #0x24]" : "=r"(x) : "r"(page) : "memory");
+    CHECK_U64("ldrsw", x, (uint64_t)(int64_t)(int32_t)reg_at(0x24, 4));
+
+    reset();
+    __asm__ volatile("str %w0, [%1, #0x100]" :: "r"(0xCAFEBABEu), "r"(page) : "memory");
+    CHECK_U64("str w off", last.off, 0x100);
+    CHECK_U64("str w value", reg_at(0x100, 4), 0xCAFEBABEu);
+
+    reset();
+    __asm__ volatile("str wzr, [%0, #0x104]" :: "r"(page) : "memory");
+    CHECK_U64("str wzr writes zero", reg_at(0x104, 4), 0);
+    CHECK_U64("str wzr size", last.size, 4);
+
+    reset();
+    __asm__ volatile("strh %w0, [%1, #0x22]" :: "r"(0x12345678u), "r"(page) : "memory");
+    CHECK_U64("strh truncates", reg_at(0x22, 2), 0x5678);
+    CHECK_U64("strh leaves next byte", regs[0x24], (uint8_t)(0x80 + 0x24 * 7));
+
+    reset();
+    __asm__ volatile("stur %0, [%1, #-8]" :: "r"(0x1122334455667788ULL), "r"(page + 0x208) : "memory");
+    CHECK_U64("stur x off", last.off, 0x200);
+    CHECK_U64("stur x value", reg_at(0x200, 8), 0x1122334455667788ULL);
+
+    reset();
+    x = 0x30;
+    __asm__ volatile("ldr %w0, [%1, %2]" : "=r"(w) : "r"(page), "r"(x) : "memory");
+    CHECK_U64("ldr reg offset", last.off, 0x30);
+    CHECK_U64("ldr reg offset value", w, reg_at(0x30, 4));
+
+    reset();
+    x = 0x0C;
+    __asm__ volatile("ldr %w0, [%1, %2, lsl #2]" : "=r"(w) : "r"(page), "r"(x) : "memory");
+    CHECK_U64("ldr reg offset scaled", last.off, 0x30);
+
+    reset();
+    w = 0x08;
+    __asm__ volatile("str %w0, [%1, %w2, uxtw]" :: "r"(0xABCDu), "r"(page), "r"(w) : "memory");
+    CHECK_U64("str uxtw offset", last.off, 0x08);
+
+    reset();
+    base = (uint64_t)(uintptr_t)(page + 0x300);
+    __asm__ volatile("ldr %w0, [%1, #8]!" : "=r"(w), "+r"(base) :: "memory");
+    CHECK_U64("pre-index off", last.off, 0x308);
+    CHECK_U64("pre-index writeback", base, (uint64_t)(uintptr_t)(page + 0x308));
+
+    reset();
+    base = (uint64_t)(uintptr_t)(page + 0x300);
+    __asm__ volatile("str %w1, [%0], #-4" : "+r"(base) : "r"(7u) : "memory");
+    CHECK_U64("post-index off", last.off, 0x300);
+    CHECK_U64("post-index writeback", base, (uint64_t)(uintptr_t)(page + 0x2FC));
+
+    reset();
+    __asm__ volatile("ldp %w0, %w1, [%2, #0x50]" : "=r"(x), "=r"(y) : "r"(page) : "memory");
+    CHECK_U64("ldp w first", x, reg_at(0x50, 4));
+    CHECK_U64("ldp w second", y, reg_at(0x54, 4));
+    CHECK_U64("ldp reads", last.reads, 2);
+
+    reset();
+    __asm__ volatile("stp %0, %1, [%2, #0x60]" :: "r"(1ULL), "r"(2ULL), "r"(page) : "memory");
+    CHECK_U64("stp x first", reg_at(0x60, 8), 1);
+    CHECK_U64("stp x second", reg_at(0x68, 8), 2);
+
+    reset();
+    base = (uint64_t)(uintptr_t)(page + 0x400);
+    __asm__ volatile("stp %w1, %w2, [%0, #-8]!" : "+r"(base) : "r"(3u), "r"(4u) : "memory");
+    CHECK_U64("stp pre-index first", reg_at(0x3F8, 4), 3);
+    CHECK_U64("stp pre-index second", reg_at(0x3FC, 4), 4);
+    CHECK_U64("stp pre-index writeback", base, (uint64_t)(uintptr_t)(page + 0x3F8));
+
+    reset();
+    __asm__ volatile("ldar %w0, [%1]" : "=r"(w) : "r"(page + 0x70) : "memory");
+    CHECK_U64("ldar", w, reg_at(0x70, 4));
+
+    reset();
+    __asm__ volatile("stlr %w0, [%1]" :: "r"(0x55u), "r"(page + 0x74) : "memory");
+    CHECK_U64("stlr", reg_at(0x74, 4), 0x55);
+
+    reset();
+    __asm__ volatile("prfm pldl1keep, [%0, #0x80]" :: "r"(page) : "memory");
+    CHECK_U64("prfm touches nothing", last.reads + last.writes, 0);
+
+    {
+        float f;
+        double d;
+        reset();
+        memcpy(regs + 0x90, &(float){1.5f}, 4);
+        __asm__ volatile("ldr %s0, [%1, #0x90]" : "=w"(f) : "r"(page) : "memory");
+        CHECK_U64("ldr s", f == 1.5f, 1);
+        reset();
+        d = 2.25;
+        __asm__ volatile("str %d0, [%1, #0x98]" :: "w"(d), "r"(page) : "memory");
+        CHECK_U64("str d", reg_at(0x98, 8), 0x4002000000000000ULL);
+    }
+
+    /* What gcc makes of a plain volatile read-modify-write. */
+    reset();
+    {
+        volatile uint32_t *r = (volatile uint32_t *)(page + 0x120);
+        uint32_t before = (uint32_t)reg_at(0x120, 4);
+        *r |= 0x10;
+        CHECK_U64("volatile |= ", reg_at(0x120, 4), before | 0x10);
+        CHECK_U64("volatile |= reads", last.reads, 1);
+        CHECK_U64("volatile |= writes", last.writes, 1);
+    }
+}
+#endif
+
+#if defined(__x86_64__)
+static void test_x64(void)
+{
+    volatile uint32_t *r = (volatile uint32_t *)(page + 0x40);
+    uint32_t w;
+    reset();
+    w = *r;
+    CHECK_U64("mov r32, [m] off", last.off, 0x40);
+    CHECK_U64("mov r32, [m] value", w, reg_at(0x40, 4));
+    reset();
+    *r = 0xCAFEBABEu;
+    CHECK_U64("mov [m], r32", reg_at(0x40, 4), 0xCAFEBABEu);
+}
+#endif
+
+int main(void)
+{
+    page = mmap(NULL, 4096, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (page == MAP_FAILED || !AddVectoredExceptionHandler(1, handler)) {
+        printf("FAIL: setup\n");
+        return 1;
+    }
+#if defined(__aarch64__)
+    test_a64();
+#elif defined(__x86_64__)
+    test_x64();
+#endif
+    if (unhandled) {
+        printf("FAIL: %d undecoded access(es)\n", unhandled);
+        failures++;
+    }
+    printf("%d failure(s)\n", failures);
+    return failures != 0;
+}
