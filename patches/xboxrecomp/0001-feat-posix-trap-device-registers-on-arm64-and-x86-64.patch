diff --git a/src/apu/apu_mmio_hook.c b/src/apu/apu_mmio_hook.c
index 46cc2c5..fa05ca3 100644
--- a/src/apu/apu_mmio_hook.c
+++ b/src/apu/apu_mmio_hook.c
@@ -6,6 +6,7 @@
  */
 
 #include "apu.h"
+#include "../platform/mmio_decode.h"
 #include <stdio.h>
 #include <stdlib.h>
 #include <stdbool.h>
@@ -15,11 +16,10 @@
  * platform's MMIO hook is active, so define it before the #if guard. */
 MCPXAPUState *g_apu_state = NULL;
 
-/* The MMIO hook is a Win32-VEH x86-64 instruction decoder. On Linux the
- * equivalent goes through sigaction + ucontext_t (Stage 2 / main.c). For
- * now the whole body is Windows-only so apu_emu links on Debian. */
-#if defined(_WIN32)
-#include <windows.h>
+/* The MMIO hook decodes the faulting instruction (mmio_decode.h): a Win32
+ * VEH on Windows, the SIGSEGV handler behind AddVectoredExceptionHandler on
+ * Linux. Hosts with no decoder get no hook. */
+#if defined(MMIO_TRAP_SUPPORTED)
 
 /* APU MMIO base in Xbox VA space */
 #define APU_MMIO_BASE  0xFE800000u
@@ -32,6 +32,8 @@ static int g_apu_mmio_read_count = 0;
 static int g_apu_mmio_write_count = 0;
 static int g_apu_mmio_decode_fail = 0;
 
+#if defined(_WIN32)
+
 /* ============================================================
  * x86-64 register access helpers (same as NV2A hook)
  * ============================================================ */
@@ -254,6 +256,38 @@ static bool apu_decode_and_handle(PCONTEXT ctx, uint32_t mmio_offset, int is_wri
  * Public API (called from VEH in main.c)
  * ============================================================ */
 
+#else /* POSIX: the shared decoder in mmio_decode.h */
+
+static uint64_t apu_trap_read(void *dev, uint32_t off, int size)
+{
+    g_apu_mmio_read_count++;
+    return mcpx_apu_mmio_read((MCPXAPUState *)dev, off, (unsigned)size);
+}
+
+static void apu_trap_write(void *dev, uint32_t off, uint64_t val, int size)
+{
+    g_apu_mmio_write_count++;
+    mcpx_apu_mmio_write((MCPXAPUState *)dev, off, val, (unsigned)size);
+}
+
+static bool apu_decode_and_handle(PCONTEXT ctx, uint32_t mmio_offset, int is_write)
+{
+    (void)is_write;
+    if (!g_apu_state) return false;
+    if (mmio_emulate(ctx, mmio_offset, g_apu_state, apu_trap_read, apu_trap_write))
+        return true;
+    g_apu_mmio_decode_fail++;
+    if (g_apu_mmio_decode_fail <= 20) {
+        const uint8_t *ip = mmio_ctx_pc(ctx);
+        fprintf(stderr, "[APU] MMIO decode fail at PC=%p: %02X %02X %02X %02X\n",
+                (void *)ip, ip[0], ip[1], ip[2], ip[3]);
+        fflush(stderr);
+    }
+    return false;
+}
+
+#endif /* _WIN32 */
+
 bool apu_hook_handle_mmio(PCONTEXT ctx, uintptr_t fault_addr,
                           uint32_t fault_xbox_va, int is_write)
 {
@@ -279,4 +313,4 @@ bool apu_hook_handle_mmio(PCONTEXT ctx, uintptr_t fault_addr,
     return ok;
 }
 
-#endif /* _WIN32 */
+#endif /* MMIO_TRAP_SUPPORTED */
