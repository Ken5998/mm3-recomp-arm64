diff --git a/src/platform/mmio_decode_a64.h b/src/platform/mmio_decode_a64.h
new file mode 100644
index 0000000..a65808d
--- /dev/null
+++ b/src/platform/mmio_decode_a64.h
@@ -0,0 +1,333 @@
+/*
+ * mmio_decode_a64.h -- the AArch64 half of mmio_decode.h.
+ *
+ * On an arm64 host the generated code reaches a trapped register with an
+ * ordinary A64 load or store, so this decodes those instead of x86. A64 is
+ * the easier of the two: every instruction is four bytes, and a read-modify-
+ * write the x86 decoder has to service in one fault (OR [reg], r) arrives
+ * here as a separate load and store, each its own fault.
+ *
+ * Covered: LDR/STR of every width (unsigned offset, unscaled, register
+ * offset, pre- and post-index), the sign-extending loads, LDP/STP/LDPSW,
+ * LDAR/STLR/LDAPR, PRFM (skipped), and the FP/SIMD forms of the same
+ * addressing modes, whose B/H/S/D/Q registers come from the signal frame's
+ * FPSIMD record. Anything else -- exclusives, atomics, structure loads --
+ * returns 0, as the x86 decoder does: stepping over an instruction nobody
+ * decoded corrupts the guest silently.
+ *
+ * The device offset is taken from the decoded effective address, not the
+ * fault address alone: for a pair the fault may name the second register's
+ * half, and the access starts at the first.
+ *
+ * Included by mmio_decode.h; not meant to be included on its own.
+ */
+#ifndef MMIO_DECODE_A64_H
+#define MMIO_DECODE_A64_H
+
+#include <stdint.h>
+#include <string.h>
+#include <ucontext.h>
+
+/* Set by the SIGSEGV/SIGBUS handler in win32_compat.c before it calls the
+ * registered handlers: the address the access faulted on. */
+extern __thread uintptr_t g_posix_fault_address;
+
+#define MMIO_A64_UC(c) ((ucontext_t *)(c))
+
+/* The signal frame's extension records (asm/sigcontext.h), spelled out so
+ * this header needs no kernel headers. */
+#define MMIO_A64_FPSIMD_MAGIC 0x46508001u
+#define MMIO_A64_ESR_MAGIC    0x45535201u
+
+struct mmio_a64_ctx_head { uint32_t magic, size; };
+
+static inline void *mmio_a64_record(PCONTEXT ctx, uint32_t magic)
+{
+    uint8_t *p = (uint8_t *)MMIO_A64_UC(ctx)->uc_mcontext.__reserved;
+    uint8_t *end = p + sizeof MMIO_A64_UC(ctx)->uc_mcontext.__reserved;
+    while (p + sizeof(struct mmio_a64_ctx_head) <= end) {
+        struct mmio_a64_ctx_head *h = (struct mmio_a64_ctx_head *)p;
+        if (h->magic == 0 || h->size < sizeof *h)
+            return NULL;
+        if (h->magic == magic)
+            return h;
+        p += h->size;
+    }
+    return NULL;
+}
+
+/* Vn as 16 bytes, little-endian, or NULL if the frame carries no FPSIMD
+ * record (it always does on Linux; the check is for emulators). */
+static inline uint8_t *mmio_a64_vreg(PCONTEXT ctx, int n)
+{
+    uint8_t *rec = (uint8_t *)mmio_a64_record(ctx, MMIO_A64_FPSIMD_MAGIC);
+    /* head (8) + fpsr (4) + fpcr (4), then __uint128_t vregs[32] */
+    return rec ? rec + 16 + 16 * (size_t)n : NULL;
+}
+
+/* 1 for a store, 0 for a load, -1 when the frame does not say. */
+static inline int mmio_a64_esr_is_write(PCONTEXT ctx)
+{
+    uint8_t *rec = (uint8_t *)mmio_a64_record(ctx, MMIO_A64_ESR_MAGIC);
+    uint64_t esr, ec;
+    if (!rec)
+        return -1;
+    memcpy(&esr, rec + 8, sizeof esr);
+    ec = esr >> 26;
+    if (ec != 0x24 && ec != 0x25)       /* data abort, lower / same EL */
+        return -1;
+    return (int)((esr >> 6) & 1);       /* WnR */
+}
+
+static inline uint64_t mmio_a64_x(PCONTEXT ctx, int r)
+{
+    return r == 31 ? 0 : MMIO_A64_UC(ctx)->uc_mcontext.regs[r];
+}
+
+/* Rn as a base register: 31 is SP there, not XZR. */
+static inline uint64_t mmio_a64_base(PCONTEXT ctx, int r)
+{
+    return r == 31 ? MMIO_A64_UC(ctx)->uc_mcontext.sp
+                   : MMIO_A64_UC(ctx)->uc_mcontext.regs[r];
+}
+
+static inline void mmio_a64_set_base(PCONTEXT ctx, int r, uint64_t v)
+{
+    if (r == 31) MMIO_A64_UC(ctx)->uc_mcontext.sp = v;
+    else         MMIO_A64_UC(ctx)->uc_mcontext.regs[r] = v;
+}
+
+static inline void mmio_a64_set_x(PCONTEXT ctx, int r, uint64_t v)
+{
+    if (r != 31)
+        MMIO_A64_UC(ctx)->uc_mcontext.regs[r] = v;
+}
+
+static inline int64_t mmio_a64_sext(uint64_t v, int bits)
+{
+    return (int64_t)(v << (64 - bits)) >> (64 - bits);
+}
+
+/* One register's worth of an access, `bytes` wide at device offset `off`.
+ * gpr: Rt is a general register; otherwise Vt, whose upper bytes a load
+ * clears. sext: sign-extend a load to 32 (4) or 64 (8) bits, 0 for none. */
+static inline int mmio_a64_xfer(PCONTEXT ctx, int load, int gpr, int rt,
+                                int bytes, int sext, uint32_t off, void *dev,
+                                mmio_read_fn rd, mmio_write_fn wr)
+{
+    if (gpr) {
+        if (load) {
+            uint64_t v = rd(dev, off, bytes);
+            if (bytes < 8)
+                v &= (1ULL << (bytes * 8)) - 1;
+            if (sext) {
+                v = (uint64_t)mmio_a64_sext(v, bytes * 8);
+                if (sext == 4)
+                    v &= 0xFFFFFFFFULL;
+            }
+            mmio_a64_set_x(ctx, rt, v);
+        } else {
+            uint64_t v = mmio_a64_x(ctx, rt);
+            if (bytes < 8)
+                v &= (1ULL << (bytes * 8)) - 1;
+            wr(dev, off, v, bytes);
+        }
+        return 1;
+    } else {
+        uint8_t *vr = mmio_a64_vreg(ctx, rt);
+        int done;
+        if (!vr)
+            return 0;
+        if (load)
+            memset(vr, 0, 16);
+        for (done = 0; done < bytes; done += bytes > 8 ? 8 : bytes) {
+            int n = bytes > 8 ? 8 : bytes;
+            uint64_t v = 0;
+            if (load) {
+                v = rd(dev, off + (uint32_t)done, n);
+                memcpy(vr + done, &v, (size_t)n);
+            } else {
+                memcpy(&v, vr + done, (size_t)n);
+                wr(dev, off + (uint32_t)done, v, n);
+            }
+        }
+        return 1;
+    }
+}
+
+/* 1 if the instruction at the faulting PC was serviced and PC advanced past
+ * it. off is the device offset of g_posix_fault_address. */
+static inline int mmio_emulate(PCONTEXT ctx, uint32_t off, void *dev,
+                               mmio_read_fn rd, mmio_write_fn wr)
+{
+    uint64_t *pc = (uint64_t *)&MMIO_A64_UC(ctx)->uc_mcontext.pc;
+    uint32_t insn;
+    int rt, rn, size, opc, vbit, load, gpr, bytes, sext = 0;
+    uint64_t base, ea;
+    int wb = 0;
+    uint64_t wb_value = 0;
+
+    if (!rd || !wr)
+        return 0;
+    memcpy(&insn, (const void *)(uintptr_t)*pc, sizeof insn);
+    rt   = (int)(insn & 31);
+    rn   = (int)((insn >> 5) & 31);
+    vbit = (int)((insn >> 26) & 1);
+    gpr  = !vbit;
+    base = mmio_a64_base(ctx, rn);
+
+    /* ---- LDP/STP/LDPSW/LDNP/STNP: opc 101 V 0 type L imm7 Rt2 Rn Rt ---- */
+    if ((insn & 0x3A000000u) == 0x28000000u) {
+        int type = (int)((insn >> 23) & 3);       /* 00 nt, 01 post, 10 off, 11 pre */
+        int popc = (int)(insn >> 30);
+        int rt2  = (int)((insn >> 10) & 31);
+        int64_t imm7 = mmio_a64_sext((insn >> 15) & 0x7F, 7);
+        int scale;
+        load = (int)((insn >> 22) & 1);
+        if (gpr) {
+            if (popc == 3) return 0;
+            scale = popc == 2 ? 3 : 2;
+            if (popc == 1) {                       /* LDPSW */
+                if (!load || type == 0) return 0;
+                sext = 8;
+            }
+        } else {
+            if (popc == 3) return 0;
+            scale = 2 + popc;                      /* S, D, Q */
+        }
+        bytes = 1 << scale;
+        ea = type == 1 ? base : base + (uint64_t)(imm7 * bytes);
+        if (type == 1 || type == 3) {
+            wb = 1;
+            wb_value = base + (uint64_t)(imm7 * bytes);
+        }
+        off += (uint32_t)(ea - g_posix_fault_address);
+        if (!mmio_a64_xfer(ctx, load, gpr, rt, bytes, sext, off, dev, rd, wr) ||
+            !mmio_a64_xfer(ctx, load, gpr, rt2, bytes, sext,
+                           off + (uint32_t)bytes, dev, rd, wr))
+            return 0;
+        if (wb)
+            mmio_a64_set_base(ctx, rn, wb_value);
+        *pc += 4;
+        return 1;
+    }
+
+    /* ---- LDAR/STLR: size 001000 1 L 0 11111 1 11111 Rn Rt ---- */
+    if ((insn & 0x3FBFFC00u) == 0x089FFC00u) {
+        bytes = 1 << (insn >> 30);
+        load = (int)((insn >> 22) & 1);
+        off += (uint32_t)(base - g_posix_fault_address);
+        if (!mmio_a64_xfer(ctx, load, 1, rt, bytes, 0, off, dev, rd, wr))
+            return 0;
+        __atomic_thread_fence(__ATOMIC_SEQ_CST);
+        *pc += 4;
+        return 1;
+    }
+
+    /* ---- LDAPR: size 111000 101 11111 110000 Rn Rt ---- */
+    if ((insn & 0x3FFFFC00u) == 0x38BFC000u) {
+        bytes = 1 << (insn >> 30);
+        off += (uint32_t)(base - g_posix_fault_address);
+        if (!mmio_a64_xfer(ctx, 1, 1, rt, bytes, 0, off, dev, rd, wr))
+            return 0;
+        *pc += 4;
+        return 1;
+    }
+
+    /* ---- single register: size 111 V 0x opc ... ---- */
+    if ((insn & 0x3A000000u) != 0x38000000u)
+        return 0;
+    size = (int)(insn >> 30);
+    opc  = (int)((insn >> 22) & 3);
+
+    if (insn & (1u << 24)) {
+        /* unsigned scaled imm12 */
+        uint64_t imm12 = (insn >> 10) & 0xFFF;
+        int scale = gpr ? size : (size | ((opc & 2) << 1));
+        ea = base + (imm12 << scale);
+    } else if ((insn & 0x00200C00u) == 0x00200800u) {
+        /* register offset: Rm, option, S */
+        int rm = (int)((insn >> 16) & 31);
+        int option = (int)((insn >> 13) & 7);
+        int s = (int)((insn >> 12) & 1);
+        int scale = gpr ? size : (size | ((opc & 2) << 1));
+        uint64_t m = mmio_a64_x(ctx, rm);
+        switch (option) {
+        case 2: m = (uint32_t)m; break;                                   /* UXTW */
+        case 3: case 7: break;                                            /* LSL/SXTX */
+        case 6: m = (uint64_t)(int64_t)(int32_t)(uint32_t)m; break;       /* SXTW */
+        default: return 0;
+        }
+        ea = base + (s ? m << scale : m);
+    } else if ((insn & 0x00200000u) == 0) {
+        int64_t imm9 = mmio_a64_sext((insn >> 12) & 0x1FF, 9);
+        switch ((insn >> 10) & 3) {
+        case 0: ea = base + (uint64_t)imm9; break;                        /* unscaled */
+        case 1: ea = base; wb = 1; wb_value = base + (uint64_t)imm9; break;  /* post */
+        case 3: ea = base + (uint64_t)imm9; wb = 1; wb_value = ea; break;    /* pre */
+        default: return 0;                                                /* unprivileged */
+        }
+    } else {
+        return 0;                                  /* atomics, PAC loads */
+    }
+
+    if (gpr) {
+        bytes = 1 << size;
+        switch (opc) {
+        case 0: load = 0; break;
+        case 1: load = 1; break;
+        case 2:
+            if (size == 3) {                       /* PRFM: nothing to do */
+                *pc += 4;
+                return 1;
+            }
+            load = 1; sext = 8;                    /* LDRS* to Xt */
+            break;
+        default:
+            if (size >= 2) return 0;
+            load = 1; sext = 4;                    /* LDRSB/LDRSH to Wt */
+            break;
+        }
+    } else {
+        bytes = 1 << (size | ((opc & 2) << 1));    /* B H S D Q */
+        if (bytes > 16) return 0;
+        load = opc & 1;
+    }
+
+    off += (uint32_t)(ea - g_posix_fault_address);
+    if (!mmio_a64_xfer(ctx, load, gpr, rt, bytes, sext, off, dev, rd, wr))
+        return 0;
+    if (wb)
+        mmio_a64_set_base(ctx, rn, wb_value);
+    *pc += 4;
+    return 1;
+}
+
+/* 1 for a store, 0 for a load: the frame's ESR when it has one, else the
+ * instruction itself. Loads are the safer guess for anything undecodable. */
+static inline int mmio_a64_is_write(PCONTEXT ctx)
+{
+    int w = mmio_a64_esr_is_write(ctx);
+    uint32_t insn;
+    if (w >= 0)
+        return w;
+    memcpy(&insn, (const void *)(uintptr_t)MMIO_A64_UC(ctx)->uc_mcontext.pc,
+           sizeof insn);
+    if ((insn & 0x3A000000u) == 0x28000000u)   /* pair */
+        return !((insn >> 22) & 1);
+    if ((insn & 0x3FBFFC00u) == 0x089FFC00u)   /* LDAR/STLR */
+        return !((insn >> 22) & 1);
+    if ((insn & 0x3A000000u) == 0x38000000u) { /* single register */
+        int opc = (int)((insn >> 22) & 3);
+        return ((insn >> 26) & 1) ? !(opc & 1) : opc == 0;
+    }
+    return 0;
+}
+
+/* The faulting instruction, for "undecoded access" reports. */
+static inline const uint8_t *mmio_ctx_pc(PCONTEXT ctx)
+{
+    return (const uint8_t *)(uintptr_t)MMIO_A64_UC(ctx)->uc_mcontext.pc;
+}
+
+#endif /* MMIO_DECODE_A64_H */
