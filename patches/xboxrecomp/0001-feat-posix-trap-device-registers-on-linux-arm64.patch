index f8cba31..e3cf343 100644
--- a/src/nv2a/nv2a_mmio_hook.c
+++ b/src/nv2a/nv2a_mmio_hook.c
@@ -8,6 +8,7 @@
 #include "nv2a_mmio_hook.h"
 #include "nv2a_state.h"
 #include "platform/mmio_decode.h"
+#include "platform/mmio_decode_a64.h"
 #include <stdio.h>
 
 /* NV2A MMIO base in Xbox VA space */
@@ -21,7 +22,7 @@ static volatile LONG g_mmio_read_count = 0;
