 #include "../kernel/xbox_memory_layout.h"
 #include "../kernel/kernel.h"
 #include <stdio.h>
@@ -500,6 +501,16 @@ int xbox_NicHandleMmio(void *ctx, uint32_t va)
         fflush(stderr);
     }
     return ok;
+#elif defined(__aarch64__)
+    /* ctx is the SIGSEGV handler's ucontext (src/host/host.c). */
+    ucontext_t *uc = (ucontext_t *)ctx;
+    int ok = mmio_emulate_a64(uc, va - NIC_BASE, NULL, nic_read, nic_write);
+    if (!ok && s.decode_fail++ < 20) {
