+                *(const uint32_t *)(uintptr_t)A64_CTX_PC(uc), mmio_offset, is_write);
+        fflush(stderr);
+    }
+    return false;
+}
+#else
 static bool decode_and_handle(PCONTEXT ctx, uint32_t mmio_offset, int is_write)
 {
     NV2AState *state = nv2a_get_state();
@@ -76,6 +95,7 @@ static bool decode_and_handle(PCONTEXT ctx, uint32_t mmio_offset, int is_write)
     }
     return false;
 }
+#endif
 
 /* ============================================================
  * Public API
@@ -118,7 +138,7 @@ bool nv2a_hook_handle_mmio(PCONTEXT ctx, uintptr_t fault_addr,
     return handled;
 }
 
-#else /* no x86-64 instruction decoder for this host */
+#else /* no instruction decoder for this host */
 
 bool nv2a_hook_pvideo_snapshot(uint32_t regs[0x1000 / 4])
 { (void)regs; return false; }
@@ -131,4 +151,4 @@ bool nv2a_hook_handle_mmio(PCONTEXT ctx, uintptr_t fault_addr,
                            uint32_t fault_xbox_va, int is_write)
 { (void)ctx; (void)fault_addr; (void)fault_xbox_va; (void)is_write; return false; }
 
