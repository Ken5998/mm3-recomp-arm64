From 2f8ab3a20b7165a275b3ea8f2793e034b9258fff Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kenan=20Kasumovi=C4=87?=
 <46025606+Ken5998@users.noreply.github.com>
Date: Mon, 9 Nov 2026 13:02:16 +0000
Subject: [PATCH 1/5] feat(posix): trap device registers on linux arm64

The vectored exception handlers win32_compat emulates decode x86-64, so on
arm64 Linux nothing served a trapped device page and NV2A was never set up.
The host now installs a SIGSEGV/SIGBUS handler there that routes a fault as
mmio_handler does, NIC, OHCI, PVIDEO and APU, each served by the A64 decoder
on the handler's ucontext; faults it does not own go to the previous
handler. The AC'97 bus-master page has no trap flag to step its write with,
so the store is decoded and done with the reset bits masked.

A trapped load into an FP/SIMD register also lands in the frame's SVE
record: once a thread has used SVE, as glibc does on the Snapdragon 8 Gen
2, sigreturn restores Vn from Zn.
---
 src/host/host.c                 | 115 ++++++++++++++++++++++++++++++++
 src/kernel/xbox_memory_layout.c |  66 ++++++++++++++++++
 src/kernel/xbox_memory_layout.h |   4 ++
 src/net/nvnet.c                 |  11 +++
 src/nv2a/nv2a_mmio_hook.c       |  26 +++++++-
 src/platform/mmio_decode_a64.h  |  57 +++++++++++++++-
 6 files changed, 273 insertions(+), 6 deletions(-)

diff --git a/src/host/host.c b/src/host/host.c
index 8aa992f..afda4eb 100644
--- a/src/host/host.c
+++ b/src/host/host.c
@@ -84,6 +84,110 @@ static LONG CALLBACK mmio_handler(PEXCEPTION_POINTERS info)
     return EXCEPTION_CONTINUE_SEARCH;
 }
 
+#if defined(__aarch64__) && !defined(_WIN32)
+/* POSIX arm64: no vectored exception handlers (win32_compat's only decode
+ * x86-64), so the device pages are served from a SIGSEGV/SIGBUS handler of
+ * our own with the A64 decoder (src/platform/mmio_decode_a64.h): the same
+ * routing as mmio_handler above, each device's hook taking the ucontext in
+ * place of a CONTEXT. Faults it does not own go to the previous handler. */
+#include <signal.h>
+#include "platform/mmio_decode_a64.h"
+
+extern bool apu_hook_handle_mmio_posix(void *ucv, uintptr_t fault_addr,
+                                       uint32_t fault_xbox_va, int is_write);
+
+static struct sigaction s_prev_segv, s_prev_bus;
+static int s_a64_installed;
+
+static int a64_mmio(ucontext_t *uc, uintptr_t fault_address)
+{
+    uint32_t guest_address, physical;
+    int alias, is_write = 0;
+
+    if (xbox_Ac97PosixFault(uc, fault_address))
+        return 1;
+    if (fault_address < (uintptr_t)g_xbox_mem_offset ||
+        fault_address - (uintptr_t)g_xbox_mem_offset > UINT32_MAX)
+        return 0;
+    guest_address = (uint32_t)(fault_address - (uintptr_t)g_xbox_mem_offset);
+    /* The decoder reads the direction from the opcode; the resolve and the
+     * PVIDEO read below need it first, from the frame's ESR record (WnR). */
+    {
+        unsigned char *p = (unsigned char *)uc->uc_mcontext.__reserved;
+        unsigned char *end = p + sizeof(uc->uc_mcontext.__reserved);
+        while (p + 16 <= end) {
+            uint32_t magic, size;
+            memcpy(&magic, p, 4);
+            memcpy(&size, p + 4, 4);
+            if (magic == 0 || size < 8) break;
+            if (magic == 0x45535201u) {                    /* ESR_MAGIC */
+                uint64_t esr;
+                memcpy(&esr, p + 8, 8);
+                is_write = (int)((esr >> 6) & 1);
+                break;
+            }
+            p += size;
+        }
+    }
+    alias = xbox_IoMappingResolve(guest_address, is_write, &physical);
+    if (alias < 0) return 0;
+    if (alias) guest_address = physical;
+    if (xbox_NicOwnsAddress(guest_address))
+        return xbox_NicHandleMmio(uc, guest_address);
+    if (xbox_OhciOwnsAddress(guest_address))
+        return xbox_OhciHandleMmio(uc, guest_address);
+    if (guest_address == PVIDEO_PAGE + 0x700u && !is_write &&
+        !getenv("RECOMP_FB_WINDOW")) {
+        NV2AState *gpu = nv2a_get_state();
+        if (gpu) {
+            uint64_t buffer = nv2a_mmio_read(gpu, 0x8700, 4);
+            nv2a_mmio_write(gpu, 0x8700, buffer & ~0x11u, 4);
+        }
+    }
+    if (guest_address >= PVIDEO_PAGE && guest_address < PVIDEO_PAGE + 0x1000u)
+        return nv2a_hook_handle_mmio((PCONTEXT)(void *)uc, fault_address,
+                                     guest_address, is_write);
+    if (g_apu_state &&
+        guest_address >= APU_TRAP_BASE && guest_address < APU_TRAP_END)
+        return apu_hook_handle_mmio_posix(uc, fault_address, guest_address, is_write);
+    return 0;
+}
+
+static void a64_fault(int sig, siginfo_t *si, void *raw)
+{
+    struct sigaction *prev = sig == SIGBUS ? &s_prev_bus : &s_prev_segv;
+
+    if (a64_mmio((ucontext_t *)raw, (uintptr_t)si->si_addr))
+        return;
+    if (prev->sa_flags & SA_SIGINFO) {
+        if (prev->sa_sigaction) { prev->sa_sigaction(sig, si, raw); return; }
+    } else if (prev->sa_handler != SIG_DFL && prev->sa_handler != SIG_IGN) {
+        prev->sa_handler(sig);
+        return;
+    }
+    /* Nobody else wants it: die of it as if no handler were installed. */
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+static int a64_install(void)
+{
+    struct sigaction sa;
+
+    if (s_a64_installed)
+        return 1;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = a64_fault;
+    sa.sa_flags = SA_SIGINFO | SA_NODEFER | SA_ONSTACK;
+    sigemptyset(&sa.sa_mask);
+    if (sigaction(SIGSEGV, &sa, &s_prev_segv) != 0 ||
+        sigaction(SIGBUS, &sa, &s_prev_bus) != 0)
+        return 0;
+    s_a64_installed = 1;
+    return 1;
+}
+#endif
+
 int xbox_HostHardwareInit(void)
 {
     if (getenv("RECOMP_AC97_READY")) {
@@ -93,7 +197,12 @@ int xbox_HostHardwareInit(void)
             return 0;
         }
     }
+#if defined(__aarch64__) && !defined(_WIN32)
+    s_mmio_veh = a64_install() ? (PVOID)&s_a64_installed : NULL;
+    (void)mmio_handler;
+#else
     s_mmio_veh = AddVectoredExceptionHandler(1, mmio_handler);
+#endif
     if (!s_mmio_veh) {
         fprintf(stderr, "[HOST] could not install MMIO exception handler\n");
         xbox_HostHardwareShutdown();
@@ -111,7 +220,13 @@ int xbox_HostHardwareInit(void)
 void xbox_HostHardwareShutdown(void)
 {
     if (s_mmio_veh) {
+#if defined(__aarch64__) && !defined(_WIN32)
+        sigaction(SIGSEGV, &s_prev_segv, NULL);
+        sigaction(SIGBUS, &s_prev_bus, NULL);
+        s_a64_installed = 0;
+#else
         RemoveVectoredExceptionHandler(s_mmio_veh);
+#endif
         s_mmio_veh = NULL;
     }
     if (g_apu_state) {
diff --git a/src/kernel/xbox_memory_layout.c b/src/kernel/xbox_memory_layout.c
index b4a1fe0..400d85f 100644
--- a/src/kernel/xbox_memory_layout.c
+++ b/src/kernel/xbox_memory_layout.c
@@ -705,6 +705,59 @@ static LONG CALLBACK ac97_write_veh(PEXCEPTION_POINTERS ep)
 /* Arm the trap. Called once the MCPX aperture exists, and only alongside the
  * rest of RECOMP_AC97_READY: a title that never gets as far as resetting a
  * channel has nothing to gain from it, and the page fault costs something. */
+#if defined(__aarch64__) && !defined(_WIN32)
+/* POSIX arm64 has no trap flag to single-step the write with, so the store is
+ * decoded (src/platform/mmio_decode_a64.h) and done here: the page is opened
+ * for it, the value written, the reset bits masked and the page closed again.
+ * Called by the host's SIGSEGV dispatcher (src/host/host.c) with the handler's
+ * ucontext; 1 when the fault was this page's and was serviced. */
+#include "../platform/mmio_decode_a64.h"
+
+static uint64_t ac97_a64_read(void *page, uint32_t off, int size)
+{
+    uint64_t v = 0;
+    memcpy(&v, (char *)page + off, (size_t)size);
+    return v;
+}
+
+static void ac97_a64_write(void *page, uint32_t off, uint64_t v, int size)
+{
+    DWORD old;
+    VirtualProtect(page, AC97_TRAP_BYTES, PAGE_READWRITE, &old);
+    memcpy((char *)page + off, &v, (size_t)size);
+    ac97_clear_reset_bits(page);
+    VirtualProtect(page, AC97_TRAP_BYTES, PAGE_READONLY, &old);
+}
+
+int xbox_Ac97PosixFault(void *ucv, uintptr_t fault)
+{
+    uint32_t physical;
+    uintptr_t canonical, page;
+    int alias;
+
+    if (!g_ac97_page)
+        return 0;
+    alias = fault >= (uintptr_t)g_memory_offset &&
+            fault - (uintptr_t)g_memory_offset <= UINT32_MAX
+        ? xbox_IoMappingResolve((uint32_t)(fault - (uintptr_t)g_memory_offset), 1, &physical) : 0;
+    if (alias < 0)
+        return 0;
+    canonical = alias == 1 ? (uintptr_t)physical + g_memory_offset : fault;
+    if (canonical < (uintptr_t)g_ac97_page ||
+        canonical >= (uintptr_t)g_ac97_page + AC97_TRAP_BYTES)
+        return 0;
+    page = fault & ~(uintptr_t)(AC97_TRAP_BYTES - 1);
+    return mmio_emulate_a64((ucontext_t *)ucv, (uint32_t)(fault - page), (void *)page,
+                            ac97_a64_read, ac97_a64_write);
+}
+#else
+int xbox_Ac97PosixFault(void *ucv, uintptr_t fault)
+{
+    (void)ucv; (void)fault;
+    return 0;
+}
+#endif
+
 static void ac97_arm_write_trap(void)
 {
     DWORD old;
@@ -712,6 +765,19 @@ static void ac97_arm_write_trap(void)
     if (!g_mcpx_memory || g_ac97_page)
         return;
     g_ac97_page = (char *)g_mcpx_memory + AC97_NABM_OFFSET;
+#if defined(__aarch64__) && !defined(_WIN32)
+    /* The host's SIGSEGV dispatcher serves it: no VEH here. */
+    if (!VirtualProtect(g_ac97_page, AC97_TRAP_BYTES, PAGE_READONLY, &old)) {
+        g_ac97_page = NULL;
+        fprintf(stderr, "  AC97: could not arm the bus-master write trap;"
+                        " a channel reset will spin\n");
+        return;
+    }
+    fprintf(stderr, "  AC97: bus-master writes trapped at 0x%08X"
+                    " (channel reset completes on write)\n",
+            XBOX_MCPX_BASE + AC97_NABM_OFFSET);
+    return;
+#endif
     /* First, so it runs before the game target's own crash reporter, which
      * would otherwise print the write as an access violation. */
     g_ac97_veh = AddVectoredExceptionHandler(1, ac97_write_veh);
diff --git a/src/kernel/xbox_memory_layout.h b/src/kernel/xbox_memory_layout.h
index 88bc48d..cb13b67 100644
--- a/src/kernel/xbox_memory_layout.h
+++ b/src/kernel/xbox_memory_layout.h
@@ -504,6 +504,10 @@ void  *xbox_thread_debug_handle(void); /* the game thread, or NULL under inline
 #define XBOX_THREAD_MODE_SPAWN  1
 void xbox_SetThreadMode(int mode);
 
+/* POSIX arm64: service a write fault on the trapped AC'97 bus-master page
+ * from a SIGSEGV handler (ucv is its ucontext). 1 when it was that page's. */
+int xbox_Ac97PosixFault(void *ucv, uintptr_t fault);
+
 #ifdef __cplusplus
 }
 #endif
