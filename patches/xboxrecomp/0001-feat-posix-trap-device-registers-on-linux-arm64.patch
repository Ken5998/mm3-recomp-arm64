diff --git a/src/platform/mmio_decode_a64.h b/src/platform/mmio_decode_a64.h
index 3fdc824..1062667 100644
--- a/src/platform/mmio_decode_a64.h
+++ b/src/platform/mmio_decode_a64.h
@@ -25,6 +25,7 @@
 #define MMIO_DECODE_A64_H
 
 #include <stdint.h>
+#include <string.h>
 
 #if defined(__aarch64__) && !defined(_WIN32)
 
@@ -43,6 +44,7 @@
 #define A64_CTX_SP(uc)   ((uc)->uc_mcontext->__ss.__sp)
 #define A64_CTX_HAS_V 1
 #define A64_CTX_V(uc, n) ((uc)->uc_mcontext->__ns.__v[(n)])
+#define A64_CTX_V_SET(uc, n, v) (A64_CTX_V(uc, n) = (v))
 #elif defined(__linux__)
 #include <ucontext.h>
 #include <asm/sigcontext.h>      /* struct _aarch64_ctx, fpsimd_context */
@@ -73,9 +75,58 @@ static inline __uint128_t *mmio_a64_linux_vregs(ucontext_t *uc)
     }
     return 0;
 }
+/* Zn in the frame's SVE record, *vl bytes long, or 0 when the record carries
+ * no registers. It carries them once the thread has used SVE (glibc's string
+ * functions do on cores that have it, as the Snapdragon 8 Gen 2's do, and
+ * QEMU always fills it), and sigreturn then restores Vn from Zn's low bytes
+ * rather than from the FPSIMD record, so a load must land there too. Records
+ * moved to an extra_context (long vector lengths) are followed. */
+static inline unsigned char *mmio_a64_linux_zreg(ucontext_t *uc, int n, unsigned *vl)
+{
+    unsigned char *p = (unsigned char *)uc->uc_mcontext.__reserved;
+    unsigned char *end = p + sizeof(uc->uc_mcontext.__reserved);
+    while (p + 8 <= end) {
+        uint32_t magic, size;
+        memcpy(&magic, p, 4);
+        memcpy(&size, p + 4, 4);
+        if (magic == 0 || size < 8)
+            break;
+        if (magic == 0x45585401u && size >= 20) {          /* EXTRA_MAGIC */
+            uint64_t datap;
+            uint32_t extra;
+            memcpy(&datap, p + 8, 8);
+            memcpy(&extra, p + 16, 4);
+            p = (unsigned char *)(uintptr_t)datap;
+            end = p + extra;
+            continue;
+        }
+        if (magic == 0x53564501u) {                         /* SVE_MAGIC */
+            uint16_t len;
+            /* head (8), vl (2), flags (2), reserved (4), Z0..Z31 of vl bytes */
+            memcpy(&len, p + 8, 2);
+            if (len < 16 || size < 16 + 32u * len)
+                return 0;
+            *vl = len;
+            return p + 16 + (size_t)n * len;
+        }
+        p += size;
+    }
+    return 0;
+}
+static inline void mmio_a64_linux_vset(ucontext_t *uc, int n, __uint128_t v)
+{
+    unsigned vl;
+    unsigned char *z = mmio_a64_linux_zreg(uc, n, &vl);
+    mmio_a64_linux_vregs(uc)[n] = v;
+    if (z) {                         /* writing Vn clears the rest of Zn */
+        memset(z, 0, vl);
+        memcpy(z, &v, 16);
+    }
+}
 #define A64_CTX_HAS_V 1
 #define A64_CTX_V_OK(uc) (mmio_a64_linux_vregs(uc) != 0)
 #define A64_CTX_V(uc, n) (mmio_a64_linux_vregs(uc)[(n)])
+#define A64_CTX_V_SET(uc, n, v) mmio_a64_linux_vset(uc, n, v)
 #endif
 #ifndef A64_CTX_V_OK
 #define A64_CTX_V_OK(uc) 1
@@ -140,9 +191,9 @@ static inline int mmio_emulate_a64(ucontext_t *uc, uint32_t off, void *dev,
             if (is_load) {
                 if (bytes == 16) {
                     __uint128_t lo = rd(dev, off, 8), hi = rd(dev, off + 8, 8);
-                    A64_CTX_V(uc, rt) = lo | (hi << 64);
+                    A64_CTX_V_SET(uc, rt, lo | (hi << 64));
                 } else {
-                    A64_CTX_V(uc, rt) = rd(dev, off, bytes);
+                    A64_CTX_V_SET(uc, rt, rd(dev, off, bytes));
                 }
             } else {
                 __uint128_t q = A64_CTX_V(uc, rt);
@@ -221,7 +272,7 @@ static inline int mmio_emulate_a64(ucontext_t *uc, uint32_t off, void *dev,
                 b = (uint64_t)(int64_t)(int32_t)b;
             }
 #if A64_CTX_HAS_V
-            if (V) { A64_CTX_V(uc, rt) = a; A64_CTX_V(uc, rt2) = b; } else
+            if (V) { A64_CTX_V_SET(uc, rt, a); A64_CTX_V_SET(uc, rt2, b); } else
 #endif
             {
                 if (rt != 31) *mmio_a64_xreg(uc, rt) = a;
