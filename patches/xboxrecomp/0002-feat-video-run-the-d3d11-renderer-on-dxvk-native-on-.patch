+static void fb_update_title(SDL_Window *win)
+{
+    static Uint32 t0;
+    static LONG f0;
+    Uint32 now = SDL_GetTicks();
+    char tb[192];
+    int i, n = 0;
+    LONG f;
+    if (t0 && now - t0 < 1000)
+        return;
+    f = s_flips;
+    /* s_title holds UTF-32 code points here; SDL wants UTF-8. */
+    for (i = 0; s_title[i] && n < 140; i++) {
+        uint32_t c = (uint32_t)s_title[i];
+        if (c < 0x80) tb[n++] = (char)c;
+        else if (c < 0x800) { tb[n++] = (char)(0xC0 | c >> 6); tb[n++] = (char)(0x80 | (c & 0x3F)); }
+        else { tb[n++] = (char)(0xE0 | (c >> 12 & 0x0F)); tb[n++] = (char)(0x80 | (c >> 6 & 0x3F));
+               tb[n++] = (char)(0x80 | (c & 0x3F)); }
+    }
+    snprintf(tb + n, sizeof tb - (size_t)n, " | FPS: %.1f | draws: %ld",
+             t0 ? (f - f0) * 1000.0 / (now - t0) : 0.0, (long)s_frame_draws);
+    SDL_SetWindowTitle(win, tb);
+    t0 = now;
+    f0 = f;
+}
+
+static int fb_thread(void *unused)
+{
+    SDL_Window *win;
+    int cw, ch;
+    Uint32 flags = SDL_WINDOW_VULKAN | SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI;
+
+    (void)unused;
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO) != 0) {
+        fprintf(stderr, "  [FBWIN] SDL video: %s\n", SDL_GetError());
+        InterlockedExchange(&s_fb_ready, -1);
+        return 0;
+    }
+    fb_initial_size(&cw, &ch);
+    if (getenv("RECOMP_FULLSCREEN"))
+        flags |= SDL_WINDOW_FULLSCREEN_DESKTOP;
+    win = SDL_CreateWindow("Xbox Recomp - Framebuffer", SDL_WINDOWPOS_CENTERED,
+                           SDL_WINDOWPOS_CENTERED, cw, ch, flags);
+    if (!win) {
+        fprintf(stderr, "  [FBWIN] SDL window: %s\n", SDL_GetError());
+        InterlockedExchange(&s_fb_ready, -1);
+        return 0;
+    }
+    if (flags & SDL_WINDOW_FULLSCREEN_DESKTOP)
+        SDL_ShowCursor(SDL_DISABLE);
+    s_hwnd = win;
+    InterlockedExchange(&s_fb_ready, 1);
+    fprintf(stderr, "  [FBWIN] framebuffer window open (%dx%d client)\n", cw, ch);
+
+    for (;;) {
+        SDL_Event e;
+        if (SDL_WaitEventTimeout(&e, 250)) {
+            do
+                fb_event(&e, win);
+            while (SDL_PollEvent(&e));
+        }
+        fb_update_title(win);
+    }
+    return 0;
+}
+
+void xbox_FramebufferWindowStart(void)
+{
+    SDL_Thread *th;
+
+    if (!getenv("RECOMP_FB_WINDOW"))
+        return;
+    if (InterlockedCompareExchange(&s_fb_running, 1, 0) != 0)
+        return;
+    th = SDL_CreateThread(fb_thread, "fb-window", NULL);
+    if (th)
+        SDL_DetachThread(th);
+    else
+        InterlockedExchange(&s_fb_ready, -1);
+}
+
+int xbox_FramebufferWindowWait(void)
+{
+    int i;
+    xbox_FramebufferWindowStart();
+    if (!s_fb_running)
+        return 0;
+    for (i = 0; i < 2000 && !s_fb_ready; i++)
+        SDL_Delay(5);
+    return s_fb_ready > 0;
+}
