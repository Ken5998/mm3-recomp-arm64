+cmake_minimum_required(VERSION 3.20)
+project(d3d11_dxvk_posix_test C)
+# The D3D11 renderer on Linux, up to the first presented frame: DXVK-native's
+# device on Vulkan, every renderer shader through vkd3d's D3DCompile, and the
+# SDL2 window as the swap chain's target. Needs a display and a Vulkan driver
+# (Xvfb and lavapipe do); without a display it skips.
+if(WIN32)
+    message(FATAL_ERROR "This regression covers the Linux renderer")
+endif()
+set(CMAKE_C_STANDARD 11)
+add_subdirectory(../.. runtime)
+add_executable(d3d11_dxvk_posix_test test_main.c)
+target_link_libraries(d3d11_dxvk_posix_test PRIVATE xboxrecomp)
+enable_testing()
+add_test(NAME d3d11_dxvk_posix_test COMMAND d3d11_dxvk_posix_test)
+set_tests_properties(d3d11_dxvk_posix_test PROPERTIES SKIP_RETURN_CODE 77)
diff --git a/tests/d3d11_dxvk_posix/test_main.c b/tests/d3d11_dxvk_posix/test_main.c
new file mode 100644
index 0000000..def0231
--- /dev/null
+++ b/tests/d3d11_dxvk_posix/test_main.c
@@ -0,0 +1,51 @@
+/*
+ * d3d11_dxvk_posix - the D3D11 renderer brought up on Linux.
+ *
+ * nv2a_d3d_init() is the whole of it: it opens the framebuffer window (SDL2),
+ * creates the device through DXVK-native and compiles every shader the
+ * renderer starts with through vkd3d's D3DCompile, stopping at the first one
+ * that fails. A few ticks then present into the window's swap chain.
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "video/nv2a_d3d11.h"
+#include "video/fb_present.h"
+
+/* Provided by the generated title; the renderer pulls in the kernel, which
+ * refers to them. Nothing here calls a guest function. */
+typedef void (*recomp_func_t)(void);
+recomp_func_t recomp_lookup(uint32_t xbox_va);
+recomp_func_t recomp_lookup(uint32_t xbox_va) { (void)xbox_va; return NULL; }
+recomp_func_t recomp_lookup_manual(uint32_t xbox_va);
+recomp_func_t recomp_lookup_manual(uint32_t xbox_va) { (void)xbox_va; return NULL; }
+
+int main(void)
+{
+    unsigned w = 0, h = 0;
+    int i;
+    if (!getenv("DISPLAY") && !getenv("WAYLAND_DISPLAY")) {
+        puts("SKIP: no display");
+        return 77;
+    }
+#if !defined(XBOXRECOMP_DXVK)
+    puts("SKIP: built without DXVK-native");
+    return 77;
+#else
+    setenv("RECOMP_FB_WINDOW", "1", 1);
+    setenv("RECOMP_WINDOW_SIZE", "640x480", 1);
+    if (!nv2a_d3d_init()) {
+        puts("FAIL: nv2a_d3d_init");
+        return 1;
+    }
+    if (!xbox_FramebufferWindowClientSize(&w, &h) || w != 640 || h != 480) {
+        printf("FAIL: client size %ux%u\n", w, h);
+        return 1;
+    }
+    for (i = 0; i < 3; i++)
+        nv2a_d3d_tick();
+    puts("0 failure(s)");
+    return 0;
+#endif
+}
