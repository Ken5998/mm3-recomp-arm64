+static void fb_key(const SDL_KeyboardEvent *k, SDL_Window *win)
+{
+    int down = k->type == SDL_KEYDOWN, vk;
+    SDL_Scancode sc = k->keysym.scancode;
+    if (down && (sc == SDL_SCANCODE_F11 ||
+                 (sc == SDL_SCANCODE_RETURN && (k->keysym.mod & KMOD_ALT)))) {
+        if (!k->repeat)
+            fb_toggle_fullscreen(win);
+        return;
+    }
+    if (!(vk = fb_vk(sc)))
+        return;
+    s_key_down[vk] = (unsigned char)down;
+    /* Windows reports either shift as VK_SHIFT, and the default keymap binds
+     * that; keep the generic codes as the union of the sided ones. */
+    s_key_down[VK_SHIFT] = s_key_down[VK_LSHIFT] | s_key_down[VK_RSHIFT];
+    s_key_down[VK_CONTROL] = s_key_down[VK_LCONTROL] | s_key_down[VK_RCONTROL];
+    s_key_down[VK_MENU] = s_key_down[VK_LMENU] | s_key_down[VK_RMENU];
+    if (down && !k->repeat && getenv("RECOMP_KEY_TRACE")) {
+        static unsigned n;
+        if (n++ < 40) {
+            fprintf(stderr, "  [KEY] down vk=0x%02X\n", (unsigned)vk);
+            fflush(stderr);
+        }
+    }
+}
+
+static void fb_mouse_button(const SDL_MouseButtonEvent *b)
+{
+    unsigned char down = b->type == SDL_MOUSEBUTTONDOWN;
+    switch (b->button) {
+    case SDL_BUTTON_LEFT:   s_key_down[VK_LBUTTON] = down; break;
+    case SDL_BUTTON_RIGHT:  s_key_down[VK_RBUTTON] = down; break;
+    case SDL_BUTTON_MIDDLE: s_key_down[VK_MBUTTON] = down; break;
+    case SDL_BUTTON_X1:     s_key_down[VK_XBUTTON1] = down; break;
+    case SDL_BUTTON_X2:     s_key_down[VK_XBUTTON2] = down; break;
+    }
+}
+
+/* The pointer as a fraction of the window, as WM_MOUSEMOVE reports it. */
+static void fb_mouse_move(const SDL_MouseMotionEvent *m, SDL_Window *win)
+{
+    static int last_x = -1, last_y = -1;
+    int w = 0, h = 0;
+    SDL_GetWindowSize(win, &w, &h);
+    if (w > 0 && h > 0) {
+        s_mouse_x = (float)m->x / (float)w;
+        s_mouse_y = (float)m->y / (float)h;
+    }
+    if (last_x != -1 && (m->x != last_x || m->y != last_y))
+        InterlockedIncrement(&s_mouse_moves);
+    last_x = m->x;
+    last_y = m->y;
+}
