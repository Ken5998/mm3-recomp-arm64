+int xbox_FramebufferWindowClientSize(unsigned *w, unsigned *h)
+{
+    SDL_Window *win = (SDL_Window *)s_hwnd;
+    int cw = 0, ch = 0;
+    if (!win || (SDL_GetWindowFlags(win) & SDL_WINDOW_MINIMIZED))
+        return 0;
+    SDL_Vulkan_GetDrawableSize(win, &cw, &ch);
+    if (cw <= 0 || ch <= 0)
+        return 0;
