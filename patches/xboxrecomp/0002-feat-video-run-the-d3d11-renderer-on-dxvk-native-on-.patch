+/* Closing the window ends the game. (On Windows the next clear opens a new
+ * one; on a handheld launched from Steam a process with no window is just
+ * one more thing to kill.) SIGINT and SIGTERM arrive as SDL_QUIT too. */
+static void fb_quit(void)
+{
+    fprintf(stderr, "  [FBWIN] window closed, exiting\n");
+    fflush(stderr);
+    fflush(stdout);
+    _exit(0);
+}
+
+static void fb_event(const SDL_Event *e, SDL_Window *win)
+{
+    switch (e->type) {
+    case SDL_QUIT:
+        fb_quit();
+        break;
+    case SDL_WINDOWEVENT:
+        switch (e->window.event) {
+        case SDL_WINDOWEVENT_CLOSE:
+            fb_quit();
+            break;
+        /* Switching away with a key held would leave it held for ever. */
+        case SDL_WINDOWEVENT_FOCUS_LOST:
+            memset((void *)s_key_down, 0, sizeof s_key_down);
+            InterlockedExchange(&s_inactive, 1);
+            break;
+        case SDL_WINDOWEVENT_FOCUS_GAINED:
+            InterlockedExchange(&s_inactive, 0);
+            break;
+        }
+        break;
+    case SDL_KEYDOWN:
+    case SDL_KEYUP:
+        fb_key(&e->key, win);
+        break;
+    case SDL_MOUSEMOTION:
+        fb_mouse_move(&e->motion, win);
+        break;
+    case SDL_MOUSEBUTTONDOWN:
+    case SDL_MOUSEBUTTONUP:
+        fb_mouse_button(&e->button);
+        break;
+    }
+}
