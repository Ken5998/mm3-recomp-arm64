diff --git a/src/video/CMakeLists.txt b/src/video/CMakeLists.txt
index a6ccb51..eee2bdc 100644
--- a/src/video/CMakeLists.txt
+++ b/src/video/CMakeLists.txt
@@ -11,6 +11,33 @@ target_include_directories(xbox_video PUBLIC
     ${CMAKE_CURRENT_SOURCE_DIR}/..
 )
 target_link_libraries(xbox_video PUBLIC xbox_d3d8)
+# The kernel and the video code call into each other: the pushbuffer executor
+# and the kernel bridge drive the renderer, the window and the movie pump, and
+# the renderer reads guest memory through the kernel. Saying so both ways
+# makes CMake repeat the pair on the link line, which a single-pass linker
+# (GNU ld) needs; MSVC's linker never minded.
+target_link_libraries(xbox_video PUBLIC xbox_kernel)
+target_link_libraries(xbox_kernel PUBLIC xbox_video)
 if(WIN32)
     target_link_libraries(xbox_video PUBLIC mfplat mfreadwrite mfuuid mf ole32 dbghelp winmm)
+else()
+    # The D3D11 renderer on Linux: DXVK-native provides d3d11/dxgi on Vulkan,
+    # vkd3d-utils provides D3DCompile, and the window is SDL2's. Without them
+    # the renderer and the window build as stubs.
+    option(XBOXRECOMP_DXVK "Build the D3D11 renderer against DXVK-native" ON)
+    if(XBOXRECOMP_DXVK)
+        find_package(PkgConfig REQUIRED)
+        pkg_check_modules(DXVK IMPORTED_TARGET dxvk-d3d11 dxvk-dxgi)
+        pkg_check_modules(VKD3D_UTILS IMPORTED_TARGET libvkd3d-utils)
+        find_package(SDL2)
+        if(DXVK_FOUND AND VKD3D_UTILS_FOUND AND SDL2_FOUND)
+            target_compile_definitions(xbox_video PUBLIC XBOXRECOMP_DXVK)
+            target_link_libraries(xbox_video PUBLIC
+                PkgConfig::DXVK PkgConfig::VKD3D_UTILS SDL2::SDL2 platform)
+            message(STATUS "xbox_video: D3D11 renderer on DXVK-native ${DXVK_dxvk-d3d11_VERSION}")
+        else()
+            message(WARNING "xbox_video: DXVK-native, vkd3d-utils or SDL2 not found; "
+                            "the D3D11 renderer is a stub")
+        endif()
+    endif()
 endif()
diff --git a/src/video/d3d11_posix.h b/src/video/d3d11_posix.h
new file mode 100644
index 0000000..5299f50
--- /dev/null
+++ b/src/video/d3d11_posix.h
@@ -0,0 +1,290 @@
+/*
+ * d3d11_posix.h -- what nv2a_d3d11.c needs from Windows, on Linux.
+ *
+ * The renderer is written against D3D11. On Linux DXVK-native provides that
+ * API on Vulkan (its <windows.h> carries the COM and D3D types, and
+ * libdxvk_d3d11/libdxvk_dxgi the entry points), vkd3d-utils provides
+ * D3DCompile, and the window is the SDL window fb_present.c opens: with
+ * DXVK's SDL2 WSI an HWND *is* an SDL_Window*.
+ *
+ * What remains is the handful of Win32 calls the renderer makes besides D3D:
+ * a critical section, a condition variable and an SRW lock, interlocked
+ * operations, the performance counter, a worker thread, the frame-pacing
+ * timer and the client area. They are defined here over pthreads rather than
+ * taken from platform/win32_compat.h, whose Xbox WCHAR and handle types would
+ * collide with DXVK's.
+ */
+#ifndef XBOXRECOMP_D3D11_POSIX_H
+#define XBOXRECOMP_D3D11_POSIX_H
+
+#define COBJMACROS
+#define INITGUID
+#include <windows.h>
+#include <d3d11_1.h>
+#include <dxgi1_6.h>
+#include <d3dcompiler.h>
+
+
+#include <errno.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#if defined(__x86_64__)
+/* ---- D3DCompile on x86-64 --------------------------------------------
+ * vkd3d-utils keeps Windows' calling convention on x86-64 (its WINAPI and
+ * its COM methods are ms_abi, for Wine's sake), while DXVK-native uses the
+ * host's. The one call into vkd3d goes through an ms_abi declaration of the
+ * same symbol, and the blobs it returns, whose methods are ms_abi as well,
+ * are copied into blobs of the host's convention. Elsewhere (aarch64) there
+ * is one convention and D3DCompile is called directly. */
+typedef struct D3dPosixVkd3dBlob D3dPosixVkd3dBlob;
+struct D3dPosixVkd3dBlobVtbl {
+    HRESULT (__attribute__((ms_abi)) *QueryInterface)(D3dPosixVkd3dBlob *, REFIID, void **);
+    ULONG (__attribute__((ms_abi)) *AddRef)(D3dPosixVkd3dBlob *);
+    ULONG (__attribute__((ms_abi)) *Release)(D3dPosixVkd3dBlob *);
+    void *(__attribute__((ms_abi)) *GetBufferPointer)(D3dPosixVkd3dBlob *);
+    SIZE_T (__attribute__((ms_abi)) *GetBufferSize)(D3dPosixVkd3dBlob *);
+};
+struct D3dPosixVkd3dBlob { const struct D3dPosixVkd3dBlobVtbl *lpVtbl; };
+extern HRESULT __attribute__((ms_abi)) d3d_posix_vkd3d_compile(
+    const void *data, SIZE_T size, const char *name, const D3D_SHADER_MACRO *defines,
+    ID3DInclude *include, const char *entry, const char *target, UINT flags1,
+    UINT flags2, D3dPosixVkd3dBlob **code, D3dPosixVkd3dBlob **errors) __asm__("D3DCompile");
+
+typedef struct { ID3D10Blob iface; LONG ref; SIZE_T size; } D3dPosixBlob;
+static HRESULT STDMETHODCALLTYPE d3d_posix_blob_qi(ID3D10Blob *b, REFIID iid, void **out)
+{ (void)b; (void)iid; *out = NULL; return E_NOINTERFACE; }
+static ULONG STDMETHODCALLTYPE d3d_posix_blob_addref(ID3D10Blob *b)
+{ return (ULONG)__atomic_add_fetch(&((D3dPosixBlob *)b)->ref, 1, __ATOMIC_SEQ_CST); }
+static ULONG STDMETHODCALLTYPE d3d_posix_blob_release(ID3D10Blob *b)
+{
+    LONG n = __atomic_sub_fetch(&((D3dPosixBlob *)b)->ref, 1, __ATOMIC_SEQ_CST);
+    if (!n) free(b);
+    return (ULONG)n;
+}
+static void *STDMETHODCALLTYPE d3d_posix_blob_ptr(ID3D10Blob *b)
+{ return (D3dPosixBlob *)b + 1; }
+static SIZE_T STDMETHODCALLTYPE d3d_posix_blob_size(ID3D10Blob *b)
+{ return ((D3dPosixBlob *)b)->size; }
+static ID3D10BlobVtbl d3d_posix_blob_vtbl = {
+    d3d_posix_blob_qi, d3d_posix_blob_addref, d3d_posix_blob_release,
+    d3d_posix_blob_ptr, d3d_posix_blob_size };
+
+static ID3D10Blob *d3d_posix_blob_from_vkd3d(D3dPosixVkd3dBlob *v)
+{
+    D3dPosixBlob *b;
+    SIZE_T n;
+    if (!v) return NULL;
+    n = v->lpVtbl->GetBufferSize(v);
+    if ((b = (D3dPosixBlob *)malloc(sizeof *b + n)) != NULL) {
+        b->iface.lpVtbl = &d3d_posix_blob_vtbl;
+        b->ref = 1;
+        b->size = n;
+        memcpy(b + 1, v->lpVtbl->GetBufferPointer(v), n);
+    }
+    v->lpVtbl->Release(v);
+    return b ? &b->iface : NULL;
+}
+
+static inline HRESULT d3d_posix_compile(const void *data, SIZE_T size, const char *name,
+                                        const D3D_SHADER_MACRO *defines, ID3DInclude *include,
+                                        const char *entry, const char *target, UINT flags1,
+                                        UINT flags2, ID3DBlob **code, ID3DBlob **errors)
+{
+    D3dPosixVkd3dBlob *c = NULL, *e = NULL;
+    HRESULT hr = d3d_posix_vkd3d_compile(data, size, name, defines, include, entry,
+                                         target, flags1, flags2, &c, &e);
+    if (code) *code = d3d_posix_blob_from_vkd3d(c);
+    else if (c) c->lpVtbl->Release(c);
+    if (errors) *errors = d3d_posix_blob_from_vkd3d(e);
+    else if (e) e->lpVtbl->Release(e);
+    if (SUCCEEDED(hr) && code && !*code) hr = E_OUTOFMEMORY;
+    return hr;
+}
+#define D3DCompile d3d_posix_compile
+#endif
+
+#ifndef INFINITE
+#define INFINITE 0xFFFFFFFFu
+#endif
+#ifndef INVALID_FILE_ATTRIBUTES
+#define INVALID_FILE_ATTRIBUTES ((DWORD)-1)
+#endif
+#ifndef __cdecl
+#define __cdecl
+#endif
+
+#include "fb_present.h"   /* the window: handle, drawable and display size */
+
+/* ---- interlocked ---------------------------------------------------- */
+static inline LONG InterlockedExchange(volatile LONG *p, LONG v)
+{ return __atomic_exchange_n(p, v, __ATOMIC_SEQ_CST); }
+static inline LONG InterlockedIncrement(volatile LONG *p)
+{ return __atomic_add_fetch(p, 1, __ATOMIC_SEQ_CST); }
+static inline LONG InterlockedDecrement(volatile LONG *p)
+{ return __atomic_sub_fetch(p, 1, __ATOMIC_SEQ_CST); }
+static inline LONG InterlockedCompareExchange(volatile LONG *p, LONG v, LONG cmp)
+{ __atomic_compare_exchange_n(p, &cmp, v, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); return cmp; }
+
+/* ---- time ------------------------------------------------------------ */
+static inline uint64_t d3d_posix_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+static inline BOOL QueryPerformanceFrequency(LARGE_INTEGER *f)
+{ f->QuadPart = 1000000000ll; return TRUE; }
+static inline BOOL QueryPerformanceCounter(LARGE_INTEGER *c)
+{ c->QuadPart = (LONGLONG)d3d_posix_ns(); return TRUE; }
+static inline DWORD GetTickCount(void)
+{ return (DWORD)(d3d_posix_ns() / 1000000ull); }
+static inline void Sleep(DWORD ms)
+{
+    struct timespec ts = { (time_t)(ms / 1000), (long)(ms % 1000) * 1000000l };
+    while (nanosleep(&ts, &ts) == -1 && errno == EINTR) {}
+}
+static inline void SwitchToThread(void) { sched_yield(); }
+#if defined(__aarch64__)
+#define YieldProcessor() __asm__ volatile("yield")
+#elif defined(__x86_64__) || defined(__i386__)
+#define YieldProcessor() __builtin_ia32_pause()
+#else
+#define YieldProcessor() ((void)0)
+#endif
+
+/* ---- locks ----------------------------------------------------------- */
+typedef pthread_mutex_t CRITICAL_SECTION;
+typedef pthread_cond_t CONDITION_VARIABLE;
+typedef pthread_rwlock_t SRWLOCK;
+#define SRWLOCK_INIT PTHREAD_RWLOCK_INITIALIZER
+static inline void InitializeCriticalSection(CRITICAL_SECTION *cs) { pthread_mutex_init(cs, NULL); }
+static inline void EnterCriticalSection(CRITICAL_SECTION *cs) { pthread_mutex_lock(cs); }
+static inline void LeaveCriticalSection(CRITICAL_SECTION *cs) { pthread_mutex_unlock(cs); }
+static inline void InitializeConditionVariable(CONDITION_VARIABLE *cv) { pthread_cond_init(cv, NULL); }
+static inline void WakeConditionVariable(CONDITION_VARIABLE *cv) { pthread_cond_signal(cv); }
+static inline BOOL SleepConditionVariableCS(CONDITION_VARIABLE *cv, CRITICAL_SECTION *cs, DWORD ms)
+{
+    if (ms == INFINITE)
+        return pthread_cond_wait(cv, cs) == 0;
+    {
+        struct timespec ts;
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_sec += ms / 1000;
+        ts.tv_nsec += (long)(ms % 1000) * 1000000l;
+        if (ts.tv_nsec >= 1000000000l) { ts.tv_sec++; ts.tv_nsec -= 1000000000l; }
+        return pthread_cond_timedwait(cv, cs, &ts) == 0;
+    }
+}
+static inline void AcquireSRWLockShared(SRWLOCK *l) { pthread_rwlock_rdlock(l); }
+static inline void ReleaseSRWLockShared(SRWLOCK *l) { pthread_rwlock_unlock(l); }
+static inline void AcquireSRWLockExclusive(SRWLOCK *l) { pthread_rwlock_wrlock(l); }
+static inline void ReleaseSRWLockExclusive(SRWLOCK *l) { pthread_rwlock_unlock(l); }
+
+/* ---- threads and the pacing timer ------------------------------------
+ * The renderer starts one detached worker and waits on one timer; a HANDLE
+ * here is either a finished pthread_create (never waited on) or a timer. */
+typedef DWORD (*LPTHREAD_START_ROUTINE)(LPVOID);
+#define THREAD_PRIORITY_BELOW_NORMAL (-1)
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x2u
+#define TIMER_ALL_ACCESS 0x1F0003u
+
+typedef struct { LPTHREAD_START_ROUTINE fn; LPVOID arg; } D3dPosixThreadStart;
+static void *d3d_posix_thread(void *p)
+{
+    D3dPosixThreadStart s = *(D3dPosixThreadStart *)p;
+    free(p);
+    s.fn(s.arg);
+    return NULL;
+}
+static inline HANDLE CreateThread(void *sa, SIZE_T stack, LPTHREAD_START_ROUTINE fn,
+                                  LPVOID arg, DWORD flags, DWORD *id)
+{
+    pthread_t t;
+    D3dPosixThreadStart *s = (D3dPosixThreadStart *)malloc(sizeof *s);
+    (void)sa; (void)stack; (void)flags; (void)id;
+    if (!s) return NULL;
+    s->fn = fn; s->arg = arg;
+    if (pthread_create(&t, NULL, d3d_posix_thread, s) != 0) { free(s); return NULL; }
+    pthread_detach(t);
+    return (HANDLE)(uintptr_t)1;
+}
+static inline BOOL SetThreadPriority(HANDLE h, int p) { (void)h; (void)p; return TRUE; }
+
+typedef struct { int64_t due_ns; } D3dPosixTimer;
+static inline HANDLE CreateWaitableTimerExW(void *sa, const void *name, DWORD flags, DWORD access)
+{
+    (void)sa; (void)name; (void)flags; (void)access;
+    return (HANDLE)calloc(1, sizeof(D3dPosixTimer));
+}
+static inline BOOL SetWaitableTimer(HANDLE h, const LARGE_INTEGER *due, LONG period,
+                                    void *fn, void *arg, BOOL resume)
+{
+    D3dPosixTimer *t = (D3dPosixTimer *)h;
+    (void)period; (void)fn; (void)arg; (void)resume;
+    if (!t || !due) return FALSE;
+    /* negative: relative, in 100 ns units */
+    t->due_ns = (int64_t)d3d_posix_ns() +
+                (due->QuadPart < 0 ? -due->QuadPart * 100 : 0);
+    return TRUE;
+}
+static inline DWORD WaitForSingleObject(HANDLE h, DWORD ms)
+{
+    D3dPosixTimer *t = (D3dPosixTimer *)h;
+    struct timespec ts;
+    (void)ms;
+    if (!t) return 0;
+    ts.tv_sec = (time_t)(t->due_ns / 1000000000ll);
+    ts.tv_nsec = (long)(t->due_ns % 1000000000ll);
+    while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL) == EINTR) {}
+    return 0;
+}
+static inline BOOL CloseHandle(HANDLE h) { (void)h; return TRUE; }
+
+/* ---- window and monitor ---------------------------------------------- */
+static inline BOOL GetClientRect(HWND h, RECT *rc)
+{
+    unsigned w, hh;
+    (void)h;
+    if (!xbox_FramebufferWindowClientSize(&w, &hh)) return FALSE;
+    rc->left = rc->top = 0;
+    rc->right = (LONG)w;
+    rc->bottom = (LONG)hh;
+    return TRUE;
+}
+#define MONITOR_DEFAULTTOPRIMARY 0x1u
+typedef struct { DWORD cbSize; RECT rcMonitor; RECT rcWork; DWORD dwFlags; } MONITORINFO;
+static inline HMONITOR MonitorFromWindow(HWND h, DWORD flags)
+{ (void)h; (void)flags; return (HMONITOR)(uintptr_t)1; }
+static inline BOOL GetMonitorInfoA(HMONITOR m, MONITORINFO *mi)
+{
+    unsigned w, h;
+    (void)m;
+    if (!xbox_FramebufferDisplaySize(&w, &h)) return FALSE;
+    mi->rcMonitor.left = mi->rcMonitor.top = 0;
+    mi->rcMonitor.right = (LONG)w;
+    mi->rcMonitor.bottom = (LONG)h;
+    mi->rcWork = mi->rcMonitor;
+    return TRUE;
+}
+#define DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 ((void *)(intptr_t)-4)
+static inline void *SetThreadDpiAwarenessContext(void *c) { return c; }
+
+/* ---- RenderDoc hook and its flag file -------------------------------- */
+static inline HMODULE GetModuleHandleA(const char *name) { (void)name; return NULL; }
+static inline void *GetProcAddress(HMODULE m, const char *name) { (void)m; (void)name; return NULL; }
+static inline DWORD GetFileAttributesA(const char *path)
+{
+    struct stat st;
+    return stat(path, &st) == 0 ? 0x80u : INVALID_FILE_ATTRIBUTES;
+}
+static inline BOOL DeleteFileA(const char *path) { return unlink(path) == 0; }
+
+#endif /* XBOXRECOMP_D3D11_POSIX_H */
