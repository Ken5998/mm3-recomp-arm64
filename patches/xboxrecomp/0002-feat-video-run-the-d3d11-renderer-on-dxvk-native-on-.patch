+int xbox_FramebufferDisplaySize(unsigned *w, unsigned *h)
+{
+    SDL_DisplayMode mode;
+    int display = s_hwnd ? SDL_GetWindowDisplayIndex((SDL_Window *)s_hwnd) : 0;
+    if (SDL_GetDesktopDisplayMode(display < 0 ? 0 : display, &mode) != 0 ||
+        mode.w <= 0 || mode.h <= 0)
+        return 0;
+    *w = (unsigned)mode.w;
+    *h = (unsigned)mode.h;
+    return 1;
