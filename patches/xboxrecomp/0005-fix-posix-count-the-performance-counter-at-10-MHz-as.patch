 <46025606+Ken5998@users.noreply.github.com>
Date: Mon, 9 Nov 2026 13:23:08 +0000
Subject: [PATCH 5/5] fix(posix): count the performance counter at 10 MHz, as
 Windows does

QueryPerformanceCounter counted nanoseconds on POSIX, 100 times the
10 MHz ticks Windows 10 and 11 give, so every count since boot was 100
times what the runtime and the title see there, and conversions written
for Windows, such as ticks * 10^6 / frequency, wrap that much sooner.
---
 src/platform/win32_compat.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/platform/win32_compat.c b/src/platform/win32_compat.c
index 26452e9..afcf68a 100644
--- a/src/platform/win32_compat.c
+++ b/src/platform/win32_compat.c
@@ -2272,17 +2272,21 @@ ULONGLONG GetTickCount64(void)
 
 DWORD GetTickCount(void) { return (DWORD)GetTickCount64(); }
 
+/* 10 MHz, as on Windows 10 and 11. Counting in nanoseconds made every tick
+ * count since boot 100 times what the runtime and the title see on Windows,
+ * and conversions written for that, such as ticks * 10^6 / frequency, wrap
+ * that much sooner. */
 BOOL QueryPerformanceCounter(PLARGE_INTEGER count)
 {
     struct timespec ts;
     clock_gettime(CLOCK_MONOTONIC, &ts);
-    count->QuadPart = (LONGLONG)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+    count->QuadPart = (LONGLONG)ts.tv_sec * 10000000LL + ts.tv_nsec / 100;
     return TRUE;
 }
 
 BOOL QueryPerformanceFrequency(PLARGE_INTEGER freq)
 {
-    freq->QuadPart = 1000000000LL;   /* QPC is in nanoseconds */
+    freq->QuadPart = 10000000LL;
     return TRUE;
 }
 
