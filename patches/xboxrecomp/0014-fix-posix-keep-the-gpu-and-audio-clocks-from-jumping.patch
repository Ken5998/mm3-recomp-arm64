From b144965fafae3e8bd52b2259c84e785f8f8f6b30 Mon Sep 17 00:00:00 2001
From: Ken5998 <46025606+Ken5998@users.noreply.github.com>
Date: Wed, 14 Oct 2026 19:21:27 +0000
Subject: [PATCH 14/19] fix(posix): keep the gpu and audio clocks from jumping
 back

QueryPerformanceCounter counted nanoseconds on Linux, 100 times the
10 MHz ticks Windows 10 and 11 give, so every count since boot was 100
times larger than the runtime and the title see there. The clocks the
GPU and audio models read, scaled as count * 10^9 / frequency, wrapped
past 2^63 and jumped back 18 seconds every 18 seconds: PTIMER, the
APU's XGSCNT and the audio frame pacing.

The counter now ticks at 10 MHz, and qemu_clock_get_ns and
qemu_clock_get_us scale whole seconds and the remainder apart, which on
Windows also ends the same jump every half hour. tests/clock_posix
checks the rate and that both clocks follow the host's.
---
 src/apu/apu_shim.h               |  5 ++-
 src/nv2a/qemu_shim.h             |  7 +++-
 src/platform/win32_compat.c      |  8 +++-
 src/video/d3d11_posix.h          |  5 ++-
 tests/clock_posix/CMakeLists.txt | 14 +++++++
 tests/clock_posix/test_main.c    | 67 ++++++++++++++++++++++++++++++++
 6 files changed, 100 insertions(+), 6 deletions(-)
 create mode 100644 tests/clock_posix/CMakeLists.txt
 create mode 100644 tests/clock_posix/test_main.c

diff --git a/src/apu/apu_shim.h b/src/apu/apu_shim.h
index e18baa5..c9f26e0 100644
--- a/src/apu/apu_shim.h
+++ b/src/apu/apu_shim.h
@@ -43,12 +43,15 @@
 #define QEMU_CLOCK_REALTIME 1
 
 #ifndef qemu_clock_get_us
+/* Scaled in two parts, as qemu_clock_get_ns: count * 10^6 overflows after
+ * ten days up at 10 MHz. */
 static inline int64_t qemu_clock_get_us(int type) {
     (void)type;
     LARGE_INTEGER freq, count;
     QueryPerformanceFrequency(&freq);
     QueryPerformanceCounter(&count);
-    return (int64_t)(count.QuadPart * 1000000LL / freq.QuadPart);
+    return (count.QuadPart / freq.QuadPart) * 1000000LL
+         + (count.QuadPart % freq.QuadPart) * 1000000LL / freq.QuadPart;
 }
 #endif
 
diff --git a/src/nv2a/qemu_shim.h b/src/nv2a/qemu_shim.h
index e70fe05..2a6c746 100644
--- a/src/nv2a/qemu_shim.h
+++ b/src/nv2a/qemu_shim.h
@@ -370,12 +370,17 @@ static inline void bql_unlock(void) {}
 #define qemu_mutex_unlock_iothread() bql_unlock()
 
 /* Timer */
+/* Whole seconds and the remainder are scaled apart: count * 10^9 overflows
+ * once the host has been up for 15 minutes at 10 MHz, and the clock then
+ * jumps back half an hour every half hour -- PTIMER and the APU's XGSCNT
+ * with it. */
 static inline int64_t qemu_clock_get_ns(int type) {
     (void)type;
     LARGE_INTEGER freq, count;
     QueryPerformanceFrequency(&freq);
     QueryPerformanceCounter(&count);
-    return (int64_t)(count.QuadPart * 1000000000LL / freq.QuadPart);
+    return (count.QuadPart / freq.QuadPart) * 1000000000LL
+         + (count.QuadPart % freq.QuadPart) * 1000000000LL / freq.QuadPart;
 }
 #define QEMU_CLOCK_VIRTUAL 0
 
diff --git a/src/platform/win32_compat.c b/src/platform/win32_compat.c
index 2708fa2..8eb6d56 100644
--- a/src/platform/win32_compat.c
+++ b/src/platform/win32_compat.c
@@ -1367,17 +1367,21 @@ ULONGLONG GetTickCount64(void)
 
 DWORD GetTickCount(void) { return (DWORD)GetTickCount64(); }
 
+/* 10 MHz, as on Windows 10 and 11. Counting in nanoseconds made every tick
+ * count since boot 100 times what the runtime and the title see on Windows,
+ * and conversions written for that, such as ticks * 10^9 / frequency, wrapped
+ * every 18 seconds instead of every half hour. */
 BOOL QueryPerformanceCounter(PLARGE_INTEGER count)
 {
     struct timespec ts;
     clock_gettime(CLOCK_MONOTONIC, &ts);
-    count->QuadPart = (LONGLONG)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+    count->QuadPart = (LONGLONG)ts.tv_sec * 10000000LL + ts.tv_nsec / 100;
     return TRUE;
 }
 
 BOOL QueryPerformanceFrequency(PLARGE_INTEGER freq)
 {
-    freq->QuadPart = 1000000000LL;   /* QPC is in nanoseconds */
+    freq->QuadPart = 10000000LL;
     return TRUE;
 }
 
diff --git a/src/video/d3d11_posix.h b/src/video/d3d11_posix.h
index 5299f50..b97101d 100644
--- a/src/video/d3d11_posix.h
+++ b/src/video/d3d11_posix.h
@@ -140,10 +140,11 @@ static inline uint64_t d3d_posix_ns(void)
     clock_gettime(CLOCK_MONOTONIC, &ts);
     return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
 }
+/* 10 MHz, as on Windows and in platform/win32_compat.c. */
 static inline BOOL QueryPerformanceFrequency(LARGE_INTEGER *f)
-{ f->QuadPart = 1000000000ll; return TRUE; }
+{ f->QuadPart = 10000000ll; return TRUE; }
 static inline BOOL QueryPerformanceCounter(LARGE_INTEGER *c)
-{ c->QuadPart = (LONGLONG)d3d_posix_ns(); return TRUE; }
+{ c->QuadPart = (LONGLONG)(d3d_posix_ns() / 100u); return TRUE; }
 static inline DWORD GetTickCount(void)
 { return (DWORD)(d3d_posix_ns() / 1000000ull); }
 static inline void Sleep(DWORD ms)
diff --git a/tests/clock_posix/CMakeLists.txt b/tests/clock_posix/CMakeLists.txt
new file mode 100644
index 0000000..7904a7b
--- /dev/null
+++ b/tests/clock_posix/CMakeLists.txt
@@ -0,0 +1,14 @@
+cmake_minimum_required(VERSION 3.20)
+project(clock_posix_test C)
+# The performance counter and the clocks the GPU and audio models derive from
+# it, on a POSIX host.
+if(WIN32)
+    message(FATAL_ERROR "This regression covers the POSIX clock")
+endif()
+set(CMAKE_C_STANDARD 11)
+add_subdirectory(../../src/platform platform)
+add_executable(clock_posix_test test_main.c)
+target_include_directories(clock_posix_test PRIVATE ../../src ../../src/apu)
+target_link_libraries(clock_posix_test PRIVATE platform)
+enable_testing()
+add_test(NAME clock_posix_test COMMAND clock_posix_test)
diff --git a/tests/clock_posix/test_main.c b/tests/clock_posix/test_main.c
new file mode 100644
index 0000000..18fd0f7
--- /dev/null
+++ b/tests/clock_posix/test_main.c
@@ -0,0 +1,67 @@
+/*
+ * QueryPerformanceCounter on a POSIX host, and the clocks built on it.
+ *
+ * It ticks at 10 MHz, as on Windows, so the runtime and the title see counts
+ * of the size they see there. And the nanosecond and microsecond clocks the
+ * GPU and audio models read (PTIMER, the APU's XGSCNT, the audio frame pacing)
+ * follow the host's monotonic clock however long the host has been up: scaled
+ * as count * 10^9 they wrapped and jumped back once the product passed 2^63,
+ * which at nanosecond ticks was every 18 seconds.
+ */
+#include "apu_shim.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+static int failures;
+
+static void check(int ok, const char *what)
+{
+    printf("  %-58s %s\n", what, ok ? "PASS" : "FAIL");
+    if (!ok) failures++;
+}
+
+static int64_t monotonic_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+static int64_t distance(int64_t a, int64_t b) { return a > b ? a - b : b - a; }
+
+int main(void)
+{
+    LARGE_INTEGER freq, before, after;
+    struct timespec pause = { 0, 50 * 1000000L };
+    int64_t host, ns, us, worst_ns = 0, worst_us = 0;
+
+    QueryPerformanceFrequency(&freq);
+    check(freq.QuadPart == 10000000LL, "the counter ticks at 10 MHz");
+
+    host = monotonic_ns();
+    QueryPerformanceCounter(&before);
+    check(distance(before.QuadPart, host / 100) < 10000,
+          "it counts the host's monotonic time in 100 ns steps");
+    nanosleep(&pause, NULL);
+    QueryPerformanceCounter(&after);
+    check(after.QuadPart - before.QuadPart >= 500000 &&
+          after.QuadPart - before.QuadPart < 2000000,
+          "50 ms come out as about 500000 ticks");
+
+    /* Long enough to cross where the old scaling wrapped, wherever the
+     * host's uptime puts that. */
+    for (int i = 0; i < 2000; i++) {
+        host = monotonic_ns();
+        ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        us = qemu_clock_get_us(QEMU_CLOCK_REALTIME);
+        if (distance(ns, host) > worst_ns) worst_ns = distance(ns, host);
+        if (distance(us, host / 1000) > worst_us) worst_us = distance(us, host / 1000);
+    }
+    check(worst_ns < 1000000, "qemu_clock_get_ns is the host's time in ns");
+    check(worst_us < 1000, "qemu_clock_get_us is the host's time in us");
+
+    printf("\n%d failure(s)\n", failures);
+    return failures ? 1 : 0;
+}
